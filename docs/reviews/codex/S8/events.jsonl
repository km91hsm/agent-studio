{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n '\"'^'\"' spikes/s8-idempotency/worker.ts\"","aggregated_output":"1:/**\n2: * S8 크래시 재현 worker — 테스트가 자식 프로세스로 띄운다.\n3: *   node --import tsx worker.ts <scenario> <repoDir> <ledgerFile> <file>\n4: * 모든 시나리오는 EffectLedger.commit() 호출 **전에** SIGKILL 로 자신을 죽인다(정상 종료 경로 없음).\n5: *   patch-then-crash    : intend → 파일에 패치 적용 → 크래시           (재기동 기대: done)\n6: *   crash-before-apply  : intend → 크래시                              (재기동 기대: reapply_with_approval / 그 사이 변경 시 conflict)\n7: *   commit-then-crash   : intend(git_commit) → git commit → SHA 를 outbox 에 기록 → 크래시 (재기동 기대: done, 재커밋 없음)\n8: *   crash-before-commit : intend(git_commit) → 변경 스테이징 → 크래시   (재기동 기대: reapply_with_approval / HEAD 이동 시 conflict)\n9: */\n10:import { execFileSync } from \"node:child_process\";\n11:import { readFileSync, writeFileSync } from \"node:fs\";\n12:import { join } from \"node:path\";\n13:import { EffectLedger, blobOf } from \"./effects.js\";\n14:\n15:const [scenario, repoDir, ledgerFile, file] = process.argv.slice(2);\n16:if (!scenario || !repoDir || !ledgerFile || !file) {\n17:  console.error(\"usage: worker.ts <scenario> <repoDir> <ledgerFile> <file>\");\n18:  process.exit(2);\n19:}\n20:const TARGET_CONTENT = \"export function add(a, b) {\\n  return a + b; // patched by s8\\n}\\n\";\n21:const git = (...args: string[]) => execFileSync(\"git\", args, { cwd: repoDir, encoding: \"utf8\", stdio: [\"ignore\", \"pipe\", \"pipe\"] }).trim();\n22:\n23:function crash(): never {\n24:  console.log(`[worker] ${scenario}: crashing before ledger.commit()`);\n25:  process.kill(process.pid, \"SIGKILL\");\n26:  // SIGKILL 전달이 비동기일 수 있으므로 정상 종료 경로로 빠지지 않게 붙잡는다\n27:  setTimeout(() => process.exit(99), 10_000);\n28:  throw new Error(\"unreachable: SIGKILL pending\");\n29:}\n30:\n31:const ledger = new EffectLedger(ledgerFile);\n32:const base = blobOf(readFileSync(join(repoDir, file)));\n33:const target = blobOf(Buffer.from(TARGET_CONTENT));\n34:const filePatch = { kind: \"file_patch\" as const, path: file, baseBlob: base, targetBlob: target, patchHash: blobOf(Buffer.from(`${base}->${target}`)), fileMode: \"100644\" };\n35:\n36:switch (scenario) {\n37:  case \"patch-then-crash\": {\n38:    ledger.intend(\"fp-crash\", filePatch);\n39:    writeFileSync(join(repoDir, file), TARGET_CONTENT);\n40:    crash();\n41:  }\n42:  case \"crash-before-apply\": {\n43:    ledger.intend(\"fp-crash\", filePatch);\n44:    crash();\n45:  }\n46:  case \"commit-then-crash\": {\n47:    ledger.intend(\"gc-crash\", { kind: \"git_commit\", parentSha: git(\"rev-parse\", \"HEAD\"), message: \"s8: outbox commit\" });\n48:    writeFileSync(join(repoDir, \"CHANGELOG.md\"), \"- s8 outbox commit\\n\");\n49:    git(\"add\", \"-A\");\n50:    git(\"commit\", \"-q\", \"-m\", \"s8: outbox commit\");\n51:    ledger.recordResult(\"gc-crash\", { sha: git(\"rev-parse\", \"HEAD\") });\n52:    crash();\n53:  }\n54:  case \"crash-before-commit\": {\n55:    ledger.intend(\"gc-crash\", { kind: \"git_commit\", parentSha: git(\"rev-parse\", \"HEAD\"), message: \"s8: outbox commit\" });\n56:    writeFileSync(join(repoDir, \"CHANGELOG.md\"), \"- s8 outbox commit\\n\");\n57:    git(\"add\", \"-A\");\n58:    crash();\n59:  }\n60:  default:\n61:    console.error(`unknown scenario: ${scenario}`);\n62:    process.exit(2);\n63:}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n '\"'^'\"' spikes/s8-idempotency/effects.ts\"","aggregated_output":"1:/**\n2: * S8 — EffectLedger: 효과 원장(outbox) 최소 구현 (DATABASE_SCHEMA §3 `effects`, D16, RC-S13).\n3: *   intend(key, spec)  : 효과를 실행하기 **전에** 원장에 기록(idempotency_key PK, 같은 키 재기록 거부)\n4: *   recordResult(key)  : 실행 중간 산출(예: 생성된 git SHA)을 commit 전에 기록 — outbox\n5: *   commit(key)        : 효과 완료 표시\n6: *   assess*(key, …)    : 재기동 시 현재 상태와 대조해 done / reapply_with_approval / conflict / unverifiable 판정\n7: * 원장은 JSON 파일 하나. 모든 쓰기는 임시 파일 + rename 으로 원자적이다(크래시 시 반쪽 파일 없음).\n8: * 이 모듈은 효과를 **직접 적용하지 않는다** — 재적용은 항상 호출자가 승인 뒤에 한다(자동 재적용·자동 재시도 금지).\n9: */\n10:import { createHash } from \"node:crypto\";\n11:import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from \"node:fs\";\n12:import { dirname } from \"node:path\";\n13:\n14:export type EffectState = \"intended\" | \"committed\" | \"failed\" | \"unverifiable\";\n15:export type Decision = \"done\" | \"reapply_with_approval\" | \"conflict\" | \"unverifiable\";\n16:\n17:export interface FilePatchSpec {\n18:  kind: \"file_patch\";\n19:  path: string;\n20:  baseBlob: string;\n21:  targetBlob: string;\n22:  patchHash: string;\n23:  fileMode: string;\n24:}\n25:export interface GitCommitSpec {\n26:  kind: \"git_commit\";\n27:  parentSha: string;\n28:  treeSha?: string;\n29:  message: string;\n30:}\n31:export interface ExternalSpec {\n32:  kind: \"net\" | \"mcp\" | \"external_service\";\n33:  target: string;\n34:  /** 외부 서비스가 돌려준 멱등 참조. 없으면 재기동 시 unverifiable */\n35:  externalRef: string | null;\n36:}\n37:export type EffectSpec = FilePatchSpec | GitCommitSpec | ExternalSpec;\n38:\n39:export interface Assessment {\n40:  at: string;\n41:  decision: Decision;\n42:  observed?: string;\n43:}\n44:\n45:export interface EffectEntry {\n46:  key: string;\n47:  spec: EffectSpec;\n48:  state: EffectState;\n49:  intendedAt: string;\n50:  committedAt: string | null;\n51:  /** outbox: commit 전에 남긴 중간 산출(예: `{ sha }`) */\n52:  result: Record<string, unknown> | null;\n53:  assessments: Assessment[];\n54:}\n55:\n56:interface LedgerFile {\n57:  version: 1;\n58:  effects: Record<string, EffectEntry>;\n59:}\n60:\n61:/** git 과 같은 blob sha1 (`blob <len>\\0<data>`) */\n62:export function blobOf(data: Buffer): string {\n63:  return createHash(\"sha1\").update(`blob ${data.length}\\0`).update(data).digest(\"hex\");\n64:}\n65:\n66:export class EffectLedger {\n67:  private data: LedgerFile;\n68:\n69:  constructor(private readonly file: string) {\n70:    this.data = existsSync(file) ? (JSON.parse(readFileSync(file, \"utf8\")) as LedgerFile) : { version: 1, effects: {} };\n71:  }\n72:\n73:  static load(file: string): EffectLedger {\n74:    return new EffectLedger(file);\n75:  }\n76:\n77:  get(key: string): EffectEntry | undefined {\n78:    return this.data.effects[key];\n79:  }\n80:\n81:  intend(key: string, spec: EffectSpec): EffectEntry {\n82:    if (this.data.effects[key]) throw new Error(`duplicate idempotency key: ${key}`);\n83:    const entry: EffectEntry = { key, spec, state: \"intended\", intendedAt: new Date().toISOString(), committedAt: null, result: null, assessments: [] };\n84:    this.data.effects[key] = entry;\n85:    this.persist();\n86:    return entry;\n87:  }\n88:\n89:  recordResult(key: string, result: Record<string, unknown>): void {\n90:    const e = this.must(key);\n91:    e.result = { ...(e.result ?? {}), ...result };\n92:    this.persist();\n93:  }\n94:\n95:  commit(key: string): void {\n96:    const e = this.must(key);\n97:    e.state = \"committed\";\n98:    e.committedAt = new Date().toISOString();\n99:    this.persist();\n100:  }\n101:\n102:  fail(key: string, reason: string): void {\n103:    const e = this.must(key);\n104:    e.state = \"failed\";\n105:    e.result = { ...(e.result ?? {}), reason };\n106:    this.persist();\n107:  }\n108:\n109:  /** file_patch: 현재 blob 과 대조 — target 이면 이미 적용됨(done, 원장도 committed 로), base 면 미적용(승인 후 재적용), 그 외는 제3의 변경(conflict) */\n110:  assess(key: string, currentBlob: string): Decision {\n111:    const e = this.must(key);\n112:    if (e.spec.kind !== \"file_patch\") throw new Error(`assess: ${key} is ${e.spec.kind}, use assessGitCommit/assessExternal`);\n113:    let decision: Decision;\n114:    if (e.state === \"committed\" || currentBlob === e.spec.targetBlob) decision = \"done\";\n115:    else if (currentBlob === e.spec.baseBlob) decision = \"reapply_with_approval\";\n116:    else decision = \"conflict\";\n117:    return this.conclude(e, decision, currentBlob);\n118:  }\n119:\n120:  /** git_commit: outbox 에 SHA 가 있고 저장소에 존재하면 done(재커밋 금지); SHA 없고 parent 가 아직 HEAD 면 승인 후 재시도; HEAD 가 움직였으면 conflict */\n121:  assessGitCommit(key: string, repo: { headSha: string; shaExists: (sha: string) => boolean }): Decision {\n122:    const e = this.must(key);\n123:    if (e.spec.kind !== \"git_commit\") throw new Error(`assessGitCommit: ${key} is ${e.spec.kind}`);\n124:    const sha = typeof e.result?.sha === \"string\" ? e.result.sha : null;\n125:    let decision: Decision;\n126:    if (e.state === \"committed\" || (sha && repo.shaExists(sha))) decision = \"done\";\n127:    else if (repo.headSha === e.spec.parentSha) decision = \"reapply_with_approval\";\n128:    else decision = \"conflict\";\n129:    return this.conclude(e, decision, `head=${repo.headSha} sha=${sha ?? \"-\"}`);\n130:  }\n131:\n132:  /** net/mcp/external_service: 외부 참조가 없으면 검증 불가 → unverifiable (자동 건너뛰기·재시도 금지, 사람이 판단) */\n133:  assessExternal(key: string, verify?: (externalRef: string) => boolean): Decision {\n134:    const e = this.must(key);\n135:    if (e.spec.kind === \"file_patch\" || e.spec.kind === \"git_commit\") throw new Error(`assessExternal: ${key} is ${e.spec.kind}`);\n136:    if (e.state === \"committed\") return this.conclude(e, \"done\", \"committed\");\n137:    const ref = e.spec.externalRef;\n138:    if (!ref || !verify) {\n139:      e.state = \"unverifiable\";\n140:      return this.conclude(e, \"unverifiable\", ref ? \"no verifier\" : \"no external_ref\");\n141:    }\n142:    return this.conclude(e, verify(ref) ? \"done\" : \"reapply_with_approval\", `ref=${ref}`);\n143:  }\n144:\n145:  private conclude(e: EffectEntry, decision: Decision, observed: string): Decision {\n146:    e.assessments.push({ at: new Date().toISOString(), decision, observed });\n147:    if (decision === \"done\" && e.state !== \"committed\") {\n148:      e.state = \"committed\";\n149:      e.committedAt = new Date().toISOString();\n150:    }\n151:    this.persist();\n152:    return decision;\n153:  }\n154:\n155:  private must(key: string): EffectEntry {\n156:    const e = this.data.effects[key];\n157:    if (!e) throw new Error(`unknown idempotency key: ${key}`);\n158:    return e;\n159:  }\n160:\n161:  /** tmp + rename 원자 쓰기 */\n162:  private persist(): void {\n163:    mkdirSync(dirname(this.file), { recursive: true });\n164:    const tmp = `${this.file}.tmp`;\n165:    writeFileSync(tmp, JSON.stringify(this.data, null, 2) + \"\\n\");\n166:    renameSync(tmp, this.file);\n167:  }\n168:}\n","exit_code":0,"status":"completed"}}
