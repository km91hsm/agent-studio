{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n '\"'^'\"' spikes/s8-idempotency/s8.test.ts\"","aggregated_output":"1:/**\n2: * S8 — 중복 적용 방지 스파이크 (MASTER Task S8, AC-P00-8, DATABASE_SCHEMA §3 Idempotency Key, D16, RC-S13)\n3: * 순수 로직 + 자식 프로세스 크래시 재현(에이전트 호출 없음) → CI에서 실행된다.\n4: *   file_patch: (경로, base blob, target blob, patch 해시) 3분기 — 현재 blob=target → done / =base → reapply_with_approval / 그 외 → conflict\n5: *   git_commit: outbox에 생성 SHA가 있고 저장소에 존재하면 재커밋 금지(done); SHA 없고 parent=HEAD면 reapply_with_approval; HEAD 이동이면 conflict\n6: *   net/mcp/external_service: external_ref 없으면 unverifiable — 자동 건너뛰기·자동 재시도 금지\n7: */\n8:import { afterEach, describe, expect, it } from \"vitest\";\n9:import { execFileSync, spawnSync } from \"node:child_process\";\n10:import { existsSync, mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from \"node:fs\";\n11:import { tmpdir } from \"node:os\";\n12:import { join } from \"node:path\";\n13:import { fileURLToPath } from \"node:url\";\n14:import { createSampleRepo, type SampleRepo } from \"../_shared/sampleRepo.js\";\n15:import { EffectLedger, blobOf, type Decision } from \"./effects.js\";\n16:\n17:const WORKER = fileURLToPath(new URL(\"./worker.ts\", import.meta.url));\n18:const REPO_ROOT = fileURLToPath(new URL(\"../../\", import.meta.url));\n19:const FILE = \"index.js\";\n20:const TARGET_CONTENT = \"export function add(a, b) {\\n  return a + b; // patched by s8\\n}\\n\";\n21:\n22:let repo: SampleRepo | null = null;\n23:let scratch: string | null = null;\n24:afterEach(() => {\n25:  repo?.cleanup();\n26:  repo = null;\n27:  if (scratch) rmSync(scratch, { recursive: true, force: true });\n28:  scratch = null;\n29:});\n30:\n31:function setup() {\n32:  repo = createSampleRepo(\"s8-\");\n33:  scratch = mkdtempSync(join(tmpdir(), \"s8-ledger-\"));\n34:  const ledgerFile = join(scratch, \"effects.json\");\n35:  const base = repo.blob(FILE);\n36:  const target = blobOf(Buffer.from(TARGET_CONTENT));\n37:  return { repo, ledgerFile, base, target, patchHash: blobOf(Buffer.from(`${base}->${target}`)) };\n38:}\n39:\n40:const git = (dir: string, ...args: string[]) => execFileSync(\"git\", args, { cwd: dir, encoding: \"utf8\", stdio: [\"ignore\", \"pipe\", \"pipe\"] }).trim();\n41:\n42:/** 자식 프로세스에서 시나리오를 수행하고 commit() 전에 SIGKILL — 비정상 종료 코드를 반환해야 한다 */\n43:function runWorkerAndCrash(scenario: string, repoDir: string, ledgerFile: string): { status: number | null; signal: string | null; stdout: string } {\n44:  const r = spawnSync(process.execPath, [\"--import\", \"tsx\", WORKER, scenario, repoDir, ledgerFile, FILE], { cwd: REPO_ROOT, encoding: \"utf8\", timeout: 60_000 });\n45:  return { status: r.status, signal: r.signal, stdout: r.stdout };\n46:}\n47:\n48:describe(\"S8 EffectLedger — 원장 영속·동일 키 거부 (CI)\", () => {\n49:  it(\"intend 는 파일에 즉시 영속되고 다른 인스턴스가 intended 로 읽는다; 같은 키의 intend 는 거부된다\", () => {\n50:    const { ledgerFile, base, target, patchHash } = setup();\n51:    const a = new EffectLedger(ledgerFile);\n52:    a.intend(\"fp-1\", { kind: \"file_patch\", path: FILE, baseBlob: base, targetBlob: target, patchHash, fileMode: \"100644\" });\n53:    const b = EffectLedger.load(ledgerFile);\n54:    expect(b.get(\"fp-1\")?.state).toBe(\"intended\");\n55:    expect(() => b.intend(\"fp-1\", { kind: \"file_patch\", path: FILE, baseBlob: base, targetBlob: target, patchHash, fileMode: \"100644\" })).toThrow(/duplicate idempotency key/);\n56:    b.commit(\"fp-1\");\n57:    expect(EffectLedger.load(ledgerFile).get(\"fp-1\")?.state).toBe(\"committed\");\n58:  });\n59:\n60:  it(\"file_patch assess 3분기: blob=target → done(원장은 committed 로), =base → reapply_with_approval, 그 외 → conflict (순수)\", () => {\n61:    const { ledgerFile, base, target, patchHash } = setup();\n62:    const mk = (key: string) => {\n63:      const l = new EffectLedger(ledgerFile);\n64:      l.intend(key, { kind: \"file_patch\", path: FILE, baseBlob: base, targetBlob: target, patchHash, fileMode: \"100644\" });\n65:      return l;\n66:    };\n67:    const l = mk(\"k-done\");\n68:    expect(l.assess(\"k-done\", target)).toBe<Decision>(\"done\");\n69:    expect(l.get(\"k-done\")?.state).toBe(\"committed\");\n70:    mk(\"k-base\");\n71:    expect(EffectLedger.load(ledgerFile).assess(\"k-base\", base)).toBe<Decision>(\"reapply_with_approval\");\n72:    expect(EffectLedger.load(ledgerFile).get(\"k-base\")?.state).toBe(\"intended\");\n73:    mk(\"k-other\");\n74:    expect(EffectLedger.load(ledgerFile).assess(\"k-other\", blobOf(Buffer.from(\"someone else edited\\n\")))).toBe<Decision>(\"conflict\");\n75:  });\n76:\n77:  it(\"external 효과(net/mcp/external_service)는 external_ref 가 없으면 unverifiable — 자동 처리 금지\", () => {\n78:    const { ledgerFile } = setup();\n79:    const l = new EffectLedger(ledgerFile);\n80:    l.intend(\"net-1\", { kind: \"net\", target: \"https://example.invalid/api\", externalRef: null });\n81:    expect(l.assessExternal(\"net-1\")).toBe<Decision>(\"unverifiable\");\n82:    expect(l.get(\"net-1\")?.state).toBe(\"unverifiable\");\n83:    l.intend(\"net-2\", { kind: \"external_service\", target: \"provider\", externalRef: \"idem-abc\" });\n84:    expect(l.assessExternal(\"net-2\", (ref) => ref === \"idem-abc\")).toBe<Decision>(\"done\");\n85:  });\n86:});\n87:\n88:describe(\"S8 크래시 재현 — 자식 프로세스가 commit() 전에 죽는다 (CI, git 필요)\", () => {\n89:  it(\"(A) 패치 적용 후 크래시 → 재기동 assess = done, 파일은 재적용되지 않는다(내용·mtime 불변, 중복 적용 0)\", () => {\n90:    const { repo, ledgerFile, target } = setup();\n91:    const r = runWorkerAndCrash(\"patch-then-crash\", repo.dir, ledgerFile);\n92:    expect(r.status, r.stdout).not.toBe(0);\n93:    expect(readFileSync(join(repo.dir, FILE), \"utf8\")).toBe(TARGET_CONTENT);\n94:    const before = statSync(join(repo.dir, FILE)).mtimeMs;\n95:    const ledger = EffectLedger.load(ledgerFile);\n96:    expect(ledger.get(\"fp-crash\")?.state).toBe(\"intended\");\n97:    expect(ledger.assess(\"fp-crash\", repo.blob(FILE))).toBe<Decision>(\"done\");\n98:    expect(repo.blob(FILE)).toBe(target);\n99:    expect(statSync(join(repo.dir, FILE)).mtimeMs).toBe(before);\n100:    expect(EffectLedger.load(ledgerFile).get(\"fp-crash\")?.state).toBe(\"committed\");\n101:  });\n102:\n103:  it(\"(B) 적용 전 크래시 → assess = reapply_with_approval (자동 재적용 없음, 파일은 base 그대로)\", () => {\n104:    const { repo, ledgerFile, base } = setup();\n105:    const r = runWorkerAndCrash(\"crash-before-apply\", repo.dir, ledgerFile);\n106:    expect(r.status, r.stdout).not.toBe(0);\n107:    expect(repo.blob(FILE)).toBe(base);\n108:    expect(EffectLedger.load(ledgerFile).assess(\"fp-crash\", repo.blob(FILE))).toBe<Decision>(\"reapply_with_approval\");\n109:    expect(repo.blob(FILE)).toBe(base);\n110:  });\n111:\n112:  it(\"(C) 적용 전 크래시 + 그 사이 다른 변경 → assess = conflict (보류)\", () => {\n113:    const { repo, ledgerFile } = setup();\n114:    runWorkerAndCrash(\"crash-before-apply\", repo.dir, ledgerFile);\n115:    writeFileSync(join(repo.dir, FILE), \"export const add = (a, b) => a - b; // concurrent edit\\n\");\n116:    expect(EffectLedger.load(ledgerFile).assess(\"fp-crash\", repo.blob(FILE))).toBe<Decision>(\"conflict\");\n117:  });\n118:\n119:  it(\"(D) git_commit outbox: 커밋 생성·SHA 기록 후 크래시 → 재기동 시 SHA 존재 → done, 재커밋하지 않는다(커밋 수 불변)\", () => {\n120:    const { repo, ledgerFile } = setup();\n121:    const r = runWorkerAndCrash(\"commit-then-crash\", repo.dir, ledgerFile);\n122:    expect(r.status, r.stdout).not.toBe(0);\n123:    const count = git(repo.dir, \"rev-list\", \"--count\", \"HEAD\");\n124:    expect(count).toBe(\"2\");\n125:    const ledger = EffectLedger.load(ledgerFile);\n126:    const entry = ledger.get(\"gc-crash\");\n127:    expect(entry?.state).toBe(\"intended\");\n128:    const sha = (entry?.result as { sha?: string } | undefined)?.sha;\n129:    expect(sha).toMatch(/^[0-9a-f]{40}$/);\n130:    expect(ledger.assessGitCommit(\"gc-crash\", { headSha: git(repo.dir, \"rev-parse\", \"HEAD\"), shaExists: (s) => git(repo.dir, \"cat-file\", \"-t\", s) === \"commit\" })).toBe<Decision>(\"done\");\n131:    expect(git(repo.dir, \"rev-list\", \"--count\", \"HEAD\")).toBe(\"2\");\n132:    expect(git(repo.dir, \"rev-parse\", \"HEAD\")).toBe(sha);\n133:  });\n134:\n135:  it(\"(E) git_commit outbox: 커밋 전 크래시(SHA 없음) → parent=HEAD 면 reapply_with_approval, HEAD 가 움직였으면 conflict\", () => {\n136:    const { repo, ledgerFile } = setup();\n137:    runWorkerAndCrash(\"crash-before-commit\", repo.dir, ledgerFile);\n138:    expect(git(repo.dir, \"rev-list\", \"--count\", \"HEAD\")).toBe(\"1\");\n139:    const head = git(repo.dir, \"rev-parse\", \"HEAD\");\n140:    const exists = (s: string) => { try { return git(repo.dir, \"cat-file\", \"-t\", s) === \"commit\"; } catch { return false; } };\n141:    expect(EffectLedger.load(ledgerFile).assessGitCommit(\"gc-crash\", { headSha: head, shaExists: exists })).toBe<Decision>(\"reapply_with_approval\");\n142:    writeFileSync(join(repo.dir, \"README.md\"), \"moved\\n\");\n143:    git(repo.dir, \"add\", \"-A\");\n144:    git(repo.dir, \"commit\", \"-q\", \"-m\", \"someone else\");\n145:    expect(EffectLedger.load(ledgerFile).assessGitCommit(\"gc-crash\", { headSha: git(repo.dir, \"rev-parse\", \"HEAD\"), shaExists: exists })).toBe<Decision>(\"conflict\");\n146:  });\n147:\n148:  it(\"원장 파일은 원자적으로 쓰인다(임시 파일 잔재 없음)\", () => {\n149:    const { ledgerFile, base, target, patchHash } = setup();\n150:    new EffectLedger(ledgerFile).intend(\"x\", { kind: \"file_patch\", path: FILE, baseBlob: base, targetBlob: target, patchHash, fileMode: \"100644\" });\n151:    expect(existsSync(ledgerFile)).toBe(true);\n152:    expect(existsSync(`${ledgerFile}.tmp`)).toBe(false);\n153:  });\n154:});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n '\"'^'\"' spikes/_shared/sampleRepo.ts\"","aggregated_output":"1:import { cpSync, mkdtempSync, readFileSync, rmSync, existsSync } from \"node:fs\";\n2:import { tmpdir } from \"node:os\";\n3:import { join } from \"node:path\";\n4:import { execFileSync } from \"node:child_process\";\n5:import { createHash } from \"node:crypto\";\n6:import { fileURLToPath } from \"node:url\";\n7:\n8:const FIXTURE = fileURLToPath(new URL(\"../fixtures/sample-node-repo/\", import.meta.url));\n9:\n10:export interface SampleRepo {\n11:  dir: string;\n12:  /** git blob 해시(sha1)로 파일 내용 식별 */\n13:  blob(relPath: string): string;\n14:  /** 추적 파일 + 미추적 파일의 변경 목록 (`git status --porcelain`) */\n15:  status(): string[];\n16:  cleanup(): void;\n17:}\n18:\n19:/** 픽스처를 임시 디렉터리로 복사하고 git init + 첫 커밋까지 만든다. */\n20:export function createSampleRepo(prefix = \"agent-studio-spike-\"): SampleRepo {\n21:  const dir = mkdtempSync(join(tmpdir(), prefix));\n22:  cpSync(FIXTURE, dir, { recursive: true });\n23:  const git = (...args: string[]) =>\n24:    execFileSync(\"git\", args, { cwd: dir, encoding: \"utf8\", stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n25:  git(\"init\", \"-q\", \"-b\", \"main\");\n26:  git(\"config\", \"user.email\", \"spike@agent-studio.local\");\n27:  git(\"config\", \"user.name\", \"Agent Studio Spike\");\n28:  git(\"add\", \"-A\");\n29:  git(\"commit\", \"-q\", \"-m\", \"fixture: sample-node-repo\");\n30:  return {\n31:    dir,\n32:    blob(relPath) {\n33:      const data = readFileSync(join(dir, relPath));\n34:      return createHash(\"sha1\").update(`blob ${data.length}\\0`).update(data).digest(\"hex\");\n35:    },\n36:    status() {\n37:      return git(\"status\", \"--porcelain\", \"--untracked-files=all\").split(/\\r?\\n/).filter(Boolean);\n38:    },\n39:    cleanup() {\n40:      if (existsSync(dir)) rmSync(dir, { recursive: true, force: true, maxRetries: 5 });\n41:    },\n42:  };\n43:}\n","exit_code":0,"status":"completed"}}
