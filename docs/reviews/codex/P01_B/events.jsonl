{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n '\"'^'\"' packages/protocol/src/rpc.ts\"","aggregated_output":"1:/**\n2: * Shell↔데몬 JSON-RPC 2.0 계약 (P01 T2, SYSTEM_ARCHITECTURE §1 RPC 접속 계약).\n3: * - 메서드는 read/write/control 로 분류한다. `task.transition` 은 노출하지 않는다(검토 #1·#7): lease 전이는 데몬 내부 run 경로,\n4: *   승인 결과 전이는 ApprovalCoordinator, 사용자 조작은 task.cancel/unblock/abandon. control(`daemon.shutdown`)은 main↔데몬 전용.\n5: * - params 스키마(`RPC_PARAMS_SCHEMA`)는 데몬(-32602)과 Shell ipc-guard 양쪽이 같은 것으로 검증한다(검토 #6).\n6: *   `policy.set.policy` 는 형태만 여기서 보고 내용은 `validatePolicy`(policy.schema.json)가 본다.\n7: * - 서버→클라이언트 알림: `{jsonrpc:'2.0', method:'events.batch', params:{events: JournalEvent[]}}`.\n8: */\n9:import { Ajv } from \"ajv\";\n10:import type { JournalEvent } from \"./events.js\";\n11:import { TASK_KINDS } from \"./events.js\";\n12:\n13:export const RPC_PROTOCOL_VERSION = 1;\n14:\n15:export const RPC_METHODS = {\n16:  read: [\"daemon.status\", \"events.subscribe\", \"task.get\", \"task.list\", \"approval.pending\", \"policy.get\", \"capabilities.get\"],\n17:  write: [\"task.submit\", \"task.cancel\", \"task.unblock\", \"task.abandon\", \"approval.decide\", \"policy.set\", \"user_input.answer\"],\n18:  control: [\"daemon.shutdown\"],\n19:} as const;\n20:export type RpcMethodClass = keyof typeof RPC_METHODS;\n21:export type RpcReadMethod = (typeof RPC_METHODS.read)[number];\n22:export type RpcWriteMethod = (typeof RPC_METHODS.write)[number];\n23:export type RpcControlMethod = (typeof RPC_METHODS.control)[number];\n24:export type RpcMethod = RpcReadMethod | RpcWriteMethod | RpcControlMethod;\n25:\n26:export const RPC_ERRORS = {\n27:  METHOD_NOT_FOUND: -32601,\n28:  INVALID_PARAMS: -32602,\n29:  UNAUTHORIZED: -32001,\n30:  STALE_WRITER: -32003,\n31:  PRECONDITION_FAILED: -32004,\n32:  APPROVAL_ERROR: -32005,\n33:  NOT_PENDING: -32006,\n34:} as const;\n35:/** JSON-RPC 표준: 요청 형식 오류·내부 오류 */\n36:export const RPC_INVALID_REQUEST = -32600;\n37:export const RPC_INTERNAL_ERROR = -32000;\n38:\n39:export type RpcId = number | string;\n40:export interface RpcRequest {\n41:  jsonrpc: \"2.0\";\n42:  id: RpcId;\n43:  method: string;\n44:  params?: unknown;\n45:}\n46:export interface RpcError {\n47:  code: number;\n48:  message: string;\n49:  data?: unknown;\n50:}\n51:export type RpcResponse = { jsonrpc: \"2.0\"; id: RpcId | null; result: unknown } | { jsonrpc: \"2.0\"; id: RpcId | null; error: RpcError };\n52:export interface RpcEventsBatch {\n53:  jsonrpc: \"2.0\";\n54:  method: \"events.batch\";\n55:  params: { events: JournalEvent[] };\n56:}\n57:\n58:export type JsonSchema = Record<string, unknown>;\n59:\n60:const obj = (properties: Record<string, JsonSchema>, required: string[] = []): JsonSchema => ({ type: \"object\", additionalProperties: false, required, properties });\n61:const EMPTY = obj({});\n62:const ID = { type: \"string\", minLength: 1 } as const;\n63:const COMBO = obj({ provider: { enum: [\"claude\", \"codex\"] }, os: { type: \"string\", minLength: 1 }, sandbox: { type: \"string\", minLength: 1 }, variant: { type: \"string\", minLength: 1 } }, [\"provider\", \"os\", \"sandbox\", \"variant\"]);\n64:\n65:export const RPC_PARAMS_SCHEMA: Record<RpcMethod, JsonSchema> = {\n66:  \"daemon.status\": EMPTY,\n67:  \"events.subscribe\": obj({ fromSeq: { type: \"integer\", minimum: 0 } }, [\"fromSeq\"]),\n68:  \"task.get\": obj({ taskId: ID }, [\"taskId\"]),\n69:  \"task.list\": EMPTY,\n70:  \"approval.pending\": EMPTY,\n71:  \"policy.get\": obj({ projectId: ID }),\n72:  \"capabilities.get\": EMPTY,\n73:  \"task.submit\": obj({ title: { type: \"string\", minLength: 1, maxLength: 200 }, kind: { enum: [...TASK_KINDS] }, phaseId: ID }, [\"title\", \"kind\"]),\n74:  \"task.cancel\": obj({ taskId: ID }, [\"taskId\"]),\n75:  \"task.unblock\": obj({ taskId: ID }, [\"taskId\"]),\n76:  \"task.abandon\": obj({ taskId: ID }, [\"taskId\"]),\n77:  \"approval.decide\": obj({ requestId: ID, decision: { enum: [\"accept\", \"decline\", \"cancel\"] }, scope: { enum: [\"once\", \"project\", \"until_expiry\"] } }, [\"requestId\", \"decision\"]),\n78:  \"policy.set\": obj({ projectId: ID, policy: { type: \"object\" }, combos: obj({ claude: COMBO, codex: COMBO }) }, [\"projectId\", \"policy\"]),\n79:  \"user_input.answer\": obj({ requestId: ID, answers: { type: \"object\", additionalProperties: { type: \"string\" } } }, [\"requestId\", \"answers\"]),\n80:  \"daemon.shutdown\": EMPTY,\n81:};\n82:\n83:export function methodClass(method: string): RpcMethodClass | null {\n84:  for (const cls of Object.keys(RPC_METHODS) as RpcMethodClass[]) {\n85:    if ((RPC_METHODS[cls] as readonly string[]).includes(method)) return cls;\n86:  }\n87:  return null;\n88:}\n89:export const isRpcMethod = (method: string): method is RpcMethod => methodClass(method) !== null;\n90:\n91:type Validator = ((x: unknown) => boolean) & { errors?: { instancePath: string; message?: string; params?: Record<string, unknown> }[] | null };\n92:const validators = new Map<RpcMethod, Validator>();\n93:let ajv: Ajv | undefined;\n94:\n95:/** params(생략 시 `{}`)를 메서드 스키마로 검증해 오류 문자열 목록을 돌려준다(빈 배열 = 정상). */\n96:export function validateParams(method: RpcMethod, params: unknown): string[] {\n97:  let v = validators.get(method);\n98:  if (!v) {\n99:    ajv ??= new Ajv({ allErrors: true, strict: true });\n100:    v = ajv.compile(RPC_PARAMS_SCHEMA[method]) as Validator;\n101:    validators.set(method, v);\n102:  }\n103:  const input = params === undefined ? {} : params;\n104:  if (v(input)) return [];\n105:  return (v.errors ?? []).map((e) => {\n106:    const extra = e.params && \"additionalProperty\" in e.params ? ` (${String(e.params.additionalProperty)})` : \"\";\n107:    return `${e.instancePath || \"/\"}: ${e.message ?? \"invalid\"}${extra}`;\n108:  });\n109:}\n","exit_code":0,"status":"completed"}}
