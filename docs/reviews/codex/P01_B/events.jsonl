{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n '\"'^'\"' packages/core/src/journal/sqlite-store.ts\"","aggregated_output":"1:/**\n2: * SQLite EventStore — better-sqlite3, WAL, append-only(UPDATE/DELETE 트리거 거부), 단일 writer(동기 트랜잭션).\n3: * 투영은 append 와 같은 트랜잭션에서 적용되고, 기동 시 투영 테이블이 없거나 cursor 가 뒤처지면 저널에서 전부 재구성한다.\n4: */\n5:import Database from \"better-sqlite3\";\n6:import type { EventStore, JournalEvent, NewEvent } from \"./event-store.js\";\n7:import { prepareEvent, Subscribers } from \"./event-store.js\";\n8:import { applyProjection, ensureProjectionTables, PROJECTORS, projectionChecksum, rebuildProjections } from \"./projections.js\";\n9:\n10:export const SCHEMA_VERSION = 1;\n11:\n12:/** DATABASE_SCHEMA §2.1 DDL 그대로 + schema_version + append-only 트리거 */\n13:const DDL = `\n14:CREATE TABLE IF NOT EXISTS schema_version (version INTEGER NOT NULL, applied_at TEXT NOT NULL);\n15:CREATE TABLE IF NOT EXISTS events (\n16:  seq            INTEGER PRIMARY KEY,\n17:  event_id       TEXT NOT NULL UNIQUE,\n18:  ts             TEXT NOT NULL,\n19:  type           TEXT NOT NULL,\n20:  workspace_id   TEXT, project_id TEXT, phase_id TEXT, task_id TEXT,\n21:  agent_run_id   TEXT, session_ref TEXT,\n22:  correlation_id TEXT,\n23:  causation_seq  INTEGER,\n24:  fencing_token  INTEGER,\n25:  payload        TEXT NOT NULL CHECK (json_valid(payload)),\n26:  redacted       INTEGER NOT NULL DEFAULT 0\n27:);\n28:CREATE INDEX IF NOT EXISTS ix_events_task ON events(task_id, seq);\n29:CREATE INDEX IF NOT EXISTS ix_events_run  ON events(agent_run_id, seq);\n30:CREATE INDEX IF NOT EXISTS ix_events_type ON events(type, seq);\n31:CREATE TRIGGER IF NOT EXISTS events_no_update BEFORE UPDATE ON events BEGIN SELECT RAISE(ABORT, 'events is append-only'); END;\n32:CREATE TRIGGER IF NOT EXISTS events_no_delete BEFORE DELETE ON events BEGIN SELECT RAISE(ABORT, 'events is append-only'); END;\n33:`;\n34:\n35:type Row = {\n36:  seq: number;\n37:  event_id: string;\n38:  ts: string;\n39:  type: string;\n40:  workspace_id: string | null;\n41:  project_id: string | null;\n42:  phase_id: string | null;\n43:  task_id: string | null;\n44:  agent_run_id: string | null;\n45:  session_ref: string | null;\n46:  correlation_id: string | null;\n47:  causation_seq: number | null;\n48:  fencing_token: number | null;\n49:  payload: string;\n50:  redacted: number;\n51:};\n52:\n53:function rowToEvent(r: Row): JournalEvent {\n54:  const e: JournalEvent = {\n55:    seq: r.seq,\n56:    eventId: r.event_id,\n57:    ts: r.ts,\n58:    type: r.type as JournalEvent[\"type\"],\n59:    payload: JSON.parse(r.payload) as Record<string, unknown>,\n60:    redacted: (r.redacted ? 1 : 0) as 0 | 1,\n61:  };\n62:  if (r.workspace_id !== null) e.workspaceId = r.workspace_id;\n63:  if (r.project_id !== null) e.projectId = r.project_id;\n64:  if (r.phase_id !== null) e.phaseId = r.phase_id;\n65:  if (r.task_id !== null) e.taskId = r.task_id;\n66:  if (r.agent_run_id !== null) e.agentRunId = r.agent_run_id;\n67:  if (r.session_ref !== null) e.sessionRef = r.session_ref;\n68:  if (r.correlation_id !== null) e.correlationId = r.correlation_id;\n69:  if (r.causation_seq !== null) e.causationSeq = r.causation_seq;\n70:  if (r.fencing_token !== null) e.fencingToken = r.fencing_token;\n71:  return e;\n72:}\n73:\n74:export interface ProjectionsApi {\n75:  query(table: string): Record<string, unknown>[];\n76:  checksum(): string;\n77:  rebuild(): void;\n78:}\n79:\n80:export class SqliteEventStore implements EventStore {\n81:  private readonly subs = new Subscribers();\n82:  private readonly insert;\n83:  private readonly selectRange;\n84:  private readonly selectMax;\n85:  private readonly appendTx;\n86:\n87:  constructor(\n88:    readonly db: Database.Database,\n89:    private readonly now: () => number = Date.now,\n90:  ) {\n91:    db.pragma(\"journal_mode = WAL\");\n92:    db.pragma(\"synchronous = NORMAL\");\n93:    db.pragma(\"busy_timeout = 5000\");\n94:    db.pragma(\"foreign_keys = ON\");\n95:    db.exec(DDL);\n96:    if (this.schemaVersion() === 0) {\n97:      db.prepare(\"INSERT INTO schema_version(version, applied_at) VALUES (?, ?)\").run(SCHEMA_VERSION, new Date(now()).toISOString());\n98:    }\n99:    this.insert = db.prepare(\n100:      `INSERT INTO events(seq, event_id, ts, type, workspace_id, project_id, phase_id, task_id, agent_run_id, session_ref, correlation_id, causation_seq, fencing_token, payload, redacted)\n101:       VALUES (@seq, @event_id, @ts, @type, @workspace_id, @project_id, @phase_id, @task_id, @agent_run_id, @session_ref, @correlation_id, @causation_seq, @fencing_token, @payload, @redacted)`,\n102:    );\n103:    this.selectRange = db.prepare(\"SELECT * FROM events WHERE seq >= ? AND seq <= ? ORDER BY seq\");\n104:    this.selectMax = db.prepare(\"SELECT COALESCE(MAX(seq), 0) AS m FROM events\");\n105:    this.appendTx = db.transaction((e: JournalEvent) => {\n106:      this.insert.run({\n107:        seq: e.seq,\n108:        event_id: e.eventId,\n109:        ts: e.ts,\n110:        type: e.type,\n111:        workspace_id: e.workspaceId ?? null,\n112:        project_id: e.projectId ?? null,\n113:        phase_id: e.phaseId ?? null,\n114:        task_id: e.taskId ?? null,\n115:        agent_run_id: e.agentRunId ?? null,\n116:        session_ref: e.sessionRef ?? null,\n117:        correlation_id: e.correlationId ?? null,\n118:        causation_seq: e.causationSeq ?? null,\n119:        fencing_token: e.fencingToken ?? null,\n120:        payload: JSON.stringify(e.payload),\n121:        redacted: e.redacted,\n122:      });\n123:      applyProjection(db, e);\n124:    });\n125:    this.ensureProjectionsFresh();\n126:  }\n127:\n128:  /** 기동 경로: 투영 테이블 부재 또는 cursor < lastSeq → 전체 재구성. */\n129:  private ensureProjectionsFresh(): void {\n130:    const tables = new Set(\n131:      (this.db.prepare(\"SELECT name FROM sqlite_master WHERE type='table'\").all() as { name: string }[]).map((r) => r.name),\n132:    );\n133:    const need = [...PROJECTORS.map((p) => p.table), \"projection_cursor\"];\n134:    const missing = need.some((t) => !tables.has(t));\n135:    if (missing) {\n136:      rebuildProjections(this);\n137:      return;\n138:    }\n139:    ensureProjectionTables(this.db);\n140:    const cursors = this.db.prepare(\"SELECT last_seq FROM projection_cursor\").all() as { last_seq: number }[];\n141:    const minCursor = cursors.length === need.length - 1 ? Math.min(...cursors.map((c) => c.last_seq)) : -1;\n142:    if (minCursor !== this.lastSeq()) rebuildProjections(this);\n143:  }\n144:\n145:  append(e: NewEvent): JournalEvent {\n146:    const stored = prepareEvent(e, this.lastSeq() + 1, this.now);\n147:    this.appendTx(stored);\n148:    const back = this.read(stored.seq, stored.seq)[0]!;\n149:    this.subs.emit(back);\n150:    return back;\n151:  }\n152:\n153:  read(fromSeq: number, toSeq?: number): JournalEvent[] {\n154:    const rows = this.selectRange.all(Math.max(1, fromSeq), toSeq ?? Number.MAX_SAFE_INTEGER) as Row[];\n155:    return rows.map(rowToEvent);\n156:  }\n157:\n158:  lastSeq(): number {\n159:    return (this.selectMax.get() as { m: number }).m;\n160:  }\n161:\n162:  subscribe(fromSeq: number, cb: (e: JournalEvent) => void): () => void {\n163:    for (const e of this.read(fromSeq)) cb(e);\n164:    return this.subs.add(cb);\n165:  }\n166:\n167:  close(): void {\n168:    this.db.close();\n169:  }\n170:\n171:  // --- SQLite 전용 ---\n172:  schemaVersion(): number {\n173:    const r = this.db.prepare(\"SELECT MAX(version) AS v FROM schema_version\").get() as { v: number | null };\n174:    return r.v ?? 0;\n175:  }\n176:  pragma(name: string): unknown {\n177:    return this.db.pragma(name, { simple: true });\n178:  }\n179:  /** 테스트·운영 도구용 원시 SQL(저널 자체는 트리거가 보호). */\n180:  rawExec(sql: string): void {\n181:    this.db.exec(sql);\n182:  }\n183:  columns(table: string): string[] {\n184:    return (this.db.prepare(`PRAGMA table_info(${table})`).all() as { name: string }[]).map((c) => c.name);\n185:  }\n186:  projections(): ProjectionsApi {\n187:    return {\n188:      query: (table) => this.db.prepare(`SELECT * FROM ${table}`).all() as Record<string, unknown>[],\n189:      checksum: () => projectionChecksum(this),\n190:      rebuild: () => rebuildProjections(this),\n191:    };\n192:  }\n193:}\n194:\n195:export function openSqliteStore(path: string, now?: () => number): SqliteEventStore {\n196:  return new SqliteEventStore(new Database(path), now);\n197:}\n","exit_code":0,"status":"completed"}}
