{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n '\"'^'\"' packages/core/src/daemon/rpc.test.ts\"","aggregated_output":"1:/**\n2: * T2 WS JSON-RPC 서버/클라이언트 in-proc 테스트(메모리 저널, port 0).\n3: * (a) SE-06a 인증 실패 → 4001/4003, 저널 불변 (b) 메서드 노출·스키마 검증·사용자 전이 (c) E4 재구독 누락·중복 0\n4: * (d) 재전송 → dropped (d2) 건너뜀 → gaps + 자동 재구독 (e) 오류 코드 (f) REC-04 기초(재접속이 승인 타이머를 연장하지 않음) (g) shutdown 은 main 만.\n5: */\n6:import { existsSync, mkdtempSync, rmSync } from \"node:fs\";\n7:import { tmpdir } from \"node:os\";\n8:import { join } from \"node:path\";\n9:import { afterEach, describe, expect, it } from \"vitest\";\n10:import WebSocket from \"ws\";\n11:import { DEFAULT_POLICY } from \"@agent-studio/protocol\";\n12:import type { JournalEvent } from \"@agent-studio/protocol\";\n13:import { DefaultPolicyBroker } from \"../approval-broker.js\";\n14:import { ApprovalCoordinator } from \"../approval-coordinator.js\";\n15:import { loadBundledWarnings, PolicyGate, registerIsolationWarnings } from \"../isolation.js\";\n16:import { MemoryEventStore } from \"../journal/memory-store.js\";\n17:import { Scheduler } from \"../scheduler.js\";\n18:import { PROTOCOL_VERSION, proof } from \"./protocol.js\";\n19:import { DaemonClient, RpcCallError } from \"./rpc-client.js\";\n20:import { startRpcServer, type RpcServer } from \"./rpc-server.js\";\n21:\n22:const TOKEN = \"test-token-0123456789\";\n23:const dirs: string[] = [];\n24:const servers: RpcServer[] = [];\n25:const clients: DaemonClient[] = [];\n26:afterEach(async () => {\n27:  for (const c of clients.splice(0)) c.close();\n28:  for (const s of servers.splice(0)) await s.close();\n29:  while (dirs.length) rmSync(dirs.pop()!, { recursive: true, force: true });\n30:});\n31:\n32:async function boot(opts: { onShutdown?: () => void } = {}) {\n33:  const stateDir = mkdtempSync(join(tmpdir(), \"as-rpc-\"));\n34:  dirs.push(stateDir);\n35:  const store = new MemoryEventStore();\n36:  const clock = { t: Date.parse(\"2026-11-02T00:00:00.000Z\") };\n37:  const now = () => clock.t;\n38:  const scheduler = new Scheduler(store, { now });\n39:  const broker = new DefaultPolicyBroker(store, DEFAULT_POLICY, { now });\n40:  const coordinator = new ApprovalCoordinator(scheduler, broker, store);\n41:  store.append({ type: \"ProjectRegistered\", projectId: \"p1\", payload: { id: \"p1\", path: stateDir } });\n42:  registerIsolationWarnings(store, loadBundledWarnings());\n43:  const gate = new PolicyGate(store, \"p1\", now);\n44:  const server = await startRpcServer({ store, scheduler, broker, coordinator, gate, token: TOKEN, stateDir, tokenRef: \"file:test\", now, ...(opts.onShutdown && { onShutdown: opts.onShutdown }) });\n45:  servers.push(server);\n46:  return { stateDir, store, clock, now, scheduler, broker, coordinator, gate, server };\n47:}\n48:\n49:async function connect(stateDir: string, extra: Partial<Parameters<typeof DaemonClient.connect>[0]> = {}) {\n50:  const received: number[] = [];\n51:  const events: JournalEvent[] = [];\n52:  const client = await DaemonClient.connect({\n53:    stateDir,\n54:    token: TOKEN,\n55:    onEvent: (e) => {\n56:      received.push(e.seq);\n57:      events.push(e);\n58:    },\n59:    ...extra,\n60:  });\n61:  clients.push(client);\n62:  return { client, received, events };\n63:}\n64:\n65:const until = async (pred: () => boolean, ms = 10_000) => {\n66:  const deadline = Date.now() + ms;\n67:  while (!pred()) {\n68:    if (Date.now() > deadline) throw new Error(\"timeout waiting for condition\");\n69:    await new Promise((r) => setTimeout(r, 10));\n70:  }\n71:};\n72:const range = (n: number) => Array.from({ length: n }, (_, i) => i + 1);\n73:\n74:/** 핸드셰이크를 손으로 진행하는 원시 클라이언트 — 서버 측 거부 코드를 관찰한다. */\n75:function rawHandshake(port: number, hello: Record<string, unknown>, authOf?: (challenge: { serverNonce: string }) => Record<string, unknown>): Promise<{ code: number; reason: string }> {\n76:  return new Promise((resolve, reject) => {\n77:    const ws = new WebSocket(`ws://127.0.0.1:${port}/`);\n78:    ws.on(\"open\", () => ws.send(JSON.stringify(hello)));\n79:    ws.on(\"message\", (raw) => {\n80:      const msg = JSON.parse(String(raw)) as { type?: string; serverNonce?: string };\n81:      if (msg.type === \"challenge\" && authOf) ws.send(JSON.stringify(authOf({ serverNonce: msg.serverNonce ?? \"\" })));\n82:      if (msg.type === \"welcome\") ws.close(1000, \"done\");\n83:    });\n84:    ws.on(\"close\", (code, reason) => resolve({ code, reason: String(reason) }));\n85:    ws.on(\"error\", reject);\n86:  });\n87:}\n88:\n89:async function toWaitingApproval(b: Awaited<ReturnType<typeof boot>>, runId = \"run-1\") {\n90:  const taskId = b.scheduler.submit({ title: \"exec task\", kind: \"impl\" });\n91:  const { fencingToken } = b.scheduler.acquireLease(taskId, runId);\n92:  b.scheduler.transition(taskId, \"lease_acquired\", { kind: \"lease\", token: fencingToken });\n93:  const r = b.coordinator.request({ taskId, runId, kind: \"approval\", category: \"exec\", request: { command: \"npm test\" } }, fencingToken);\n94:  expect(r.verdict).toBe(\"ASK\");\n95:  expect(b.scheduler.state(taskId).status).toBe(\"WAITING_APPROVAL\");\n96:  return { taskId, requestId: r.requestId };\n97:}\n98:\n99:describe(\"rpc (a) SE-06a 인증\", () => {\n100:  it(\"틀린 증명 → 4001·authFailures 증가·저널 불변, 프로토콜 2 → 4003, hello 형식 오류 → 4001, 틀린 토큰 클라이언트는 auth 를 보내지 않는다\", async () => {\n101:    const b = await boot();\n102:    const before = b.store.lastSeq();\n103:    const bad = await rawHandshake(b.server.port, { type: \"hello\", clientNonce: \"cn\", protocolVersion: PROTOCOL_VERSION, role: \"main\" }, () => ({ type: \"auth\", clientProof: \"00\".repeat(32) }));\n104:    expect(bad.code).toBe(4001);\n105:    expect(b.server.stats().authFailures).toBe(1);\n106:    const v2 = await rawHandshake(b.server.port, { type: \"hello\", clientNonce: \"cn\", protocolVersion: 2, role: \"main\" });\n107:    expect(v2.code).toBe(4003);\n108:    const noNonce = await rawHandshake(b.server.port, { type: \"hello\", protocolVersion: PROTOCOL_VERSION, role: \"main\" });\n109:    expect(noNonce.code).toBe(4001);\n110:    expect(b.server.stats().authFailures).toBe(2);\n111:    expect(b.store.lastSeq()).toBe(before);\n112:    expect(b.server.stats().connections).toBe(0);\n113:    await expect(DaemonClient.connect({ stateDir: b.stateDir, token: \"wrong-token\", onEvent: () => {} })).rejects.toThrow(/server proof invalid/);\n114:    expect(b.server.stats().authFailures).toBe(2); // 클라이언트가 증명을 보내기 전에 중단\n115:    // 올바른 증명은 welcome\n116:    const ok = await rawHandshake(b.server.port, { type: \"hello\", clientNonce: \"cn2\", protocolVersion: PROTOCOL_VERSION, role: \"main\" }, ({ serverNonce }) => ({ type: \"auth\", clientProof: proof(TOKEN, serverNonce, \"cn2\", \"client\") }));\n117:    expect(ok.code).toBe(1000);\n118:  });\n119:});\n120:\n121:describe(\"rpc (b) 메서드·스키마·사용자 전이\", () => {\n122:  it(\"task.submit → task.get QUEUED → task.cancel CANCELLED(TaskTransition +1), 모르는/비노출 메서드 -32601, 스키마 위반 -32602\", async () => {\n123:    const b = await boot();\n124:    const { client } = await connect(b.stateDir);\n125:    const status = await client.call<{ pid: number; seq: number; protocolVersion: number; tokenRef: string }>(\"daemon.status\");\n126:    expect(status.pid).toBe(process.pid);\n127:    expect(status.seq).toBe(b.store.lastSeq());\n128:    expect(status.tokenRef).toBe(\"file:test\");\n129:    const { taskId } = await client.call<{ taskId: string }>(\"task.submit\", { title: \"hello\", kind: \"impl\" });\n130:    expect(await client.call(\"task.get\", { taskId })).toMatchObject({ id: taskId, status: \"QUEUED\", iteration: 0 });\n131:    expect((await client.call<{ id: string }[]>(\"task.list\")).map((t) => t.id)).toEqual([taskId]);\n132:    const e1 = await client.call(\"bogus.method\").catch((e: unknown) => e);\n133:    expect(e1).toBeInstanceOf(RpcCallError);\n134:    expect((e1 as RpcCallError).code).toBe(-32601);\n135:    const e2 = await client.call(\"task.transition\", { taskId, event: \"cancel\" }).catch((e: unknown) => e);\n136:    expect((e2 as RpcCallError).code).toBe(-32601);\n137:    const e3 = await client.call(\"task.submit\", { title: \"\", kind: \"impl\" }).catch((e: unknown) => e);\n138:    expect((e3 as RpcCallError).code).toBe(-32602);\n139:    const e4 = await client.call(\"task.submit\", { title: \"x\", kind: \"impl\", extra: true }).catch((e: unknown) => e);\n140:    expect((e4 as RpcCallError).code).toBe(-32602);\n141:    const e5 = await client.call(\"task.get\", { taskId: \"nope\" }).catch((e: unknown) => e);\n142:    expect((e5 as RpcCallError).code).toBe(-32602);\n143:    const transitionsBefore = b.store.read(1).filter((e) => e.type === \"TaskTransition\" && e.taskId === taskId).length;\n144:    expect(await client.call(\"task.cancel\", { taskId })).toEqual({ status: \"CANCELLED\" });\n145:    expect(b.store.read(1).filter((e) => e.type === \"TaskTransition\" && e.taskId === taskId).length).toBe(transitionsBefore + 1);\n146:    expect(b.scheduler.state(taskId).status).toBe(\"CANCELLED\");\n147:    const e6 = await client.call(\"task.cancel\", { taskId }).catch((e: unknown) => e);\n148:    expect((e6 as RpcCallError).code).toBe(-32004);\n149:    const caps = await client.call<{ isolationWarnings: unknown[]; tokenRef: string }>(\"capabilities.get\");\n150:    expect(caps.isolationWarnings).toHaveLength(6);\n151:    expect(await client.call(\"policy.get\")).toMatchObject({ policy: { permissionMode: DEFAULT_POLICY.permissionMode }, badge: { active: false } });\n152:  });\n153:});\n154:\n155:describe(\"rpc (c)(d) E4 seq 재구독\", () => {\n156:  it(\"(c) 25번째 수신 뒤 강제 종료 → 끊긴 동안 10건 append → reconnect → 최종 [1..N], dropped 0, gaps 0\", async () => {\n157:    const b = await boot();\n158:    const { client, received } = await connect(b.stateDir);\n159:    // 서버가 이벤트를 만든다(submit 당 2건). 배치가 섞이도록 비동기로 흘린다.\n160:    const produce = async (n: number) => {\n161:      for (let i = 0; i < n; i++) {\n162:        b.scheduler.submit({ title: `t${i}`, kind: \"impl\" });\n163:        if (i % 3 === 0) await new Promise((r) => setTimeout(r, 1));\n164:      }\n165:    };\n166:    await produce(15);\n167:    await until(() => received.length >= 25);\n168:    client.terminate();\n169:    await until(() => !client.connected);\n170:    const lastBefore = client.lastSeq;\n171:    await produce(5); // 끊긴 동안 10건\n172:    expect(b.store.lastSeq()).toBeGreaterThanOrEqual(lastBefore + 10);\n173:    await client.reconnect();\n174:    await produce(10);\n175:    const N = b.store.lastSeq();\n176:    await until(() => received.length >= N);\n177:    expect(received).toEqual(range(N));\n178:    expect(client.dropped).toBe(0);\n179:    expect(client.gaps).toBe(0);\n180:    expect(client.lastSeq).toBe(N);\n181:  });\n182:\n183:  it(\"(d) 서버가 보낸 seq 를 재전송해도 onEvent 중복 없음·dropped 증가\", async () => {\n184:    const b = await boot();\n185:    b.server.hooks.mutateBatch = (evs) => (evs.length ? [...evs, evs[0]!] : evs);\n186:    const { client, received } = await connect(b.stateDir);\n187:    for (let i = 0; i < 10; i++) b.scheduler.submit({ title: `t${i}`, kind: \"impl\" });\n188:    const N = b.store.lastSeq();\n189:    await until(() => received.length >= N);\n190:    await new Promise((r) => setTimeout(r, 50));\n191:    expect(received).toEqual(range(N));\n192:    expect(client.dropped).toBeGreaterThan(0);\n193:    expect(client.gaps).toBe(0);\n194:  });\n195:\n196:  it(\"(d2) 서버가 seq 하나를 건너뛰면 gaps 1 + onGap 호출 + 자동 재구독 뒤 최종 [1..N]\", async () => {\n197:    const b = await boot();\n198:    let skipped = false;\n199:    b.server.hooks.mutateBatch = (evs) => {\n200:      if (!skipped && evs.length > 1) {\n201:        skipped = true;\n202:        return [evs[0]!, ...evs.slice(2)];\n203:      }\n204:      return evs;\n205:    };\n206:    const gapsSeen: [number, number][] = [];\n207:    const { client, received } = await connect(b.stateDir, { onGap: (expected, got) => gapsSeen.push([expected, got]) });\n208:    for (let i = 0; i < 10; i++) b.scheduler.submit({ title: `t${i}`, kind: \"impl\" });\n209:    const N = b.store.lastSeq();\n210:    await until(() => received.length >= N);\n211:    expect(received).toEqual(range(N));\n212:    expect(client.gaps).toBe(1);\n213:    expect(gapsSeen).toHaveLength(1);\n214:    expect(gapsSeen[0]![1]).toBe(gapsSeen[0]![0] + 1);\n215:    expect(client.dropped).toBe(0);\n216:  });\n217:});\n218:\n219:describe(\"rpc (e) 오류 코드\", () => {\n220:  it(\"approval.decide 만료 -32005, user_input.answer 없는 요청 -32006, policy.set 스키마 위반 -32602 / 정상 applied, daemon.shutdown renderer -32001\", async () => {\n221:    const b = await boot();\n222:    const { requestId } = await toWaitingApproval(b);\n223:    const { client } = await connect(b.stateDir);\n224:    expect(await client.call(\"approval.pending\")).toHaveLength(1);\n225:    b.clock.t += 16 * 60_000;\n226:    const e1 = await client.call(\"approval.decide\", { requestId, decision: \"accept\" }).catch((e: unknown) => e);\n227:    expect((e1 as RpcCallError).code).toBe(-32005);\n228:    expect((e1 as RpcCallError).data).toMatchObject({ code: \"approval_expired\" });\n229:    const e2 = await client.call(\"user_input.answer\", { requestId: \"nope\", answers: { answer: \"confirmed\" } }).catch((e: unknown) => e);\n230:    expect((e2 as RpcCallError).code).toBe(-32006);\n231:    const e3 = await client.call(\"policy.set\", { projectId: \"p1\", policy: { ...DEFAULT_POLICY, v: 2 } }).catch((e: unknown) => e);\n232:    expect((e3 as RpcCallError).code).toBe(-32602);\n233:    const e4 = await client.call(\"policy.set\", { projectId: \"p1\", policy: { ...DEFAULT_POLICY, rules: { ...DEFAULT_POLICY.rules, exec: { default: \"WHATEVER\", scope: \"once\" } } } }).catch((e: unknown) => e);\n234:    expect((e4 as RpcCallError).code).toBe(-32602);\n235:    const planMode = { ...DEFAULT_POLICY, permissionMode: { ...DEFAULT_POLICY.permissionMode, claude: \"plan\" as const } };\n236:    expect(await client.call(\"policy.set\", { projectId: \"p1\", policy: planMode })).toEqual({ status: \"applied\" });\n237:    expect(b.gate.policy().permissionMode.claude).toBe(\"plan\");\n238:    // 경고 조합에서 자동 모드 → confirmation_required → user_input.answer 로 확인\n239:    const auto = { ...DEFAULT_POLICY, permissionMode: { claude: \"default\" as const, codex: { approvalPolicy: \"never\" as const, sandbox: \"workspaceWrite\" as const } } };\n240:    const r = await client.call<{ status: string; requestId: string; warnings: unknown[] }>(\"policy.set\", { projectId: \"p1\", policy: auto, combos: { codex: { provider: \"codex\", os: \"windows\", sandbox: \"workspaceWrite\", variant: \"elevated\" } } });\n241:    expect(r.status).toBe(\"confirmation_required\");\n242:    expect(r.warnings).toHaveLength(2);\n243:    const e5 = await client.call(\"user_input.answer\", { requestId: r.requestId, answers: { answer: \"maybe\" } }).catch((e: unknown) => e);\n244:    expect((e5 as RpcCallError).code).toBe(-32602);\n245:    expect(await client.call(\"user_input.answer\", { requestId: r.requestId, answers: { answer: \"confirmed\" } })).toEqual({ status: \"applied\" });\n246:    expect(b.gate.policy().permissionMode.codex.approvalPolicy).toBe(\"never\");\n247:    const e6 = await client.call(\"user_input.answer\", { requestId: r.requestId, answers: { answer: \"confirmed\" } }).catch((e: unknown) => e);\n248:    expect((e6 as RpcCallError).code).toBe(-32006);\n249:    // renderer 역할의 연결에서 control 메서드\n250:    const { client: renderer } = await connect(b.stateDir, { role: \"renderer\" });\n251:    const e7 = await renderer.call(\"daemon.shutdown\").catch((e: unknown) => e);\n252:    expect((e7 as RpcCallError).code).toBe(-32001);\n253:  });\n254:});\n255:\n256:describe(\"rpc (f) REC-04 기초\", () => {\n257:  it(\"Shell 강제 종료 뒤 재접속해도 승인 타이머는 요청 시각 기준으로 만료된다\", async () => {\n258:    const b = await boot();\n