{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n '\"'^'\"' packages/core/src/approval-coordinator.ts\"","aggregated_output":"1:/**\n2: * ApprovalCoordinator (P01 T5, 검토 #3) — Broker 의 요청/결정/만료를 Scheduler 의 DAEMON 전이로 잇는 **유일한** 경로.\n3: * - request: ASK/ALWAYS_ASK 면 `scheduler.check()` 로 전이 가능성을 먼저 확인한 뒤 요청을 기록하고 대기 전이(리뷰A#3);\n4: *   대기 사유는 `approval_needed`(기본)·`git_conflict`·`recovery_review`·`compare_blocked`(리뷰A#7). AUTO/DENY 는 전이 없음.\n5: * - decide: 요청이 보류 중이면 Task 가 그 요청으로 WAITING_APPROVAL 인지 확인한 뒤 기록(아니면 not_pending, 기록 없음);\n6: *   accept → `approved`, decline/cancel → `denied_terminal`\n7: * - tick: 만료된 요청마다 `approval_expired`\n8: * - WAITING_APPROVAL 에서 사용자 `cancel` 이 기록되면 보류 승인을 `decline` 으로 해소한다(PHASE_MANAGEMENT §2 취소 규칙, 리뷰A#6)\n9: * RPC `approval.decide` 와 데몬 타이머는 이 객체만 호출한다(Scheduler 의 daemon 전이를 직접 부르지 않음).\n10: */\n11:import type { ApprovalScope, Verdict } from \"@agent-studio/protocol\";\n12:import { ApprovalError, type ApprovalBroker, type ApprovalRequest, type Decision } from \"./approval-broker.js\";\n13:import type { EventStore, JournalEvent } from \"./journal/event-store.js\";\n14:import { Scheduler, SchedulerError } from \"./scheduler.js\";\n15:\n16:export type WaitingEvent = \"approval_needed\" | \"git_conflict\" | \"recovery_review\" | \"compare_blocked\";\n17:\n18:export class ApprovalCoordinator {\n19:  /** requestId → taskId */\n20:  private readonly taskOf = new Map<string, string>();\n21:  /** taskId → 아직 결정·만료되지 않은 ASK/ALWAYS_ASK 요청 */\n22:  private readonly pendingOf = new Map<string, string>();\n23:\n24:  constructor(\n25:    private readonly scheduler: Scheduler,\n26:    private readonly broker: ApprovalBroker,\n27:    store: EventStore,\n28:  ) {\n29:    store.subscribe(0, (e: JournalEvent) => this.applyEvent(e));\n30:  }\n31:\n32:  private applyEvent(e: JournalEvent): void {\n33:    const rid = typeof e.payload.request_id === \"string\" ? e.payload.request_id : undefined;\n34:    if (e.type === \"ApprovalRequested\" && rid && e.taskId) {\n35:      this.taskOf.set(rid, e.taskId);\n36:      if (e.payload.verdict === \"ASK\" || e.payload.verdict === \"ALWAYS_ASK\") this.pendingOf.set(e.taskId, rid);\n37:    } else if ((e.type === \"ApprovalDecided\" || e.type === \"ApprovalExpired\") && rid) {\n38:      const taskId = this.taskOf.get(rid);\n39:      if (taskId && this.pendingOf.get(taskId) === rid) this.pendingOf.delete(taskId);\n40:    } else if (e.type === \"TaskTransition\" && e.taskId && e.payload.from === \"WAITING_APPROVAL\" && e.payload.reason === \"cancel\") {\n41:      const pending = this.pendingOf.get(e.taskId);\n42:      if (!pending) return;\n43:      try {\n44:        this.broker.decide(pending, \"decline\", \"user\");\n45:      } catch (err) {\n46:        if (!(err instanceof ApprovalError)) throw err; // 이미 결정·만료된 요청은 그대로 둔다\n47:      }\n48:    }\n49:  }\n50:\n51:  /** run(lease 보유자)이 승인·사용자 결정이 필요한 동작을 만났을 때. */\n52:  request(req: ApprovalRequest, fencingToken: number, event: WaitingEvent = \"approval_needed\"): { requestId: string; verdict: Verdict } {\n53:    const verdict = this.broker.evaluate(req);\n54:    const waits = verdict === \"ASK\" || verdict === \"ALWAYS_ASK\";\n55:    const auth = { kind: \"lease\", token: fencingToken } as const;\n56:    if (waits) this.scheduler.check(req.taskId, event, auth); // 리뷰A#3: 기록 전에 전이 가능성 확인(옛 토큰·부적합 상태면 여기서 throw, 저널 불변)\n57:    const requestId = this.broker.request(req);\n58:    if (waits) this.scheduler.transition(req.taskId, event, auth, { requestId });\n59:    return { requestId, verdict };\n60:  }\n61:\n62:  decide(requestId: string, decision: Decision, by: \"user\" | \"policy\", scope?: ApprovalScope): void {\n63:    const taskId = this.taskOf.get(requestId);\n64:    if (this.broker.pending().some((p) => p.requestId === requestId)) {\n65:      const st = taskId ? this.scheduler.state(taskId) : undefined;\n66:      if (!st || st.status !== \"WAITING_APPROVAL\" || st.pendingRequestId !== requestId) {\n67:        throw new SchedulerError(\"not_pending\", `request ${requestId} is not pending on task ${taskId ?? \"?\"} (status ${st?.status ?? \"unknown\"})`);\n68:      }\n69:    }\n70:    this.broker.decide(requestId, decision, by, scope); // 보류가 아니면 Broker 가 정확한 오류(not_found/approval_expired/already_decided)를 낸다\n71:    if (!taskId) return;\n72:    this.scheduler.transition(taskId, decision === \"accept\" ? \"approved\" : \"denied_terminal\", { kind: \"daemon\", requestId });\n73:  }\n74:\n75:  /** 주기 호출: 만료 요청 → BLOCKED(approval_expired). 이미 다른 경로로 떠난 Task(취소 등)는 건너뛴다. */\n76:  tick(): string[] {\n77:    const expired = this.broker.expire();\n78:    for (const requestId of expired) {\n79:      const taskId = this.taskOf.get(requestId);\n80:      if (!taskId) continue;\n81:      try {\n82:        this.scheduler.transition(taskId, \"approval_expired\", { kind: \"daemon\", requestId });\n83:      } catch (err) {\n84:        if (err instanceof SchedulerError && err.code === \"invalid_transition\") continue;\n85:        throw err;\n86:      }\n87:    }\n88:    return expired;\n89:  }\n90:}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n '\"'^'\"' packages/core/src/approval-broker.ts\"","aggregated_output":"1:/**\n2: * ApprovalBroker (P01 T5) — 정책 매트릭스 판정 + 요청/결정/만료 저널 기록. 상태는 저널(`subscribe(0)`)에서만 복원된다.\n3: * 상태 전이는 하지 않는다 — Scheduler 와의 연결은 ApprovalCoordinator 가 유일한 경로(검토 #3).\n4: */\n5:import type { ApprovalCategory, ApprovalScope, PolicyRule, ProjectPolicy, Signals, Verdict } from \"@agent-studio/protocol\";\n6:import { evaluateRule, matchException, ulid } from \"@agent-studio/protocol\";\n7:import type { EventStore, JournalEvent } from \"./journal/event-store.js\";\n8:\n9:export type ApprovalKind = \"approval\" | \"user_input\" | \"mcp_elicitation\";\n10:export type Decision = \"accept\" | \"decline\" | \"cancel\";\n11:\n12:export interface ApprovalRequest {\n13:  taskId: string;\n14:  runId: string;\n15:  kind: ApprovalKind;\n16:  category: ApprovalCategory;\n17:  request: Record<string, unknown>;\n18:  signals?: Signals;\n19:}\n20:\n21:export interface PendingApproval {\n22:  requestId: string;\n23:  taskId: string;\n24:  runId: string;\n25:  kind: ApprovalKind;\n26:  category: ApprovalCategory;\n27:  request: Record<string, unknown>;\n28:  requestedAt: string;\n29:  expiresAt: string;\n30:}\n31:\n32:export interface ApprovalBroker {\n33:  evaluate(req: ApprovalRequest): Verdict;\n34:  /** 요청을 저널에 기록하고 requestId 를 돌려준다. AUTO/DENY 는 즉시 `ApprovalDecided{by:'policy'}` 까지 기록. */\n35:  request(req: ApprovalRequest): string;\n36:  decide(requestId: string, decision: Decision, by: \"user\" | \"policy\", scope?: ApprovalScope): void;\n37:  pending(): PendingApproval[];\n38:  /** TTL 이 지난 보류 요청에 `ApprovalExpired` 를 기록하고 그 ID 들을 돌려준다. */\n39:  expire(): string[];\n40:}\n41:\n42:export class ApprovalError extends Error {\n43:  constructor(readonly code: \"approval_expired\" | \"not_found\" | \"already_decided\") {\n44:    super(code);\n45:    this.name = \"ApprovalError\";\n46:  }\n47:}\n48:\n49:type Rec = PendingApproval & { status: \"pending\" | \"decided\" | \"expired\"; scope: ApprovalScope };\n50:\n51:export class DefaultPolicyBroker implements ApprovalBroker {\n52:  private readonly recs = new Map<string, Rec>();\n53:  private readonly ttlMs: number;\n54:  private readonly now: () => number;\n55:\n56:  constructor(\n57:    private readonly store: EventStore,\n58:    private readonly policy: ProjectPolicy,\n59:    opts: { ttlMs?: number; now?: () => number } = {},\n60:  ) {\n61:    this.ttlMs = opts.ttlMs ?? 15 * 60_000;\n62:    this.now = opts.now ?? Date.now;\n63:    store.subscribe(0, (e) => this.applyEvent(e));\n64:  }\n65:\n66:  private applyEvent(e: JournalEvent): void {\n67:    const rid = e.payload.request_id;\n68:    if (typeof rid !== \"string\") return;\n69:    if (e.type === \"ApprovalRequested\") {\n70:      this.recs.set(rid, {\n71:        requestId: rid,\n72:        taskId: e.taskId ?? \"\",\n73:        runId: e.agentRunId ?? \"\",\n74:        kind: e.payload.kind as ApprovalKind,\n75:        category: e.payload.category as ApprovalCategory,\n76:        request: (e.payload.request ?? {}) as Record<string, unknown>,\n77:        requestedAt: String(e.payload.requested_at ?? e.ts),\n78:        expiresAt: String(e.payload.expires_at),\n79:        scope: (e.payload.scope as ApprovalScope | undefined) ?? \"once\",\n80:        status: \"pending\",\n81:      });\n82:    } else if (e.type === \"ApprovalDecided\") {\n83:      const r = this.recs.get(rid);\n84:      if (r) r.status = \"decided\";\n85:    } else if (e.type === \"ApprovalExpired\") {\n86:      const r = this.recs.get(rid);\n87:      if (r) r.status = \"expired\";\n88:    }\n89:  }\n90:\n91:  private rule(category: ApprovalCategory): PolicyRule {\n92:    return this.policy.rules[category];\n93:  }\n94:\n95:  evaluate(req: ApprovalRequest): Verdict {\n96:    return evaluateRule(this.rule(req.category), req.signals);\n97:  }\n98:\n99:  request(req: ApprovalRequest): string {\n100:    const rule = this.rule(req.category);\n101:    const ex = matchException(rule, req.signals);\n102:    const verdict = ex?.verdict ?? rule.default;\n103:    const scope = ex?.scope ?? rule.scope;\n104:    const id = ulid(this.now());\n105:    const requestedAt = new Date(this.now()).toISOString();\n106:    const expiresAt = new Date(this.now() + this.ttlMs).toISOString();\n107:    this.store.append({\n108:      type: \"ApprovalRequested\",\n109:      taskId: req.taskId,\n110:      agentRunId: req.runId,\n111:      correlationId: id,\n112:      payload: { request_id: id, kind: req.kind, category: req.category, request: req.request, requested_at: requestedAt, expires_at: expiresAt, verdict, scope, ...(req.signals && { signals: req.signals }) },\n113:    });\n114:    if (verdict === \"AUTO\") this.appendDecision(id, req.taskId, \"accept\", \"policy\", scope);\n115:    else if (verdict === \"DENY\") this.appendDecision(id, req.taskId, \"decline\", \"policy\", scope);\n116:    return id;\n117:  }\n118:\n119:  decide(requestId: string, decision: Decision, by: \"user\" | \"policy\", scope?: ApprovalScope): void {\n120:    const r = this.recs.get(requestId);\n121:    if (!r) throw new ApprovalError(\"not_found\");\n122:    if (r.status === \"expired\" || (r.status === \"pending\" && this.isExpired(r))) throw new ApprovalError(\"approval_expired\");\n123:    if (r.status === \"decided\") throw new ApprovalError(\"already_decided\");\n124:    this.appendDecision(requestId, r.taskId, decision, by, scope ?? r.scope);\n125:  }\n126:\n127:  pending(): PendingApproval[] {\n128:    return [...this.recs.values()]\n129:      .filter((r) => r.status === \"pending\")\n130:      .map(({ status: _s, scope: _sc, ...p }) => p);\n131:  }\n132:\n133:  expire(): string[] {\n134:    const out: string[] = [];\n135:    for (const r of this.recs.values()) {\n136:      if (r.status === \"pending\" && this.isExpired(r)) {\n137:        this.store.append({ type: \"ApprovalExpired\", taskId: r.taskId, agentRunId: r.runId || undefined, correlationId: r.requestId, payload: { request_id: r.requestId } });\n138:        out.push(r.requestId);\n139:      }\n140:    }\n141:    return out;\n142:  }\n143:\n144:  private isExpired(r: Rec): boolean {\n145:    return Date.parse(r.expiresAt) <= this.now();\n146:  }\n147:\n148:  private appendDecision(requestId: string, taskId: string, decision: Decision, by: \"user\" | \"policy\", scope: ApprovalScope): void {\n149:    this.store.append({\n150:      type: \"ApprovalDecided\",\n151:      taskId,\n152:      correlationId: requestId,\n153:      payload: { request_id: requestId, decision, scope, by, decided_at: new Date(this.now()).toISOString() },\n154:    });\n155:  }\n156:}\n","exit_code":0,"status":"completed"}}
