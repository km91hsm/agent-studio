ef: e.sessionRef }),\n38:    ...(e.correlationId !== undefined && { correlationId: e.correlationId }),\n39:    ...(e.causationSeq !== undefined && { causationSeq: e.causationSeq }),\n40:    ...(e.fencingToken !== undefined && { fencingToken: e.fencingToken }),\n41:    payload: e.payload,\n42:    redacted: e.redacted ?? 0,\n43:  };\n44:}\n45:\n46:/** 구독자 목록(재생 후 실시간) — 두 어댑터가 공유. */\n47:export class Subscribers {\n48:  private readonly subs = new Set<(e: JournalEvent) => void>();\n49:  add(cb: (e: JournalEvent) => void): () => void {\n50:    this.subs.add(cb);\n51:    return () => this.subs.delete(cb);\n52:  }\n53:  emit(e: JournalEvent): void {\n54:    for (const cb of [...this.subs]) cb(e);\n55:  }\n56:}\n","exit_code":0,"status":"completed"}}
