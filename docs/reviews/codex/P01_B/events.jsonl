{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n '\"'^'\"' packages/core/src/daemon/rpc-server.ts\"","aggregated_output":"1:/**\n2: * 데몬 WS JSON-RPC 서버 (P01 T2, AC-P01-3·5). 127.0.0.1 전용, S5 HMAC 상호 인증 핸드셰이크(protocol.ts) 뒤 JSON-RPC 2.0.\n3: * - params 는 `RPC_PARAMS_SCHEMA` 로 검증(-32602), control 메서드는 role=main 연결만(-32001)\n4: * - `events.subscribe{fromSeq}` → `store.subscribe(fromSeq)` 로 fromSeq 이후 전부를 `events.batch`(≤100건·10ms 코얼레싱, 배치 안 seq 연속)로 전송\n5: * - 상태 변경은 전부 Scheduler/ApprovalCoordinator/PolicyGate 공개 메서드를 거친다(전이 단일 경로)\n6: * - `hooks.mutateBatch` 는 테스트 전용(재전송·건너뜀 주입)\n7: */\n8:import { randomBytes } from \"node:crypto\";\n9:import type { JournalEvent, RpcId, RpcMethod, RpcResponse } from \"@agent-studio/protocol\";\n10:import { isRpcMethod, methodClass, RPC_ERRORS, RPC_INTERNAL_ERROR, RPC_INVALID_REQUEST, RPC_PROTOCOL_VERSION, validateParams, validatePolicy } from \"@agent-studio/protocol\";\n11:import type { ProjectPolicy } from \"@agent-studio/protocol\";\n12:import { WebSocketServer, type WebSocket } from \"ws\";\n13:import { ApprovalError, type ApprovalBroker, type Decision } from \"../approval-broker.js\";\n14:import type { ApprovalCoordinator } from \"../approval-coordinator.js\";\n15:import { allWarnings, type Combos, type PolicyGate } from \"../isolation.js\";\n16:import type { EventStore } from \"../journal/event-store.js\";\n17:import { Scheduler, SchedulerError } from \"../scheduler.js\";\n18:import { ownCreationTime, removeLock, writeLock, type LockFile } from \"./lock.js\";\n19:import { CLIENT_ROLES, CLOSE_HELLO_TIMEOUT, CLOSE_PROTOCOL_MISMATCH, CLOSE_UNAUTHORIZED, HELLO_TIMEOUT_MS, PROTOCOL_VERSION, proof, proofEquals, type ClientRole } from \"./protocol.js\";\n20:\n21:export interface RpcServerOptions {\n22:  store: EventStore;\n23:  scheduler: Scheduler;\n24:  broker: ApprovalBroker;\n25:  coordinator: ApprovalCoordinator;\n26:  gate: PolicyGate;\n27:  token: string;\n28:  stateDir: string;\n29:  port?: number;\n30:  tokenRef?: string;\n31:  now?: () => number;\n32:  /** daemon.shutdown 응답 뒤 서버가 닫힌 다음 호출 */\n33:  onShutdown?: () => void;\n34:}\n35:\n36:export interface RpcServer {\n37:  port: number;\n38:  lock: LockFile;\n39:  stats(): { connections: number; authFailures: number };\n40:  close(): Promise<void>;\n41:  hooks: { mutateBatch?: (events: JournalEvent[]) => JournalEvent[] };\n42:}\n43:\n44:const BATCH_MAX = 100;\n45:const BATCH_DELAY_MS = 10;\n46:\n47:interface Conn {\n48:  ws: WebSocket;\n49:  role: ClientRole;\n50:  unsub?: () => void;\n51:  queue: JournalEvent[];\n52:  timer?: NodeJS.Timeout;\n53:}\n54:\n55:class RpcFailure extends Error {\n56:  constructor(\n57:    readonly code: number,\n58:    message: string,\n59:    readonly data?: unknown,\n60:  ) {\n61:    super(message);\n62:  }\n63:}\n64:\n65:export async function startRpcServer(opts: RpcServerOptions): Promise<RpcServer> {\n66:  const { store, scheduler, broker, coordinator, gate, token, stateDir } = opts;\n67:  const tokenRef = opts.tokenRef ?? \"unknown\";\n68:  const nonce = randomBytes(16).toString(\"hex\");\n69:  const wss = new WebSocketServer({ host: \"127.0.0.1\", port: opts.port ?? 0 });\n70:  await new Promise<void>((resolve, reject) => {\n71:    wss.once(\"listening\", () => resolve());\n72:    wss.once(\"error\", reject);\n73:  });\n74:  const port = (wss.address() as { port: number }).port;\n75:  const lock: LockFile = { pid: process.pid, startedAt: ownCreationTime(), nonce, port, protocolVersion: PROTOCOL_VERSION, tokenRef };\n76:  writeLock(stateDir, lock);\n77:\n78:  const conns = new Set<Conn>();\n79:  let authFailures = 0;\n80:  let closed = false;\n81:  const hooks: RpcServer[\"hooks\"] = {};\n82:\n83:  // user_input 보류 추적(request_id → kind): UserInputRequested 로 생기고 UserInputAnswered 로 사라진다\n84:  const pendingInputs = new Map<string, string>();\n85:  const unsubInputs = store.subscribe(0, (e) => {\n86:    if (e.type === \"UserInputRequested\" && typeof e.payload.request_id === \"string\") pendingInputs.set(e.payload.request_id, String(e.payload.kind));\n87:    else if (e.type === \"UserInputAnswered\" && typeof e.payload.request_id === \"string\") pendingInputs.delete(e.payload.request_id);\n88:  });\n89:\n90:  const send = (ws: WebSocket, body: unknown) => {\n91:    if (ws.readyState === ws.OPEN) ws.send(JSON.stringify(body));\n92:  };\n93:  const reject = (ws: WebSocket, code: number, reason: string) => {\n94:    if (code === CLOSE_UNAUTHORIZED) authFailures++;\n95:    ws.close(code, reason);\n96:  };\n97:\n98:  function flush(conn: Conn): void {\n99:    conn.timer = undefined;\n100:    if (!conn.queue.length) return;\n101:    let events = conn.queue.splice(0, conn.queue.length);\n102:    if (hooks.mutateBatch) events = hooks.mutateBatch(events);\n103:    send(conn.ws, { jsonrpc: \"2.0\", method: \"events.batch\", params: { events } });\n104:  }\n105:  function enqueue(conn: Conn, e: JournalEvent): void {\n106:    conn.queue.push(e);\n107:    if (conn.queue.length >= BATCH_MAX) {\n108:      if (conn.timer) clearTimeout(conn.timer);\n109:      flush(conn);\n110:    } else if (!conn.timer) conn.timer = setTimeout(() => flush(conn), BATCH_DELAY_MS);\n111:  }\n112:  function dropConn(conn: Conn): void {\n113:    conn.unsub?.();\n114:    conn.unsub = undefined;\n115:    if (conn.timer) clearTimeout(conn.timer);\n116:    conn.timer = undefined;\n117:    conn.queue.length = 0;\n118:    conns.delete(conn);\n119:  }\n120:\n121:  async function close(): Promise<void> {\n122:    if (closed) return;\n123:    closed = true;\n124:    unsubInputs();\n125:    for (const c of [...conns]) {\n126:      dropConn(c);\n127:      try {\n128:        c.ws.close(1001, \"server shutdown\");\n129:      } catch {\n130:        /* ignore */\n131:      }\n132:    }\n133:    await new Promise<void>((resolve) => wss.close(() => resolve()));\n134:    removeLock(stateDir);\n135:  }\n136:\n137:  const toRpcError = (err: unknown): { code: number; message: string; data?: unknown } => {\n138:    if (err instanceof RpcFailure) return { code: err.code, message: err.message, ...(err.data !== undefined && { data: err.data }) };\n139:    if (err instanceof ApprovalError) return { code: RPC_ERRORS.APPROVAL_ERROR, message: err.message, data: { code: err.code } };\n140:    if (err instanceof SchedulerError) {\n141:      const data = { code: err.code };\n142:      if (err.code === \"stale_writer\") return { code: RPC_ERRORS.STALE_WRITER, message: err.message, data };\n143:      if (err.code === \"not_pending\") return { code: RPC_ERRORS.NOT_PENDING, message: err.message, data };\n144:      if (err.code === \"unknown_task\" || err.code === \"invalid_kind\" || err.code === \"duplicate_task\") return { code: RPC_ERRORS.INVALID_PARAMS, message: err.message, data };\n145:      return { code: RPC_ERRORS.PRECONDITION_FAILED, message: err.message, data };\n146:    }\n147:    return { code: RPC_INTERNAL_ERROR, message: err instanceof Error ? err.message : String(err) };\n148:  };\n149:\n150:  function dispatch(conn: Conn, method: RpcMethod, params: Record<string, unknown>): unknown {\n151:    switch (method) {\n152:      case \"daemon.status\":\n153:        return { pid: process.pid, seq: store.lastSeq(), protocolVersion: RPC_PROTOCOL_VERSION, tokenRef, nonce, startedAt: lock.startedAt, connections: conns.size };\n154:      case \"events.subscribe\": {\n155:        conn.unsub?.();\n156:        if (conn.timer) clearTimeout(conn.timer);\n157:        conn.timer = undefined;\n158:        conn.queue.length = 0;\n159:        const fromSeq = Math.max(1, Number(params.fromSeq));\n160:        conn.unsub = store.subscribe(fromSeq, (e) => enqueue(conn, e));\n161:        return { lastSeq: store.lastSeq() };\n162:      }\n163:      case \"task.get\":\n164:        return scheduler.state(String(params.taskId));\n165:      case \"task.list\":\n166:        return scheduler.list();\n167:      case \"approval.pending\":\n168:        return broker.pending();\n169:      case \"policy.get\":\n170:        return { policy: gate.policy(), badge: gate.badge() };\n171:      case \"capabilities.get\":\n172:        return { isolationWarnings: allWarnings(store), tokenRef, protocolVersion: RPC_PROTOCOL_VERSION };\n173:      case \"task.submit\":\n174:        return { taskId: scheduler.submit({ title: String(params.title), kind: params.kind as never, ...(typeof params.phaseId === \"string\" && { phaseId: params.phaseId }) }) };\n175:      case \"task.cancel\":\n176:        return { status: scheduler.transition(String(params.taskId), \"cancel\", { kind: \"user\" }) };\n177:      case \"task.unblock\":\n178:        return { status: scheduler.transition(String(params.taskId), \"unblocked\", { kind: \"user\" }) };\n179:      case \"task.abandon\":\n180:        return { status: scheduler.transition(String(params.taskId), \"user_abandon\", { kind: \"user\" }) };\n181:      case \"approval.decide\":\n182:        coordinator.decide(String(params.requestId), params.decision as Decision, \"user\", params.scope as never);\n183:        return {};\n184:      case \"policy.set\": {\n185:        const errors = validatePolicy(params.policy);\n186:        if (errors.length) throw new RpcFailure(RPC_ERRORS.INVALID_PARAMS, \"invalid policy\", { errors });\n187:        try {\n188:          return gate.setPolicy(params.policy as ProjectPolicy, (params.combos as Combos | undefined) ?? {}, \"user\");\n189:        } catch (e) {\n190:          if (e instanceof Error && /combo/.test(e.message)) throw new RpcFailure(RPC_ERRORS.INVALID_PARAMS, e.message);\n191:          throw e;\n192:        }\n193:      }\n194:      case \"user_input.answer\": {\n195:        const requestId = String(params.requestId);\n196:        const kind = pendingInputs.get(requestId);\n197:        if (kind === undefined) throw new RpcFailure(RPC_ERRORS.NOT_PENDING, `no pending user_input request ${requestId}`);\n198:        const answers = params.answers as Record<string, string>;\n199:        if (kind === \"isolation_confirm\") {\n200:          if (answers.answer !== \"confirmed\" && answers.answer !== \"rejected\") throw new RpcFailure(RPC_ERRORS.INVALID_PARAMS, \"isolation_confirm answer must be 'confirmed' or 'rejected'\");\n201:          return gate.confirm(requestId, answers.answer === \"confirmed\");\n202:        }\n203:        store.append({ type: \"UserInputAnswered\", correlationId: requestId, payload: { request_id: requestId, kind, answers } });\n204:        return { status: \"answered\" };\n205:      }\n206:      case \"daemon.shutdown\":\n207:        setImmediate(() => {\n208:          void close().then(() => opts.onShutdown?.());\n209:        });\n210:        return { ok: true };\n211:    }\n212:  }\n213:\n214:  function handleRpc(conn: Conn, raw: unknown): void {\n215:    type Incoming = { jsonrpc?: unknown; id?: unknown; method?: unknown; params?: unknown };\n216:    let msg: Incoming | null = null;\n217:    try {\n218:      msg = JSON.parse(String(raw)) as Incoming;\n219:    } catch {\n220:      /* fallthrough */\n221:    }\n222:    const id: RpcId | null = msg && (typeof msg.id === \"number\" || typeof msg.id === \"string\") ? msg.id : null;\n223:    const reply = (body: RpcResponse) => send(conn.ws, body);\n224:    if (!msg || msg.jsonrpc !== \"2.0\" || id === null || typeof msg.method !== \"string\") {\n225:      return reply({ jsonrpc: \"2.0\", id, error: { code: RPC_INVALID_REQUEST, message: \"invalid request\" } });\n226:    }\n227:    const method = msg.method;\n228:    if (!isRpcMethod(method)) return reply({ jsonrpc: \"2.0\", id, error: { code: RPC_ERRORS.METHOD_NOT_FOUND, message: `method not found: ${method}` } });\n229:    if (methodClass(method) === \"control\" && conn.role !== \"main\") return reply({ jsonrpc: \"2.0\", id, error: { code: RPC_ERRORS.UNAUTHORIZED, message: `control method ${method} requires role main (got ${conn.role})` } });\n230:    const