ason: \"AGENT_SELF\", invocation_mode: \"implicit\", ...(ctx.expectedLead !== undefined && { expected_lead: ctx.expectedLead }), tool_use_id: b.id },\npackages/core/src/skills/observer.ts:57:      });\npackages/core/src/skills/observer.ts:58:    } else if (type === \"user\" && b.type === \"tool_result\" && typeof b.tool_use_id === \"string\") {\npackages/core/src/skills/observer.ts:59:      const pending = pendingByRun.get(ctx.runId);\npackages/core/src/skills/observer.ts:60:      const skillId = pending?.get(b.tool_use_id);\npackages/core/src/skills/observer.ts:61:      if (!pending || skillId === undefined) continue;\npackages/core/src/skills/observer.ts:62:      pending.delete(b.tool_use_id);\npackages/core/src/skills/observer.ts:63:      if (pending.size === 0) pendingByRun.delete(ctx.runId);\npackages/core/src/skills/observer.ts:64:      if (b.is_error === true) continue;\npackages/core/src/skills/observer.ts:65:      out.push({ ...base, type: \"SkillLoadObserved\", correlationId: b.tool_use_id, payload: { skill_id: skillId, tool_use_id: b.tool_use_id, observed_via: \"claude_skill_tool_result\" } });\npackages/core/src/skills/observer.ts:66:    }\npackages/core/src/skills/observer.ts:67:  }\npackages/core/src/skills/observer.ts:68:  return out;\npackages/core/src/skills/observer.ts:69:}\npackages/core/src/skills/observer.ts:70:\npackages/core/src/skills/observer.ts:71:export type CodexInputItem = { type?: unknown; name?: unknown; path?: unknown; text?: unknown };\npackages/core/src/skills/observer.ts:72:\npackages/core/src/skills/observer.ts:73:/** `turn/start` 입력 항목과 그 응답(JSON-RPC result 또는 error). 오류 응답이면 어떤 이벤트도 내지 않는다. */\npackages/core/src/skills/observer.ts:74:export function observeCodexSkillInjection(input: CodexInputItem[], response: { error?: unknown; [k: string]: unknown } | null | undefined, ctx: Pick<ObserveContext, \"taskId\" | \"runId\" | \"discovered\">): NewEvent[] {\npackages/core/src/skills/observer.ts:75:  if (!response || typeof response !=