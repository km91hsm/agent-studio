{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n '\"'^'\"' apps/daemon/src/main.ts\"","aggregated_output":"1:/**\n2: * Orchestrator 데몬 엔트리 (P01 T2). detached Node 프로세스로 실행된다(launcher 가 spawn).\n3: *   node --import tsx apps/daemon/src/main.ts --dir <stateDir> [--token-store file|keyring] [--port N] [--self-test]\n4: * 구성: SQLite 저널(`<stateDir>/journal.sqlite`) + Scheduler + DefaultPolicyBroker(DEFAULT_POLICY) + ApprovalCoordinator(tick 5초)\n5: *     + PolicyGate(기본 프로젝트 `default`) + 격리 경고 등록(최초 1회) + RPC 서버 + 락 파일.\n6: * `--self-test`: 기동 → 락 기록 → 자기 접속(daemon.status) → 종료, exit 0 (CI 실행 계약).\n7: */\n8:import { mkdirSync } from \"node:fs\";\n9:import { join, resolve } from \"node:path\";\n10:import { fileURLToPath } from \"node:url\";\n11:import { ApprovalCoordinator, DaemonClient, DefaultPolicyBroker, allWarnings, ensureToken, loadBundledWarnings, openSqliteStore, PolicyGate, registerIsolationWarnings, Scheduler, selectTokenStore, startRpcServer, type RpcServer } from \"@agent-studio/core\";\n12:import { DEFAULT_POLICY } from \"@agent-studio/protocol\";\n13:\n14:export const DEFAULT_PROJECT_ID = \"default\";\n15:\n16:export interface DaemonOptions {\n17:  stateDir: string;\n18:  tokenStore: \"file\" | \"keyring\";\n19:  port?: number;\n20:  tickMs?: number;\n21:}\n22:\n23:export interface RunningDaemon {\n24:  server: RpcServer;\n25:  token: string;\n26:  tokenRef: string;\n27:  shutdown(): Promise<void>;\n28:}\n29:\n30:export async function startDaemon(o: DaemonOptions): Promise<RunningDaemon> {\n31:  mkdirSync(o.stateDir, { recursive: true });\n32:  const tokenStore = selectTokenStore({ AGENT_STUDIO_TOKEN_STORE: o.tokenStore }, { dir: o.stateDir });\n33:  const token = ensureToken(tokenStore);\n34:  const store = openSqliteStore(join(o.stateDir, \"journal.sqlite\"));\n35:  const scheduler = new Scheduler(store);\n36:  const broker = new DefaultPolicyBroker(store, DEFAULT_POLICY);\n37:  const coordinator = new ApprovalCoordinator(scheduler, broker, store);\n38:  if (!store.read(1).some((e) => e.type === \"ProjectRegistered\" && e.projectId === DEFAULT_PROJECT_ID)) {\n39:    store.append({ type: \"ProjectRegistered\", projectId: DEFAULT_PROJECT_ID, payload: { id: DEFAULT_PROJECT_ID, path: o.stateDir, name: DEFAULT_PROJECT_ID } });\n40:  }\n41:  if (allWarnings(store).length === 0) registerIsolationWarnings(store, loadBundledWarnings());\n42:  const gate = new PolicyGate(store, DEFAULT_PROJECT_ID);\n43:  gate.recover();\n44:  let shuttingDown: Promise<void> | undefined;\n45:  const shutdown = (): Promise<void> => {\n46:    if (shuttingDown) return shuttingDown;\n47:    shuttingDown = (async () => {\n48:      clearInterval(tick);\n49:      await server.close();\n50:      store.close();\n51:    })();\n52:    return shuttingDown;\n53:  };\n54:  const server = await startRpcServer({ store, scheduler, broker, coordinator, gate, token, stateDir: o.stateDir, tokenRef: tokenStore.ref(), ...(o.port !== undefined && { port: o.port }), onShutdown: () => void shutdown() });\n55:  const tick = setInterval(() => {\n56:    try {\n57:      scheduler.expireLeases();\n58:      coordinator.tick();\n59:    } catch {\n60:      /* 다음 tick 에서 재시도 */\n61:    }\n62:  }, o.tickMs ?? 5_000);\n63:  return { server, token, tokenRef: tokenStore.ref(), shutdown };\n64:}\n65:\n66:function parseArgs(argv: string[]): DaemonOptions & { selfTest: boolean } {\n67:  const get = (flag: string): string | undefined => {\n68:    const i = argv.indexOf(flag);\n69:    return i >= 0 ? argv[i + 1] : undefined;\n70:  };\n71:  const stateDir = get(\"--dir\");\n72:  if (!stateDir) throw new Error(\"--dir <stateDir> required\");\n73:  const ts = get(\"--token-store\") ?? process.env.AGENT_STUDIO_TOKEN_STORE ?? \"keyring\";\n74:  if (ts !== \"file\" && ts !== \"keyring\") throw new Error(`--token-store must be file|keyring (got ${ts})`);\n75:  const port = get(\"--port\");\n76:  return { stateDir: resolve(stateDir), tokenStore: ts, ...(port !== undefined && { port: Number(port) }), selfTest: argv.includes(\"--self-test\") };\n77:}\n78:\n79:async function main(): Promise<void> {\n80:  const args = parseArgs(process.argv.slice(2));\n81:  const d = await startDaemon(args);\n82:  if (args.selfTest) {\n83:    const client = await DaemonClient.connect({ stateDir: args.stateDir, token: d.token, onEvent: () => {} });\n84:    const status = await client.call<Record<string, unknown>>(\"daemon.status\");\n85:    client.close();\n86:    await d.shutdown();\n87:    process.stdout.write(`${JSON.stringify({ selfTest: \"ok\", status })}\\n`);\n88:    process.exit(0);\n89:  }\n90:  process.stdout.write(`${JSON.stringify({ daemon: \"listening\", port: d.server.port, pid: process.pid, tokenRef: d.tokenRef })}\\n`);\n91:  const stop = () => {\n92:    void d.shutdown().then(() => process.exit(0));\n93:  };\n94:  process.on(\"SIGINT\", stop);\n95:  process.on(\"SIGTERM\", stop);\n96:  // daemon.shutdown RPC → onShutdown → shutdown() 완료 후 종료\n97:  const origOnShutdown = d.shutdown;\n98:  void origOnShutdown;\n99:  const poll = setInterval(() => {\n100:    /* server.close() 가 끝나면 이벤트 루프에 남는 핸들이 없어 자연 종료된다 */\n101:  }, 60_000);\n102:  poll.unref();\n103:}\n104:\n105:if (process.argv[1] && fileURLToPath(import.meta.url) === resolve(process.argv[1])) {\n106:  main().catch((e: unknown) => {\n107:    process.stderr.write(`${e instanceof Error ? (e.stack ?? e.message) : String(e)}\\n`);\n108:    process.exit(1);\n109:  });\n110:}\n","exit_code":0,"status":"completed"}}
