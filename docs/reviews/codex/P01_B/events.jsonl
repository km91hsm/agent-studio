ayload.policy.length > 0,\n134:      reviewer_distinct: (c) => typeof c.payload.reviewer_agent === \"string\" && c.task.implementerAgent !== undefined && c.payload.reviewer_agent !== c.task.implementerAgent,\n135:      evidence_present: (c) => Array.isArray(c.payload.evidenceIds) && c.payload.evidenceIds.length > 0,\n136:      iteration_lt_max: (c) => c.task.iteration < this.maxIterations,\n137:      iteration_ge_max: (c) => c.task.iteration >= this.maxIterations,\n138:      user_actor: (c) => c.auth.kind === \"user\",\n139:      approval_decided: (c) => {\n140:        if (c.auth.kind !== \"daemon\") return false;\n141:        const rec = c.approval(c.auth.requestId);\n142:        if (!rec || rec.taskId !== c.task.id || c.task.pendingRequestId !== c.auth.requestId) return false;\n143:        if (c.event === \"approved\") return rec.outcome === \"accept\";\n144:        if (c.event === \"denied_terminal\") return rec.outcome === \"decline\" || rec.outcome === \"cancel\";\n145:        if (c.event === \"approval_expired\") return rec.outcome === \"expired\";\n146:        return false;\n147:      },\n148:    };\n149:    const used = new Set(this.table.transitions.flatMap((t) => t.preconditions));\n150:    const missing = [...used].filter((id) => !(id in this.checkers));\n151:    if (missing.length) throw new PreconditionUnenforced(missing);\n152:    const unknownIds = (PRECONDITION_IDS as readonly string[]).filter((id) => !(id in this.checkers));\n153:    if (unknownIds.length) throw new PreconditionUnenforced(unknownIds);\n154:    store.subscribe(0, (e) => this.applyEvent(e));\n155:  }\n156:\n157:  // ---------- 저널 → 뷰 ----------\n158:  private applyEvent(e: JournalEvent): void {\n159:    if (e.type === \"LeaseAcquired\" && typeof e.payload.token === \"number\") this.tokenCounter = Math.max(this.tokenCounter, e.payload.token);\n160:    if (e.type === \"ApprovalRequested\" && typeof e.payload.request_id === \"string\") {\n161:      this.approvals.set(e.payload.request_id, { ...(this.approvals.get(e.payload.request_id) ?? {}), taskId: e.taskId });\n162:    } else if ((e.type === \"ApprovalDecided\" || e.type === \"ApprovalExpired\") && typeof e.payload.request_id === \"string\") {\n163:      // 리뷰A#2: 결정·만료는 ApprovalRequested 와 같은 Task 로 기록된 것만 결과로 인정한다(다른 Task 로 기록된 동일 request_id 는 무시)\n164:      const rec = this.approvals.get(e.payload.request_id);\n165:      if (rec && rec.taskId === e.taskId) rec.outcome = e.type === \"ApprovalExpired\" ? \"expired\" : (e.payload.decision as ApprovalRecord[\"outcome\"]);\n166:    }\n167:    if (!e.taskId) return;\n168:    let t = this.tasks.get(e.taskId);\n169:    if (e.type === \"TaskCreated\") {\n170:      t = { id: e.taskId, status: \"QUEUED\", paused: false, iteration: 0, seen: new Set() };\n171:      this.tasks.set(e.taskId, t);\n172:      return;\n173:    }\n174:    if (!t) return;\n175:    t.seen.add(e.type);\n176:    switch (e.type) {\n177:      case \"TaskTransition\": {\n178:        const to = e.payload.to as TaskState;\n179:        const from = e.payload.from as TaskState | null;\n180:        t.status = to;\n181:        if (typeof e.payload.iteration === \"number\") t.iteration = e.payload.iteration;\n182:        if (typeof e.payload.implementer_agent === \"string\") t.implementerAgent = e.payload.implementer_agent;\n183:        if (to === \"WAITING_APPROVAL\") {\n184:          t.resumeFrom = from ?? undefined;\n185:          t.pendingRequestId = typeof e.payload.request_id === \"string\" ? e.payload.request_id : undefined;\n186:        } else if (from === \"WAITING_APPROVAL\") {\n187:          t.resumeFrom = undefined;\n188:          t.pendingRequestId = undefined;\n189:        }\n190:        break;\n191:      }\n192:      case \"LeaseAcquired\":\n193:        t.lease = { runId: String(e.payload.run_id ?? e.agentRunId), fencingToken: Number(e.payload.token), expiresAt: String(e.payload.expires_at) };\n194:        break;\n195:      case \"LeaseRenewed\":\n196:        if (t.lease && t.lease.fencingToken === e.payload.token && typeof e.payload.expires_at === \"string\") t.lease.expiresAt = e.payload.expires_at;\n197:        break;\n198:      case \"LeaseExpired\":\n199:        if (t.lease && t.lease.fencingToken === e.payload.token) t.lease = undefined;\n200:        break;\n201:      case \"Paused\":\n202:        t.paused = true;\n203:        break;\n204:      case \"ResumeRequested\":\n205:        t.paused = false;\n206:        break;\n207:    }\n208:  }\n209:\n210:  // ---------- 공개 API ----------\n211:  submit(t: { id?: string; phaseId?: string; title: string; kind: TaskKind }): string {\n212:    if (!(TASK_KINDS as readonly string[]).includes(t.kind)) throw new SchedulerError(\"invalid_kind\", `invalid task kind: ${t.kind}`);\n213:    const id = t.id ?? ulid(this.now());\n214:    if (this.tasks.has(id)) throw new SchedulerError(\"duplicate_task\", `task exists: ${id}`);\n215:    this.store.append({ type: \"TaskCreated\", taskId: id, phaseId: t.phaseId, payload: { title: t.title, kind: t.kind, ...(t.phaseId && { phase_id: t.phaseId }) } });\n216:    this.store.append({ type: \"TaskTransition\", taskId: id, payload: { from: null, to: \"QUEUED\", reason: \"submit\" } });\n217:    return id;\n218:  }\n219:\n220:  state(taskId: string): TaskView {\n221:    const t = this.get(taskId);\n222:    const { seen: _s, ...view } = t;\n223:    return { ...view, lease: t.lease ? { ...t.lease } : undefined };\n224:  }\n225:\n226:  acquireLease(taskId: string, runId: string): { fencingToken: number; expiresAt: string } {\n227:    const t = this.get(taskId);\n228:    if (this.table.terminal.includes(t.status)) throw new InvalidTransition(t.status, \"acquireLease\");\n229:    if (t.lease && !this.isExpired(t.lease.expiresAt)) throw new LeaseHeld(taskId);\n230:    if (this.maxSlots !== undefined && this.liveLeaseCount(taskId) >= this.maxSlots) throw new SlotUnavailable(this.maxSlots);\n231:    const fencingToken = ++this.tokenCounter;\n232:    const expiresAt = new Date(this.now() + this.leaseTtlMs).toISOString();\n233:    this.store.append({ type: \"LeaseAcquired\", taskId, agentRunId: runId, fencingToken, payload: { run_id: runId, token: fencingToken, ttl: this.leaseTtlMs, expires_at: expiresAt } });\n234:    return { fencingToken, expiresAt };\n235:  }\n236:\n237:  heartbeat(taskId: string, fencingToken: number): void {\n238:    const t = this.get(taskId);\n239:    if (!t.lease || t.lease.fencingToken !== fencingToken || this.isExpired(t.lease.expiresAt)) {\n240:      this.rejectStale(t, fencingToken);\n241:    }\n242:    if (t.status === \"WAITING_APPROVAL\") throw new LeaseSuspended(taskId); // 리뷰A#5: 승인 대기 중 lease 는 만료되게 두고 복귀 후 재획득\n243:    const expiresAt = new Date(this.now() + this.leaseTtlMs).toISOString();\n244:    this.store.append({\n245:      type: \"LeaseRenewed\",\n246:      taskId,\n247:      agentRunId: t.lease!.runId,\n248:      fencingToken,\n249:      payload: { run_id: t.lease!.runId, token: fencingToken, heartbeat_at: new Date(this.now()).toISOString(), expires_at: expiresAt },\n250:    });\n251:  }\n252:\n253:  /** TTL 이 지난 lease 를 LeaseExpired 로 회수한다. 상태는 바꾸지 않는다(WAITING_APPROVAL 유지 — 복귀 후 재획득). */\n254:  expireLeases(): string[] {\n255:    const out: string[] = [];\n256:    for (const t of this.tasks.values()) {\n257:      if (t.lease && this.isExpired(t.lease.expiresAt)) {\n258:        this.store.append({ type: \"LeaseExpired\", taskId: t.id, agentRunId: t.lease.runId, payload: { run_id: t.lease.runId, token: t.lease.fencingToken, reason: \"ttl\" } });\n259:        out.push(t.id);\n260:      }\n261:    }\n262:    return out;\n263:  }\n264:\n265:  /** 모든 Task 의 현재 뷰(RPC task.list). */\n266:  list(): TaskView[] {\n267:    return [...this.tasks.keys()].map((id) => this.state(id));\n268:  }\n269:\n270:  /**\n271:   * transition() 과 같은 규칙(전이표·auth 종류·fencing·precondition)으로 판정만 하고 아무것도 기록하지 않는다(리뷰A#3).\n272:   * 호출자가 저널에 선행 기록(승인 요청 등)을 남기기 전에 전이 가능성을 확인하는 용도. 실패는 transition() 과 같은 오류.\n273:   */\n274:  check(taskId: string, event: TaskEvent, auth: TransitionAuth, payload: Record<string, unknown> = {}): TaskState {\n275:    return this.resolve(taskId, event, auth, payload, false).to;\n276:  }\n277:\n278:  transition(taskId: string, event: TaskEvent, auth: TransitionAuth, payload: Record<string, unknown> = {}): TaskState {\n279:    const { t, to } = this.resolve(taskId, event, auth, payload, true);\n280:\n281:    const body: Record<string, unknown> = { from: t.status, to, reason: event };\n282:    for (const k of USER_PAYLOAD_KEYS) if (k in payload && k !== \"evidenceIds\") body[k] = payload[k];\n283:    if (event === \"approval_needed\" || event === \"git_conflict\" || event === \"recovery_review\" || event === \"compare_blocked\") {\n284:      if (typeof payload.requestId === \"string\") body.request_id = payload.requestId;\n285:    }\n286:    if (auth.kind === \"daemon\") body.request_id = auth.requestId;\n287:    if (to === \"REWORK\" && (event === \"review_failed\" || event === \"evidence_missing\")) body.iteration = t.iteration + 1;\n288:    if (event === \"evidence_ok\") body.evidence_ids = payload.evidenceIds;\n289:\n290:    this.store.append({\n291:      type: \"TaskTransition\",\n292:      taskId,\n293:      ...(auth.kind === \"lease\" && { fencingToken: auth.token, agentRunId: t.lease?.runId }),\n294:      ...(auth.kind === \"daemon\" && { correlationId: auth.requestId }),\n295:      payload: body,\n296:    });\n297:    // BLOCKED·종결·QUEUED 로 가면 현재 run 의 lease 는 재사용 금지 → 해제\n298:    if (t.lease && (to === \"BLOCKED\" || to === \"QUEUED\" || this.table.terminal.includes(to))) {\n299:      this.store.append({ type: \"LeaseExpired\", taskId, agentRunId: t.lease.runId, payload: { run_id: t.lease.runId, token: t.lease.fencingToken, reason: \"released\" } });\n300:    }\n301:    return to;\n302:  }\n303:\n304:  // ---------- 내부 ----------\n305:  /** 전이 판정 공통부. record=true 면 stale 시도를 StaleWriterRejected 로 기록한다(check 는 기록하지 않음). */\n306:  private resolve(taskId: string, event: TaskEvent, auth: TransitionAuth, payload: Record<string, unknown>, record: boolean): { t: TaskRecord; to: TaskState } {\n307:    const t = this.get(taskId);\n308:    const edge = nextState(this.table, t.status, event);\n309:    if (!edge) throw new InvalidTransition(t.status, event);\n310:    const expectedKind = USER_EVENTS.has(event) ? \"user\" : DAEMON_EVENTS.has(event) ? \"daemon\" : LEASE_EVENTS.has(event) ? \"lease\" : null;\n311:    if (expectedKind === null || auth.kind !== expectedKind) throw new AuthKindMismatch(event, auth.kind);\n312:    if (auth.kind === \"lease\" && (!t.lease || t.lease.fencingToken !== auth.token || this.isExpired(t.lease.expiresAt))) {\n313:      if (record) this.rejectStale(t, auth.token);\n314:      throw new StaleWriterError(auth.token, t.lease && !this.isExpired(t.lease.expiresAt) ? t.lease.fencingToken : null);\n315:    }\n316:    const ctx: PreconditionCtx = {\n317:      task: this.state(taskId),\n318:      event,\n319:      auth,\n320:      payload,\n321:      has: (type) => t.seen.has(type),\n322:      approval: (id) => this.approvals.get(id),\n323:      liveLeases: () => this.liveLeaseCount(taskId),\n324:    };\n325:    for (const id of edge.preconditions) {\n326:      if (!this.checkers[id]!(ctx)) throw new PreconditionFailed(id);\n327:    }\n328:    let to: TaskState;\n329:    if (edge.to === \"$resume\") {\n330:      if (!t.resumeFrom) throw new PreconditionFailed(\"approval_decided\");\n331:      to = t.resumeFrom;\n332:    } else to = edge.to;\n333:    return { t, to };\n334:  }\n335:  /** except 를 제외한 Task 들의 살아 있는 lease 수 */\n336:  private liveLeaseCount(except?: string): number {\n337:    return [...this.tasks.values()].filter((x) => x.id !== except && x.lease && !this.isExpired(x.lease.expiresAt)).length;\n338:  }\n339:  private get(taskId: string): TaskRecord {\n340:    const t = this.tasks.get(taskId);\n341:    if (!t) throw new UnknownTask(taskId);\n342:    return t;\n343:  }\n344:  private isExpired(expiresAt: string): boolean {\n345:    return Date.parse(expiresAt) <= this.now();\n346:  }\n347:  private rejectStale(t: TaskRecord, token: number): never {\n348:    const current = t.lease && !this.isExpired(t.lease.expiresAt) ? t.lease.fencingToken : null;\n349:    this.store.append({ type: \"StaleWriterRejected\", taskId: t.id, fencingToken: token, payload: { task_id: t.id, token, current } });\n350:    throw new StaleWriterError(token, current);\n351:  }\n352:}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n '\"'^'\"' packages/core/src/isolation.ts\"","aggregated_output":"1:/**\n2: * 격리 경고 집행 (P01 T11, AC-P01-6). S4 불합격 조합을 `WorkspaceSettingsChanged{capabilities:{isolation_warning}}` 로 등록하고,\n3: * 그 조합에서 자동 모드(U8 옵트인)를 켜려면 1회 확인 대화(`UserInputRequested{kind:'isolation_confirm'}`)를 거친다.\n4: * 정책 변경은 `ProjectPolicyChanged{before,after}` 로만 일어나며, 확인 없이 자동 모드로 바뀐 ProjectPolicyChanged 는 생성되지 않는다.\n5: * 리뷰A#4: 실행 조합은 공급자별(`combos.claude`/`combos.codex`)로 받고, 자동 모드를 켜는 공급자마다 같은 공급자의 조합이 있어야 한다.\n6: * 리뷰A#9: `UserInputAnswered{confirmed}` 뒤 `ProjectPolicyChanged` 전에 중단되면 재기동 시 `recover()`(또는 confirm 재호출)로 완성한다.\n7: */\n8:import { readFileSync } from \"node:fs\";\n9:import type { PermissionMode, ProjectPolicy } from \"@agent-studio/protocol\";\n10:import { DEFAULT_POLICY, ulid } from \"@agent-studio/protocol\";\n11:import type { EventStore, JournalEvent } from \"./journal/event-store.js\";\n12:\n13:export interface IsolationWarning {\n14:  provider: string;\n15:  os: string;\n16:  sandbox: string;\n17:  variant: string;\n18:  variantApplied: \"verified\" | \"unverified\" | string;\n19:  area: string;\n20:  bypassedPolicies: string[];\n21:}\n22:export type Combo = Pick<IsolationWarning, \"provider\" | \"os\" | \"sandbox\" | \"variant\">;\n23:export type Provider = \"claude\" | \"codex\";\n24:/** 자동 모드를 켜는 공급자별 실행 조합 */\n25:export type Combos = Partial<Record<Provider, Combo | string>>;\n26:\n27:export const comboKey = (c: Combo | string): string => (typeof c === \"string\" ? c : `${c.provider}/${c.os}/${c.sandbox}/${c.variant}`);\n28:const COMBO_SEP = \";\";\n29:const splitCombos = (joined: string | undefined): string[] => (joined ?? \"\").split(COMBO_SEP).filter(Boolean);\n30:\n31:/** 번들 픽스처(`packages/core/isolation-warnings.json`, S4 산출물 복사본). */\n32:export function loadBundledWarnings(): IsolationWarning[] {\n33:  return (JSON.parse(readFileSync(new URL(\"../isolation-warnings.json\", import.meta.url), \"utf8\")) as { warnings: IsolationWarning[] }).warnings;\n34:}\n35:\n36:export function registerIsolationWarnings(store: EventStore, warnings: IsolationWarning[]): void {\n37:  store.append({ type: \"WorkspaceSettingsChanged\", payload: { capabilities: { isolation_warning: warnings } } });\n38:}\n39:\n40:/** 저널의 마지막 `isolation_warning` 등록본. */\n41:export function allWarnings(store: EventStore): IsolationWarning[] {\n42:  let latest: IsolationWarning[] = [];\n43:  for (const e of store.read(1)) {\n44:    if (e.type !== \"WorkspaceSettingsChanged\") continue;\n45:    const caps = e.payload.capabilities as { isolation_warning?: IsolationWarning[] } | undefined;\n46:    if (caps?.isolation_warning) latest = caps.isolation_warning;\n47:  }\n48:  return latest;\n49:}\n50:\n51:/** 조합(또는 `;` 로 이어진 여러 조합)에 해당하는 경고. */\n52:export function warningsFor(store: EventStore, combo: Combo | string): IsolationWarning[] {\n53:  const keys = typeof combo === \"string\" ? splitCombos(combo) : [comboKey(combo)];\n54:  const all = allWarnings(store);\n55:  return keys.flatMap((key) => all.filter((w) => comboKey(w) === key));\n56:}\n57:\n58:const AUTO_CLAUDE = new Set<PermissionMode[\"claude\"]>([\"acceptEdits\", \"auto\", \"bypassPermissions\", \"dontAsk\"]);\n59:/** 자동 모드(U8 옵트인)가 켜지는 공급자 목록 */\n60:export function autoProviders(pm: PermissionMode): Provider[] {\n61:  const out: Provider[] = [];\n62:  if (AUTO_CLAUDE.has(pm.claude)) out.push(\"claude\");\n63:  if (pm.codex.approvalPolicy === \"never\") out.push(\"codex\");\n64:  return out;\n65:}\n66:export const isAutoMode = (pm: PermissionMode): boolean => autoProviders(pm).length > 0;\n67:\n68:type Pending = { requestId: string; combo: string; next: ProjectPolicy };\n69:export type SetPolicyResult = { status: \"applied\" } | { status: \"confirmation_required\"; requestId: string; warnings: IsolationWarning[] };\n70:\n71:export class PolicyGate {\n72:  private current: ProjectPolicy = DEFAULT_POLICY;\n73:  /** 마지막 정책 변경이 적용된 실행 조합(배지 표시용) */\n74:  private lastCombo: string | undefined;\n75:  private readonly pendingMap = new Map<string, Pending>();\n76:  /** 확인 답변은 기록됐지만 ProjectPolicyChanged 가 아직 없는 요청(리뷰A#9) */\n77:  private readonly answered = new Map<string, Pending>();\n78:\n79:  constructor(\n80:    private readonly store: EventStore,\n81:    private readonly projectId: string,\n82:    private readonly now: () => number = Date.now,\n83:  ) {\n84:    store.subscribe(0, (e) => this.applyEvent(e));\n85:  }\n86:\n87:  private applyEvent(e: JournalEvent): void {\n88:    if (e.projectId !== this.projectId) return;\n89:    if (e.type === \"ProjectPolicyChanged\" && e.payload.after) {\n90:      this.current = e.payload.after as ProjectPolicy;\n91:      if (typeof e.payload.combo === \"string\" && e.payload.combo) this.lastCombo = e.payload.combo;\n92:      if (typeof e.payload.confirmed_by_request === \"string\") this.answered.delete(e.payload.confirmed_by_request);\n93:    } else if (e.type === \"UserInputRequested\" && e.payload.kind === \"isolation_confirm\" && typeof e.payload.request_id === \"string\") {\n94:      const next = (e.payload.next_policy as ProjectPolicy | undefined) ?? { ...this.current, permissionMode: e.payload.next_permission_mode as PermissionMode };\n95:      this.pendingMap.set(e.payload.request_id, { requestId: e.payload.request_id, combo: String(e.payload.combo), next });\n96:    } else if (e.type === \"UserInputAnswered\" && typeof e.payload.request_id === \"string\") {\n97:      const p = this.pendingMap.get(e.payload.request_id);\n98:      this.pendingMap.delete(e.payload.request_id);\n99:      if (p && e.payload.answer === \"confirmed\") this.answered.set(p.requestId, p);\n100:    }\n101:  }\n102:\n103:  policy(): ProjectPolicy {\n104:    return this.current;\n105:  }\n106:\n107:  setPermissionMode(next: PermissionMode, combos: Combos, actor: \"user\"): SetPolicyResult {\n108:    return this.setPolicy({ ...this.current, permissionMode: next }, combos, actor);\n109:  }\n110:\n111:  /**\n112:   * 정책 전체를 바꾼다. 자동 모드를 켜는 공급자마다 `combos[provider]` 가 있어야 하고 그 조합의 provider 가 일치해야 한다(리뷰A#4).\n113:   * 경고가 있는 조합이 아직 확인되지 않았으면 확인 요청만 기록한다. `autoModeConfirmed` 는 호출자 입력을 무시하고 저널의 현재 값을 유지한다.\n114:   */\n115:  setPolicy(next: ProjectPolicy, combos: Combos, actor: \"user\"): SetPolicyResult {\n116:    const keys: string[] = [];\n117:    for (const provider of autoProviders(next.permissionMode)) {\n118:      const c = combos[provider];\n119:      if (!c) throw new Error(`combo required for provider ${provider}: auto mode requested without its execution combo`);\n120:      const key = comboKey(c);\n121:      if (!key.startsWith(`${provider}/`)) throw new Error(`combo provider mismatch: expected ${provider}, got ${key}`);\n122:      keys.push(key);\n123:    }\n124:    keys.sort();\n125:    const joined = keys.join(COMBO_SEP);\n126:    const warnings = keys.flatMap((k) => warningsFor(this.store, k));\n127:    const confirmed = new Set(splitCombos(this.current.autoModeConfirmed?.combo));\n128:    const needsConfirm = warnings.length > 0 && !keys.every((k) => confirmed.has(k));\n129:    const sanitized: ProjectPolicy = { ...next };\n130:    delete (sanitized as Partial<ProjectPolicy>).autoModeConfirmed;\n131:    if (this.current.autoModeConfirmed) sanitized.autoModeConfirmed = this.current.autoModeConfirmed;\n132:    if (needsConfirm) {\n133:      const requestId = ulid(this.now());\n134:      this.store.append({\n135:        type: \"UserInputRequested\",\n136:        projectId: this.projectId,\n137:        correlationId: requestId,\n138:        payload: { request_id: requestId, kind: \"isolation_confirm\", combo: joined, warnings, next_permission_mode: next.permissionMode, next_policy: sanitized, requested_by: actor },\n139:      });\n140:      return { status: \"confirmation_required\", requestId, warnings };\n141:    }\n142:    this.applyPolicy(sanitized, actor, joined);\n143:    return { status: \"applied\" };\n144:  }\n145:\n146:  confirm(requestId: string, confirmed: boolean): { status: \"applied\" | \"rejected\" } {\n147:    const p = this.pendingMap.get(requestId);\n148:    if (!p) {\n149:      const a = this.answered.get(requestId);\n150:      if (a && confirmed) {\n151:        this.applyConfirmed(a); // 답변은 이미 기록돼 있고 적용만 누락된 경우(리뷰A#9)\n152:        return { status: \"applied\" };\n153:      }\n154:      throw new Error(`isolation_confirm request not pending: ${requestId}`);\n155:    }\n156:    this.store.append({\n157:      type: \"UserInputAnswered\",\n158:      projectId: this.projectId,\n159:      correlationId: requestId,\n160:      payload: { request_id: requestId, kind: \"isolation_confirm\", answer: confirmed ? \"confirmed\" : \"rejected\" },\n161:    });\n162:    if (!confirmed) return { status: \"rejected\" };\n163:    this.applyConfirmed(p);\n164:    return { status: \"applied\" };\n165:  }\n166:\n167:  /** 재기동 시: 확인됐지만 적용되지 않은 요청을 완성한다. 적용한 requestId 목록을 돌려준다. */\n168:  recover(): string[] {\n169:    const ids = [...this.answered.keys()];\n170:    for (const id of ids) {\n171:      const a = this.answered.get(id);\n172:      if (a) this.applyConfirmed(a);\n173:    }\n174:    return ids;\n175:  }\n176:\n177:  /** 경고 배지: 자동 모드가 켜져 있으면 active + 적용된 조합과 그 조합의 경고 목록. */\n178:  badge(): { active: boolean; combo?: string; warnings: IsolationWarning[] } {\n179:    const active = isAutoMode(this.current.permissionMode);\n180:    const combo = this.lastCombo;\n181:    const warnings = combo ? warningsFor(this.store, combo) : [];\n182:    if (!active) return { active: false, warnings };\n183:    return { active: true, ...(combo !== undefined && { combo }), warnings };\n184:  }\n185:\n186:  private applyConfirmed(p: Pending): void {\n187:    const union = new Set([...splitCombos(this.current.autoModeConfirmed?.combo), ...splitCombos(p.combo)]);\n188:    const after: ProjectPolicy = { ...p.next, autoModeConfirmed: { combo: [.