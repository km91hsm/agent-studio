{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$i=0; Get-Content '\"'packages/core/src/approval-coordinator.ts' | ForEach-Object { \"'$i++; '\"'{0,4}: {1}' -f \"'$i,$_ }'","aggregated_output":"   1: /**\r\n   2:  * ApprovalCoordinator (P01 T5, ���� #3) ? Broker �� ��û/����/���Ḧ Scheduler �� DAEMON ���̷� �մ� **������** ���.\r\n   3:  * - request: ASK/ALWAYS_ASK �� `approval_needed`(lease) ����, AUTO/DENY �� ���� ����\r\n   4:  * - decide: accept �� `approved`, decline/cancel �� `denied_terminal`\r\n   5:  * - tick: ����� ��û���� `approval_expired`\r\n   6:  * RPC `approval.decide` �� ���� Ÿ�̸Ӵ� �� ��ü�� ȣ���Ѵ�(Scheduler �� daemon ���̸� ���� �θ��� ����).\r\n   7:  */\r\n   8: import type { Verdict } from \"@agent-studio/protocol\";\r\n   9: import type { ApprovalBroker, ApprovalRequest, Decision } from \"./approval-broker.js\";\r\n  10: import type { EventStore, JournalEvent } from \"./journal/event-store.js\";\r\n  11: import type { ApprovalScope } from \"@agent-studio/protocol\";\r\n  12: import { Scheduler, SchedulerError } from \"./scheduler.js\";\r\n  13: \r\n  14: export class ApprovalCoordinator {\r\n  15:   private readonly taskOf = new Map<string, string>();\r\n  16: \r\n  17:   constructor(\r\n  18:     private readonly scheduler: Scheduler,\r\n  19:     private readonly broker: ApprovalBroker,\r\n  20:     store: EventStore,\r\n  21:   ) {\r\n  22:     store.subscribe(0, (e: JournalEvent) => {\r\n  23:       if (e.type === \"ApprovalRequested\" && typeof e.payload.request_id === \"string\" && e.taskId) this.taskOf.set(e.payload.request_id, e.taskId);\r\n  24:     });\r\n  25:   }\r\n  26: \r\n  27:   /** run(lease ������)�� ������ �ʿ��� ������ ������ ��. */\r\n  28:   request(req: ApprovalRequest, fencingToken: number): { requestId: string; verdict: Verdict } {\r\n  29:     const verdict = this.broker.evaluate(req);\r\n  30:     const requestId = this.broker.request(req);\r\n  31:     if (verdict === \"ASK\" || verdict === \"ALWAYS_ASK\") {\r\n  32:       this.scheduler.transition(req.taskId, \"approval_needed\", { kind: \"lease\", token: fencingToken }, { requestId });\r\n  33:     }\r\n  34:     return { requestId, verdict };\r\n  35:   }\r\n  36: \r\n  37:   decide(requestId: string, decision: Decision, by: \"user\" | \"policy\", scope?: ApprovalScope): void {\r\n  38:     this.broker.decide(requestId, decision, by, scope);\r\n  39:     const taskId = this.taskOf.get(requestId);\r\n  40:     if (!taskId) return;\r\n  41:     this.scheduler.transition(taskId, decision === \"accept\" ? \"approved\" : \"denied_terminal\", { kind: \"daemon\", requestId });\r\n  42:   }\r\n  43: \r\n  44:   /** �ֱ� ȣ��: ���� ��û �� BLOCKED(approval_expired). �̹� �ٸ� ��η� ���� Task(��� ��)�� �ǳʶڴ�. */\r\n  45:   tick(): string[] {\r\n  46:     const expired = this.broker.expire();\r\n  47:     for (const requestId of expired) {\r\n  48:       const taskId = this.taskOf.get(requestId);\r\n  49:       if (!taskId) continue;\r\n  50:       try {\r\n  51:         this.scheduler.transition(taskId, \"approval_expired\", { kind: \"daemon\", requestId });\r\n  52:       } catch (err) {\r\n  53:         if (err instanceof SchedulerError && err.code === \"invalid_transition\") continue;\r\n  54:         throw err;\r\n  55:       }\r\n  56:     }\r\n  57:     return expired;\r\n  58:   }\r\n  59: }\r\n","exit_code":0,"status":"completed"}}
