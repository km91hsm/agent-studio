{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command 'Get-Content packages/core/src/journal/event-store.ts -Encoding utf8; Get-Content packages/core/src/journal/memory-store.ts -Encoding utf8'","aggregated_output":"/**\r\n * EventStore(= Journal ��� �������̽�, SYSTEM_ARCHITECTURE ��2). �����: �޸�(�׽�Ʈ)��SQLite(��).\r\n * ��� ���� ���(P01 ��ȹ ���� #10): `append` �� seq �� ������ JournalEvent �� �����ְ�(��2 `append��seq` �� ���� ����),\r\n * `projections()` �� SQLite ����� �����̴�.\r\n */\r\nimport type { JournalEvent, NewEvent } from \"@agent-studio/protocol\";\r\nimport { isEventType, ulid } from \"@agent-studio/protocol\";\r\n\r\nexport type { JournalEvent, NewEvent };\r\n\r\nexport interface EventStore {\r\n  /** �̺�Ʈ 1���� ���������� �߰��ϰ� ����� ��(seq ����)�� �����ش�. �𸣴� type������ȭ �Ұ� payload �� throw. */\r\n  append(e: NewEvent): JournalEvent;\r\n  /** seq �� [fromSeq, toSeq] �� ������������. */\r\n  read(fromSeq: number, toSeq?: number): JournalEvent[];\r\n  lastSeq(): number;\r\n  /** fromSeq ���� ���� �̺�Ʈ�� ���� cb �� ����� ��, ���� append �Ǵ� �̺�Ʈ�� �����Ѵ�. ��ȯ���� unsubscribe. */\r\n  subscribe(fromSeq: number, cb: (e: JournalEvent) => void): () => void;\r\n  close(): void;\r\n}\r\n\r\n/** append �� ���� ����������(�� ����Ͱ� ����). */\r\nexport function prepareEvent(e: NewEvent, seq: number, now: () => number = Date.now): JournalEvent {\r\n  if (!isEventType(e.type)) throw new Error(`unknown event type: ${e.type}`);\r\n  JSON.stringify(e.payload); // ��ȯ ���� �� ����ȭ �Ұ� �� throw\r\n  const ms = now();\r\n  return {\r\n    seq,\r\n    eventId: e.eventId ?? ulid(ms),\r\n    ts: e.ts ?? new Date(ms).toISOString(),\r\n    type: e.type,\r\n    ...(e.workspaceId !== undefined && { workspaceId: e.workspaceId }),\r\n    ...(e.projectId !== undefined && { projectId: e.projectId }),\r\n    ...(e.phaseId !== undefined && { phaseId: e.phaseId }),\r\n    ...(e.taskId !== undefined && { taskId: e.taskId }),\r\n    ...(e.agentRunId !== undefined && { agentRunId: e.agentRunId }),\r\n    ...(e.sessionRef !== undefined && { sessionRef: e.sessionRef }),\r\n    ...(e.correlationId !== undefined && { correlationId: e.correlationId }),\r\n    ...(e.causationSeq !== undefined && { causationSeq: e.causationSeq }),\r\n    ...(e.fencingToken !== undefined && { fencingToken: e.fencingToken }),\r\n    payload: e.payload,\r\n    redacted: e.redacted ?? 0,\r\n  };\r\n}\r\n\r\n/** ������ ���(��� �� �ǽð�) ? �� ����Ͱ� ����. */\r\nexport class Subscribers {\r\n  private readonly subs = new Set<(e: JournalEvent) => void>();\r\n  add(cb: (e: JournalEvent) => void): () => void {\r\n    this.subs.add(cb);\r\n    return () => this.subs.delete(cb);\r\n  }\r\n  emit(e: JournalEvent): void {\r\n    for (const cb of [...this.subs]) cb(e);\r\n  }\r\n}\r\n/** �޸� EventStore ? �׽�Ʈ ����(���� ����). */\r\nimport type { EventStore, JournalEvent, NewEvent } from \"./event-store.js\";\r\nimport { prepareEvent, Subscribers } from \"./event-store.js\";\r\n\r\nexport class MemoryEventStore implements EventStore {\r\n  private readonly events: JournalEvent[] = [];\r\n  private readonly subs = new Subscribers();\r\n  constructor(private readonly now: () => number = Date.now) {}\r\n\r\n  append(e: NewEvent): JournalEvent {\r\n    const stored = prepareEvent(e, this.events.length + 1, this.now);\r\n    // ���庻�� �ܺ� ���濡�� �ݸ��Ѵ�\r\n    const frozen: JournalEvent = { ...stored, payload: JSON.parse(JSON.stringify(stored.payload)) };\r\n    this.events.push(frozen);\r\n    this.subs.emit(frozen);\r\n    return frozen;\r\n  }\r\n\r\n  read(fromSeq: number, toSeq?: number): JournalEvent[] {\r\n    const from = Math.max(1, fromSeq);\r\n    const to = toSeq ?? this.events.length;\r\n    return this.events.slice(from - 1, Math.max(from - 1, to));\r\n  }\r\n\r\n  lastSeq(): number {\r\n    return this.events.length;\r\n  }\r\n\r\n  subscribe(fromSeq: number, cb: (e: JournalEvent) => void): () => void {\r\n    for (const e of this.read(fromSeq)) cb(e);\r\n    return this.subs.add(cb);\r\n  }\r\n\r\n  close(): void {}\r\n}\r\n","exit_code":0,"status":"completed"}}
