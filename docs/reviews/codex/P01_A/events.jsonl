\r\n  projectDir: string;\r\n  worktreeDir: string;\r\n  mode: \"new\" | \"resume\" | \"fork\";\r\n  sessionRef?: SessionRef;\r\n  forkAt?: string;\r\n  prompt: PromptInput[];\r\n  policy: AgentPolicy;\r\n  skills: SkillRef[];\r\n  mcp: McpAllowlist;\r\n  authMode: \"cli_login\" | \"api_key\";\r\n}\r\n\r\nexport type ApprovalAnswer = {\r\n  kind: \"approval\";\r\n  decision: \"accept\" | \"decline\" | \"cancel\";\r\n  permissions?: Record<string, unknown>;\r\n};\r\nexport type UserInputAnswer = { kind: \"user_input\"; answers: Record<string, string> };\r\nexport type ElicitationAnswer = {\r\n  kind: \"elicitation\";\r\n  action: \"accept\" | \"decline\" | \"cancel\";\r\n  content?: Record<string, unknown>;\r\n};\r\n\r\nexport const GATEWAY_EVENT_KINDS = [\r\n  \"message_delta\",\r\n  \"item_started\",\r\n  \"item_updated\",\r\n  \"item_finished\",\r\n  \"approval_requested\",\r\n  \"user_input_requested\",\r\n  \"mcp_elicitation_requested\",\r\n  \"usage_updated\",\r\n  \"turn_finished\",\r\n  \"fault\",\r\n] as const;\r\nexport type GatewayEventKind = (typeof GATEWAY_EVENT_KINDS)[number];\r\n\r\n/** ��� �̺�Ʈ ���� �ʵ� + ���� ���� ������(��1 \"��� �̺�Ʈ�� native\") */\r\ninterface GatewayEventBase {\r\n  runId: string;\r\n  seq: number;\r\n  ts: string;\r\n  agent: AgentKind;\r\n  native: { schemaVersion: string; payloadRef: string };\r\n}\r\n\r\nexport type ItemKind =\r\n  | \"message\"\r\n  | \"tool\"\r\n  | \"file_change\"\r\n  | \"mcp\"\r\n  | \"web_search\"\r\n  | \"plan\"\r\n  | \"reasoning\"\r\n  | \"compaction\"\r\n  | \"review\";\r\n\r\nexport interface TokenUsage {\r\n  input: number;\r\n  cached_input: number;\r\n  cache_write: number;\r\n  output: number;\r\n  reasoning: number;\r\n}\r\n\r\nexport type GatewayEvent =\r\n  | (GatewayEventBase & { kind: \"message_delta\"; itemKey: string; text: string })\r\n  | (GatewayEventBase & { kind: \"item_started\"; itemKind: ItemKind; itemKey: string; summary: string })\r\n  | (GatewayEventBase & { kind: \"item_updated\"; itemKey: string; progress: unknown })\r\n  | (GatewayEventBase & { kind: \"item_finished\"; itemKey: string; status: string; result: string })\r\n  | (GatewayEventBase & {\r\n      kind: \"approval_requested\";\r\n      requestId: string;\r\n      category: string;\r\n      request: unknown;\r\n      itemKey: string;\r\n      permissions?: unknown;\r\n      scope?: unknown;\r\n    })\r\n  | (GatewayEventBase & { kind: \"user_input_requested\"; requestId: string; questions: unknown[]; itemKey: string })\r\n  | (GatewayEventBase & {\r\n      kind: \"mcp_elicitation_requested\";\r\n      requestId: string;\r\n      serverName: string;\r\n      mode: \"form\" | \"url\";\r\n      schema: unknown;\r\n    })\r\n  | (GatewayEventBase & { kind: \"usage_updated\"; tokens: TokenUsage; cost_estimate_usd?: number; turnKey: string })\r\n  | (GatewayEventBase & { kind: \"turn_finished\"; status: \"completed\" | \"failed\" | \"interrupted\" | \"denied\"; turnKey: string })\r\n  | (GatewayEventBase & {\r\n      kind: \"fault\";\r\n      class: \"auth\" | \"quota\" | \"transport\" | \"upstream_http\" | \"overload\" | \"protocol\" | \"internal\";\r\n      retryable: boolean;\r\n      native: { schemaVersion: string; payloadRef: string };\r\n    });\r\n\r\nexport interface RunHandle {\r\n  readonly runId: string;\r\n  readonly sessionRef: SessionRef;\r\n  events(): AsyncIterable<GatewayEvent>;\r\n  steer(text: string): Promise<SteerResult>;\r\n  interrupt(): Promise<void>;\r\n  respond(requestId: string, answer: ApprovalAnswer | UserInputAnswer | ElicitationAnswer): Promise<void>;\r\n  close(): Promise<void>;\r\n}\r\n\r\nexport interface AgentGateway {\r\n  capabilities(agent: AgentKind): Promise<Capabilities>;\r\n  startRun(spec: RunSpec): Promise<RunHandle>;\r\n  listSessions(agent: AgentKind, filter: { projectDir?: string; includeArchived?: boolean }): Promise<SessionInfo[]>;\r\n  readSession(ref: SessionRef): Promise<SessionTranscript>;\r\n}\r\n/**\r\n * ���� �̺�Ʈ ��� (P01 T3). �̺�Ʈ Ÿ�� �̸��� DATABASE_SCHEMA ��2.1 ����� ���� ��ó�̸�\r\n * `events.test.ts` �� ������ �Ľ��� �� �迭�� ���� ��ġ�� �����Ѵ�(�̸��� �ٲٰų� ���ϸ� �׽�Ʈ�� ������).\r\n * `McpElicitation-requested` �� ���� ǥ�� �״��(��Ÿ ���� ? P01 �������� ���� ���� ����).\r\n */\r\n\r\nexport const EVENT_TYPES = [\r\n  \"WorkspaceCreated\",\r\n  \"WorkspaceSettingsChanged\",\r\n  \"ProjectRegistered\",\r\n  \"ProjectPolicyChanged\",\r\n  \"ProjectSettingsChanged\",\r\n  \"ProjectTrustChanged\",\r\n  \"RequirementAdded\",\r\n  \"RequirementChanged\",\r\n  \"RequirementRemoved\",\r\n  \"RequirementLinked\",\r\n  \"RequirementUnlinked\",\r\n  \"PhaseProposed\",\r\n  \"PhaseAccepted\",\r\n  \"PhaseEdited\",\r\n  \"PhaseDepAdded\",\r\n  \"PhaseDepRemoved\",\r\n  \"TaskCreated\",\r\n  \"TaskTransition\",\r\n  \"PauseRequested\",\r\n  \"Paused\",\r\n  \"ResumeRequested\",\r\n  \"LeaseAcquired\",\r\n  \"LeaseRenewed\",\r\n  \"LeaseExpired\",\r\n  \"StaleWriterRejected\",\r\n  \"AgentRunStarted\",\r\n  \"AgentEvent\",\r\n  \"CaptureConfidenceChanged\",\r\n  \"PendingInputQueued\",\r\n  \"PlanArtifact\",\r\n  \"PlanReview\",\r\n  \"ReviewReport\",\r\n  \"ReworkResponse\",\r\n  \"ApprovalRequested\",\r\n  \"ApprovalDecided\",\r\n  \"ApprovalExpired\",\r\n  \"SessionRegistered\",\r\n  \"ExternalSessionImported\",\r\n  \"AuditSignal\",\r\n  \"ProcessObserved\",\r\n  \"McpCallObserved\",\r\n  \"ToolServerAction\",\r\n  \"HookToggled\",\r\n  \"SettingsFileChanged\",\r\n  \"InstructionFileChanged\",\r\n  \"UserInputRequested\",\r\n  \"UserInputAnswered\",\r\n  \"McpElicitation-requested\",\r\n  \"McpElicitationAnswered\",\r\n  \"EffectIntent\",\r\n  \"EffectCommitted\",\r\n  \"EffectFailed\",\r\n  \"EffectUnverifiable\",\r\n  \"GitCommandRun\",\r\n  \"RunArtifacts\",\r\n  \"SkillSelected\",\r\n  \"SkillInjectionAccepted\",\r\n  \"SkillLoadObserved\",\r\n  \"SkillApplicationVerified\",\r\n  \"SkillSelectionReviewed\",\r\n  \"SkillRegistryChanged\",\r\n  \"ProjectSkillToggled\",\r\n  \"McpServerChanged\",\r\n  \"ReviewSkipped\",\r\n  \"CheckpointCreated\",\r\n  \"RecoveryAssessment\",\r\n  \"UsageReported\",\r\n  \"ErrorRaised\",\r\n] as const;\r\n\r\nexport type EventType = (typeof EVENT_TYPES)[number];\r\nconst EVENT_TYPE_SET: ReadonlySet<string> = new Set(EVENT_TYPES);\r\nexport const isEventType = (t: string): t is EventType => EVENT_TYPE_SET.has(t);\r\n\r\n/** DATABASE_SCHEMA `tasks.kind` enum */\r\nexport const TASK_KINDS = [\"plan\", \"research\", \"prototype\", \"impl\", \"review\", \"verify\", \"replan\"] as const;\r\nexport type TaskKind = (typeof TASK_KINDS)[number];\r\n\r\n/** `events` ���̺� �� ��(DATABASE_SCHEMA ��2.1 DDL �� 1:1, camelCase). */\r\nexport interface JournalEvent {\r\n  seq: number;\r\n  eventId: string;\r\n  ts: string;\r\n  type: EventType;\r\n  workspaceId?: string;\r\n  projectId?: string;\r\n  phaseId?: string;\r\n  taskId?: string;\r\n  agentRunId?: string;\r\n  sessionRef?: string;\r\n  correlationId?: string;\r\n  causationSeq?: number;\r\n  fencingToken?: number;\r\n  payload: Record<string, unknown>;\r\n  redacted: 0 | 1;\r\n}\r\n\r\n/** append �Է�: seq �� ������ �ű�� eventId��ts��redacted �� ���� �� ������ ä���. */\r\nexport type NewEvent = Omit<JournalEvent, \"seq\" | \"eventId\" | \"ts\" | \"redacted\" | \"type\"> &\r\n  Partial<Pick<JournalEvent, \"eventId\" | \"ts\" | \"redacted\">> & { type: EventType | string };\r\n/** @agent-studio/protocol ? ��� ���� ��ó(Ÿ�ԡ�JSON). ��Ÿ�� �ڵ�� �ּ�. */\r\nexport const PROTOCOL_PACKAGE = \"@agent-studio/protocol\";\r\n\r\nexport * from \"./gateway.js\";\r\nexport * from \"./events.js\";\r\nexport * from \"./ulid.js\";\r\nexport * from \"./transitions.js\";\r\nexport * from \"./policy.js\";\r\n","exit_code":0,"status":"completed"}}
