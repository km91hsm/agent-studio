 pending(): PendingApproval[];\r\n  38:   /** TTL �� ���� ���� ��û�� `ApprovalExpired` �� ����ϰ� �� ID ���� �����ش�. */\r\n  39:   expire(): string[];\r\n  40: }\r\n  41: \r\n  42: export class ApprovalError extends Error {\r\n  43:   constructor(readonly code: \"approval_expired\" | \"not_found\" | \"already_decided\") {\r\n  44:     super(code);\r\n  45:     this.name = \"ApprovalError\";\r\n  46:   }\r\n  47: }\r\n  48: \r\n  49: type Rec = PendingApproval & { status: \"pending\" | \"decided\" | \"expired\"; scope: ApprovalScope };\r\n  50: \r\n  51: export class DefaultPolicyBroker implements ApprovalBroker {\r\n  52:   private readonly recs = new Map<string, Rec>();\r\n  53:   private readonly ttlMs: number;\r\n  54:   private readonly now: () => number;\r\n  55: \r\n  56:   constructor(\r\n  57:     private readonly store: EventStore,\r\n  58:     private readonly policy: ProjectPolicy,\r\n  59:     opts: { ttlMs?: number; now?: () => number } = {},\r\n  60:   ) {\r\n  61:     this.ttlMs = opts.ttlMs ?? 15 * 60_000;\r\n  62:     this.now = opts.now ?? Date.now;\r\n  63:     store.subscribe(0, (e) => this.applyEvent(e));\r\n  64:   }\r\n  65: \r\n  66:   private applyEvent(e: JournalEvent): void {\r\n  67:     const rid = e.payload.request_id;\r\n  68:     if (typeof rid !== \"string\") return;\r\n  69:     if (e.type === \"ApprovalRequested\") {\r\n  70:       this.recs.set(rid, {\r\n  71:         requestId: rid,\r\n  72:         taskId: e.taskId ?? \"\",\r\n  73:         runId: e.agentRunId ?? \"\",\r\n  74:         kind: e.payload.kind as ApprovalKind,\r\n  75:         category: e.payload.category as ApprovalCategory,\r\n  76:         request: (e.payload.request ?? {}) as Record<string, unknown>,\r\n  77:         requestedAt: String(e.payload.requested_at ?? e.ts),\r\n  78:         expiresAt: String(e.payload.expires_at),\r\n  79:         scope: (e.payload.scope as ApprovalScope | undefined) ?? \"once\",\r\n  80:         status: \"pending\",\r\n  81:       });\r\n  82:     } else if (e.type === \"ApprovalDecided\") {\r\n  83:       const r = this.recs.get(rid);\r\n  84:       if (r) r.status = \"decided\";\r\n  85:     } else if (e.type === \"ApprovalExpired\") {\r\n  86:       const r = this.recs.get(rid);\r\n  87:       if (r) r.status = \"expired\";\r\n  88:     }\r\n  89:   }\r\n  90: \r\n  91:   private rule(category: ApprovalCategory): PolicyRule {\r\n  92:     return this.policy.rules[category];\r\n  93:   }\r\n  94: \r\n  95:   evaluate(req: ApprovalRequest): Verdict {\r\n  96:     return evaluateRule(this.rule(req.category), req.signals);\r\n  97:   }\r\n  98: \r\n  99:   request(req: ApprovalRequest): string {\r\n 100:     const rule = this.rule(req.category);\r\n 101:     const ex = matchException(rule, req.signals);\r\n 102:     const verdict = ex?.verdict ?? rule.default;\r\n 103:     const scope = ex?.scope ?? rule.scope;\r\n 104:     const id = ulid(this.now());\r\n 105:     const requestedAt = new Date(this.now()).toISOString();\r\n 106:     const expiresAt = new Date(this.now() + this.ttlMs).toISOString();\r\n 107:     this.store.append({\r\n 108:       type: \"ApprovalRequested\",\r\n 109:       taskId: req.taskId,\r\n 110:       agentRunId: req.runId,\r\n 111:       correlationId: id,\r\n 112:       payload: { request_id: id, kind: req.kind, category: req.category, request: req.request, requested_at: requestedAt, expires_at: expiresAt, verdict, scope, ...(req.signals && { signals: req.signals }) },\r\n 113:     });\r\n 114:     if (verdict === \"AUTO\") this.appendDecision(id, req.taskId, \"accept\", \"policy\", scope);\r\n 115:     else if (verdict === \"DENY\") this.appendDecision(id, req.taskId, \"decline\", \"policy\", scope);\r\n 116:     return id;\r\n 117:   }\r\n 118: \r\n 119:   decide(requestId: string, decision: Decision, by: \"user\" | \"policy\", scope?: ApprovalScope): void {\r\n 120:     const r = this.recs.get(requestId);\r\n 121:     if (!r) throw new ApprovalError(\"not_found\");\r\n 122:     if (r.status === \"expired\" || (r.status === \"pending\" && this.isExpired(r))) throw new ApprovalError(\"approval_expired\");\r\n 123:     if (r.status === \"decided\") throw new ApprovalError(\"already_decided\");\r\n 124:     this.appendDecision(requestId, r.taskId, decision, by, scope ?? r.scope);\r\n 125:   }\r\n 126: \r\n 127:   pending(): PendingApproval[] {\r\n 128:     return [...this.recs.values()]\r\n 129:       .filter((r) => r.status === \"pending\")\r\n 130:       .map(({ status: _s, scope: _sc, ...p }) => p);\r\n 131:   }\r\n 132: \r\n 133:   expire(): string[] {\r\n 134:     const out: string[] = [];\r\n 135:     for (const r of this.recs.values()) {\r\n 136:       if (r.status === \"pending\" && this.isExpired(r)) {\r\n 137:         this.store.append({ type: \"ApprovalExpired\", taskId: r.taskId, agentRunId: r.runId || undefined, correlationId: r.requestId, payload: { request_id: r.requestId } });\r\n 138:         out.push(r.requestId);\r\n 139:       }\r\n 140:     }\r\n 141:     return out;\r\n 142:   }\r\n 143: \r\n 144:   private isExpired(r: Rec): boolean {\r\n 145:     return Date.parse(r.expiresAt) <= this.now();\r\n 146:   }\r\n 147: \r\n 148:   private appendDecision(requestId: string, taskId: string, decision: Decision, by: \"user\" | \"policy\", scope: ApprovalScope): void {\r\n 149:     this.store.append({\r\n 150:       type: \"ApprovalDecided\",\r\n 151:       taskId,\r\n 152:       correlationId: requestId,\r\n 153:       payload: { request_id: requestId, decision, scope, by, decided_at: new Date(this.now()).toISOString() },\r\n 154:     });\r\n 155:   }\r\n 156: }\r\n","exit_code":0,"status":"completed"}}
