, ?, ?, ?, ?, NULL, NULL, NULL, ?, NULL, ?)\",\r\n 103:         ).run(rid, e.taskId ?? null, e.agentRunId ?? null, str(e.payload.kind), str(e.payload.category), JSON.stringify(e.payload.request ?? null), str(e.payload.requested_at) ?? e.ts, str(e.payload.expires_at));\r\n 104:       } else if (e.type === \"ApprovalDecided\") {\r\n 105:         db.prepare(\"UPDATE approvals SET decision = ?, scope = ?, decided_by = ?, decided_at = ? WHERE request_id = ?\").run(\r\n 106:           str(e.payload.decision),\r\n 107:           str(e.payload.scope),\r\n 108:           str(e.payload.by),\r\n 109:           str(e.payload.decided_at) ?? e.ts,\r\n 110:           rid,\r\n 111:         );\r\n 112:       } else if (e.type === \"ApprovalExpired\") {\r\n 113:         db.prepare(\"UPDATE approvals SET decision = 'expired', decided_by = 'daemon', decided_at = ? WHERE request_id = ?\").run(e.ts, rid);\r\n 114:       }\r\n 115:     },\r\n 116:   },\r\n 117:   {\r\n 118:     table: \"capabilities\",\r\n 119:     ddl: `CREATE TABLE IF NOT EXISTS capabilities (key TEXT PRIMARY KEY, value_json TEXT NOT NULL)`,\r\n 120:     apply(e, db) {\r\n 121:       if (e.type !== \"WorkspaceSettingsChanged\") return;\r\n 122:       const caps = e.payload.capabilities;\r\n 123:       if (!caps || typeof caps !== \"object\") return;\r\n 124:       const up = db.prepare(\"INSERT OR REPLACE INTO capabilities(key, value_json) VALUES (?, ?)\");\r\n 125:       for (const [k, v] of Object.entries(caps as Record<string, unknown>)) up.run(k, JSON.stringify(v));\r\n 126:     },\r\n 127:   },\r\n 128: ];\r\n 129: \r\n 130: const CURSOR_DDL = `CREATE TABLE IF NOT EXISTS projection_cursor (name TEXT PRIMARY KEY, last_seq INTEGER NOT NULL)`;\r\n 131: \r\n 132: export function ensureProjectionTables(db: Database.Database): void {\r\n 133:   for (const p of PROJECTORS) db.exec(p.ddl);\r\n 134:   db.exec(CURSOR_DDL);\r\n 135: }\r\n 136: \r\n 137: /** append Ʈ����� �ȿ��� ȣ��: ��� projector ���� + cursor ����. */\r\n 138: export function applyProjection(db: Database.Database, e: JournalEvent): void {\r\n 139:   const cursor = db.prepare(\"INSERT OR REPLACE INTO projection_cursor(name, last_seq) VALUES (?, ?)\");\r\n 140:   for (const p of PROJECTORS) {\r\n 141:     p.apply(e, db);\r\n 142:     cursor.run(p.table, e.seq);\r\n 143:   }\r\n 144: }\r\n 145: \r\n 146: /** ���� ���̺� ���� DROP �� ���� ��ü ���(RC-S16). */\r\n 147: export function rebuildProjections(store: SqliteEventStore): void {\r\n 148:   const db = store.db;\r\n 149:   const tx = db.transaction(() => {\r\n 150:     for (const p of PROJECTORS) db.exec(`DROP TABLE IF EXISTS ${p.table}`);\r\n 151:     db.exec(\"DROP TABLE IF EXISTS projection_cursor\");\r\n 152:     ensureProjectionTables(db);\r\n 153:     const cursor = db.prepare(\"INSERT OR REPLACE INTO projection_cursor(name, last_seq) VALUES (?, ?)\");\r\n 154:     for (const p of PROJECTORS) cursor.run(p.table, 0);\r\n 155:     for (const e of store.read(1)) applyProjection(db, e);\r\n 156:   });\r\n 157:   tx();\r\n 158: }\r\n 159: \r\n 160: /** ���� ���̺�(+cursor) ���� ���ġ�����ȭ�� sha256. */\r\n 161: export function projectionChecksum(store: SqliteEventStore): string {\r\n 162:   const h = createHash(\"sha256\");\r\n 163:   for (const table of [...PROJECTORS.map((p) => p.table), \"projection_cursor\"]) {\r\n 164:     const cols = store.columns(table);\r\n 165:     const rows = store.db.prepare(`SELECT * FROM ${table} ORDER BY ${cols.map((c) => `\"${c}\"`).join(\", \")}`).all() as Record<string, unknown>[];\r\n 166:     h.update(`#${table}\\n`);\r\n 167:     for (const r of rows) h.update(JSON.stringify(cols.map((c) => r[c])) + \"\\n\");\r\n 168:   }\r\n 169:   return h.digest(\"hex\");\r\n 170: }\r\n","exit_code":0,"status":"completed"}}
