, seq);\r\n  31: CREATE TRIGGER IF NOT EXISTS events_no_update BEFORE UPDATE ON events BEGIN SELECT RAISE(ABORT, 'events is append-only'); END;\r\n  32: CREATE TRIGGER IF NOT EXISTS events_no_delete BEFORE DELETE ON events BEGIN SELECT RAISE(ABORT, 'events is append-only'); END;\r\n  33: `;\r\n  34: \r\n  35: type Row = {\r\n  36:   seq: number;\r\n  37:   event_id: string;\r\n  38:   ts: string;\r\n  39:   type: string;\r\n  40:   workspace_id: string | null;\r\n  41:   project_id: string | null;\r\n  42:   phase_id: string | null;\r\n  43:   task_id: string | null;\r\n  44:   agent_run_id: string | null;\r\n  45:   session_ref: string | null;\r\n  46:   correlation_id: string | null;\r\n  47:   causation_seq: number | null;\r\n  48:   fencing_token: number | null;\r\n  49:   payload: string;\r\n  50:   redacted: number;\r\n  51: };\r\n  52: \r\n  53: function rowToEvent(r: Row): JournalEvent {\r\n  54:   const e: JournalEvent = {\r\n  55:     seq: r.seq,\r\n  56:     eventId: r.event_id,\r\n  57:     ts: r.ts,\r\n  58:     type: r.type as JournalEvent[\"type\"],\r\n  59:     payload: JSON.parse(r.payload) as Record<string, unknown>,\r\n  60:     redacted: (r.redacted ? 1 : 0) as 0 | 1,\r\n  61:   };\r\n  62:   if (r.workspace_id !== null) e.workspaceId = r.workspace_id;\r\n  63:   if (r.project_id !== null) e.projectId = r.project_id;\r\n  64:   if (r.phase_id !== null) e.phaseId = r.phase_id;\r\n  65:   if (r.task_id !== null) e.taskId = r.task_id;\r\n  66:   if (r.agent_run_id !== null) e.agentRunId = r.agent_run_id;\r\n  67:   if (r.session_ref !== null) e.sessionRef = r.session_ref;\r\n  68:   if (r.correlation_id !== null) e.correlationId = r.correlation_id;\r\n  69:   if (r.causation_seq !== null) e.causationSeq = r.causation_seq;\r\n  70:   if (r.fencing_token !== null) e.fencingToken = r.fencing_token;\r\n  71:   return e;\r\n  72: }\r\n  73: \r\n  74: export interface ProjectionsApi {\r\n  75:   query(table: string): Record<string, unknown>[];\r\n  76:   checksum(): string;\r\n  77:   rebuild(): void;\r\n  78: }\r\n  79: \r\n  80: export class SqliteEventStore implements EventStore {\r\n  81:   private readonly subs = new Subscribers();\r\n  82:   private readonly insert;\r\n  83:   private readonly selectRange;\r\n  84:   private readonly selectMax;\r\n  85:   private readonly appendTx;\r\n  86: \r\n  87:   constructor(\r\n  88:     readonly db: Database.Database,\r\n  89:     private readonly now: () => number = Date.now,\r\n  90:   ) {\r\n  91:     db.pragma(\"journal_mode = WAL\");\r\n  92:     db.pragma(\"synchronous = NORMAL\");\r\n  93:     db.pragma(\"busy_timeout = 5000\");\r\n  94:     db.pragma(\"foreign_keys = ON\");\r\n  95:     db.exec(DDL);\r\n  96:     if (this.schemaVersion() === 0) {\r\n  97:       db.prepare(\"INSERT INTO schema_version(version, applied_at) VALUES (?, ?)\").run(SCHEMA_VERSION, new Date(now()).toISOString());\r\n  98:     }\r\n  99:     this.insert = db.prepare(\r\n 100:       `INSERT INTO events(seq, event_id, ts, type, workspace_id, project_id, phase_id, task_id, agent_run_id, session_ref, correlation_id, causation_seq, fencing_token, payload, redacted)\r\n 101:        VALUES (@seq, @event_id, @ts, @type, @workspace_id, @project_id, @phase_id, @task_id, @agent_run_id, @session_ref, @correlation_id, @causation_seq, @fencing_token, @payload, @redacted)`,\r\n 102:     );\r\n 103:     this.selectRange = db.prepare(\"SELECT * FROM events WHERE seq >= ? AND seq <= ? ORDER BY seq\");\r\n 104:     this.selectMax = db.prepare(\"SELECT COALESCE(MAX(seq), 0) AS m FROM events\");\r\n 105:     this.appendTx = db.transaction((e: JournalEvent) => {\r\n 106:       this.insert.run({\r\n 107:         seq: e.seq,\r\n 108:         event_id: e.eventId,\r\n 109:         ts: e.ts,\r\n 110:         type: e.type,\r\n 111:         workspace_id: e.workspaceId ?? null,\r\n 112:         project_id: e.projectId ?? null,\r\n 113:         phase_id: e.phaseId ?? null,\r\n 114:         task_id: e.taskId ?? null,\r\n 115:         agent_run_id: e.agentRunId ?? null,\r\n 116:         session_ref: e.sessionRef ?? null,\r\n 117:         correlation_id: e.correlationId ?? null,\r\n 118:         causation_seq: e.causationSeq ?? null,\r\n 119:         fencing_token: e.fencingToken ?? null,\r\n 120:         payload: JSON.stringify(e.payload),\r\n 121:         redacted: e.redacted,\r\n 122:       });\r\n 123:       applyProjection(db, e);\r\n 124:     });\r\n 125:     this.ensureProjectionsFresh();\r\n 126:   }\r\n 127: \r\n 128:   /** �⵿ ���: ���� ���̺� ���� �Ǵ� cursor < lastSeq �� ��ü �籸��. */\r\n 129:   private ensureProjectionsFresh(): void {\r\n 130:     const tables = new Set(\r\n 131:       (this.db.prepare(\"SELECT name FROM sqlite_master WHERE type='table'\").all() as { name: string }[]).map((r) => r.name),\r\n 132:     );\r\n 133:     const need = [...PROJECTORS.map((p) => p.table), \"projection_cursor\"];\r\n 134:     const missing = need.some((t) => !tables.has(t));\r\n 135:     if (missing) {\r\n 136:       rebuildProjections(this);\r\n 137:       return;\r\n 138:     }\r\n 139:     ensureProjectionTables(this.db);\r\n 140:     const cursors = this.db.prepare(\"SELECT last_seq FROM projection_cursor\").all() as { last_seq: number }[];\r\n 141:     const minCursor = cursors.length === need.length - 1 ? Math.min(...cursors.map((c) => c.last_seq)) : -1;\r\n 142:     if (minCursor !== this.lastSeq()) rebuildProjections(this);\r\n 143:   }\r\n 144: \r\n 145:   append(e: NewEvent): JournalEvent {\r\n 146:     const stored = prepareEvent(e, this.lastSeq() + 1, this.now);\r\n 147:     this.appendTx(stored);\r\n 148:     const back = this.read(stored.seq, stored.seq)[0]!;\r\n 149:     this.subs.emit(back);\r\n 150:     return back;\r\n 151:   }\r\n 152: \r\n 153:   read(fromSeq: number, toSeq?: number): JournalEvent[] {\r\n 154:     const rows = this.selectRange.all(Math.max(1, fromSeq), toSeq ?? Number.MAX_SAFE_INTEGER) as Row[];\r\n 155:     return rows.map(rowToEvent);\r\n 156:   }\r\n 157: \r\n 158:   lastSeq(): number {\r\n 159:     return (this.selectMax.get() as { m: number }).m;\r\n 160:   }\r\n 161: \r\n 162:   subscribe(fromSeq: number, cb: (e: JournalEvent) => void): () => void {\r\n 163:     for (const e of this.read(fromSeq)) cb(e);\r\n 164:     return this.subs.add(cb);\r\n 165:   }\r\n 166: \r\n 167:   close(): void {\r\n 168:     this.db.close();\r\n 169:   }\r\n 170: \r\n 171:   // --- SQLite ���� ---\r\n 172:   schemaVersion(): number {\r\n 173:     const r = this.db.prepare(\"SELECT MAX(version) AS v FROM schema_version\").get() as { v: number | null };\r\n 174:     return r.v ?? 0;\r\n 175:   }\r\n 176:   pragma(name: string): unknown {\r\n 177:     return this.db.pragma(name, { simple: true });\r\n 178:   }\r\n 179:   /** �׽�Ʈ��� ������ ���� SQL(���� ��ü�� Ʈ���Ű� ��ȣ). */\r\n 180:   rawExec(sql: string): void {\r\n 181:     this.db.exec(sql);\r\n 182:   }\r\n 183:   columns(table: string): string[] {\r\n 184:     return (this.db.prepare(`PRAGMA table_info(${table})`).all() as { name: string }[]).map((c) => c.name);\r\n 185:   }\r\n 186:   projections(): ProjectionsApi {\r\n 187:     return {\r\n 188:       query: (table) => this.db.prepare(`SELECT * FROM ${table}`).all() as Record<string, unknown>[],\r\n 189:       checksum: () => projectionChecksum(this),\r\n 190:       rebuild: () => rebuildProjections(this),\r\n 191:     };\r\n 192:   }\r\n 193: }\r\n 194: \r\n 195: export function openSqliteStore(path: string, now?: () => number): SqliteEventStore {\r\n 196:   return new SqliteEventStore(new Database(path), now);\r\n 197: }\r\n","exit_code":0,"status":"completed"}}
