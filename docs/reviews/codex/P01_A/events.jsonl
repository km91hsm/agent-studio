id {\r\n  30:   store.append({ type: \"WorkspaceSettingsChanged\", payload: { capabilities: { isolation_warning: warnings } } });\r\n  31: }\r\n  32: \r\n  33: /** ������ ������ `isolation_warning` ��Ϻ����� ���տ� �ش��ϴ� ���. */\r\n  34: export function allWarnings(store: EventStore): IsolationWarning[] {\r\n  35:   let latest: IsolationWarning[] = [];\r\n  36:   for (const e of store.read(1)) {\r\n  37:     if (e.type !== \"WorkspaceSettingsChanged\") continue;\r\n  38:     const caps = e.payload.capabilities as { isolation_warning?: IsolationWarning[] } | undefined;\r\n  39:     if (caps?.isolation_warning) latest = caps.isolation_warning;\r\n  40:   }\r\n  41:   return latest;\r\n  42: }\r\n  43: \r\n  44: export function warningsFor(store: EventStore, combo: Combo | string): IsolationWarning[] {\r\n  45:   const key = comboKey(combo);\r\n  46:   return allWarnings(store).filter((w) => comboKey(w) === key);\r\n  47: }\r\n  48: \r\n  49: const AUTO_CLAUDE = new Set<PermissionMode[\"claude\"]>([\"acceptEdits\", \"auto\", \"bypassPermissions\", \"dontAsk\"]);\r\n  50: export const isAutoMode = (pm: PermissionMode): boolean => AUTO_CLAUDE.has(pm.claude) || pm.codex.approvalPolicy === \"never\";\r\n  51: \r\n  52: type Pending = { requestId: string; combo: string; next: PermissionMode };\r\n  53: \r\n  54: export class PolicyGate {\r\n  55:   private current: ProjectPolicy = DEFAULT_POLICY;\r\n  56:   /** ������ ��å ������ ����� ���� ����(���� ǥ�ÿ�) */\r\n  57:   private lastCombo: string | undefined;\r\n  58:   private readonly pendingMap = new Map<string, Pending>();\r\n  59: \r\n  60:   constructor(\r\n  61:     private readonly store: EventStore,\r\n  62:     private readonly projectId: string,\r\n  63:     private readonly now: () => number = Date.now,\r\n  64:   ) {\r\n  65:     store.subscribe(0, (e) => this.applyEvent(e));\r\n  66:   }\r\n  67: \r\n  68:   private applyEvent(e: JournalEvent): void {\r\n  69:     if (e.projectId !== this.projectId) return;\r\n  70:     if (e.type === \"ProjectPolicyChanged\" && e.payload.after) {\r\n  71:       this.current = e.payload.after as ProjectPolicy;\r\n  72:       if (typeof e.payload.combo === \"string\") this.lastCombo = e.payload.combo;\r\n  73:     } else if (e.type === \"UserInputRequested\" && e.payload.kind === \"isolation_confirm\" && typeof e.payload.request_id === \"string\") {\r\n  74:       this.pendingMap.set(e.payload.request_id, { requestId: e.payload.request_id, combo: String(e.payload.combo), next: e.payload.next_permission_mode as PermissionMode });\r\n  75:     } else if (e.type === \"UserInputAnswered\" && typeof e.payload.request_id === \"string\") {\r\n  76:       this.pendingMap.delete(e.payload.request_id);\r\n  77:     }\r\n  78:   }\r\n  79: \r\n  80:   policy(): ProjectPolicy {\r\n  81:     return this.current;\r\n  82:   }\r\n  83: \r\n  84:   setPermissionMode(next: PermissionMode, combo: Combo | string, actor: \"user\"): { status: \"applied\" } | { status: \"confirmation_required\"; requestId: string; warnings: IsolationWarning[] } {\r\n  85:     const key = comboKey(combo);\r\n  86:     const warnings = warningsFor(this.store, key);\r\n  87:     const needsConfirm = isAutoMode(next) && warnings.length > 0 && this.current.autoModeConfirmed?.combo !== key;\r\n  88:     if (needsConfirm) {\r\n  89:       const requestId = ulid(this.now());\r\n  90:       this.store.append({\r\n  91:         type: \"UserInputRequested\",\r\n  92:         projectId: this.projectId,\r\n  93:         correlationId: requestId,\r\n  94:         payload: { request_id: requestId, kind: \"isolation_confirm\", combo: key, warnings, next_permission_mode: next, requested_by: actor },\r\n  95:       });\r\n  96:       return { status: \"confirmation_required\", requestId, warnings };\r\n  97:     }\r\n  98:     this.applyPolicy({ ...this.current, permissionMode: next }, actor, key);\r\n  99:     return { status: \"applied\" };\r\n 100:   }\r\n 101: \r\n 102:   confirm(requestId: st