ansitionAuth;\r\n  79:   payload: Record<string, unknown>;\r\n  80:   has(type: EventType): boolean;\r\n  81:   approval(requestId: string): ApprovalRecord | undefined;\r\n  82:   liveLeases(): number;\r\n  83: }\r\n  84: \r\n  85: export interface SchedulerOptions {\r\n  86:   leaseTtlMs?: number;\r\n  87:   maxIterations?: number;\r\n  88:   maxSlots?: number;\r\n  89:   now?: () => number;\r\n  90:   table?: TransitionTable;\r\n  91: }\r\n  92: \r\n  93: const USER_PAYLOAD_KEYS = [\"implementer_agent\", \"reviewer_agent\", \"policy\", \"evidenceIds\"] as const;\r\n  94: \r\n  95: export class Scheduler {\r\n  96:   private readonly tasks = new Map<string, TaskRecord>();\r\n  97:   private readonly approvals = new Map<string, ApprovalRecord>();\r\n  98:   private readonly table: TransitionTable;\r\n  99:   private readonly leaseTtlMs: number;\r\n 100:   private readonly maxIterations: number;\r\n 101:   private readonly maxSlots: number | undefined;\r\n 102:   private readonly now: () => number;\r\n 103:   private tokenCounter = 0;\r\n 104:   private readonly checkers: Record<string, (ctx: PreconditionCtx) => boolean>;\r\n 105: \r\n 106:   constructor(\r\n 107:     private readonly store: EventStore,\r\n 108:     opts: SchedulerOptions = {},\r\n 109:   ) {\r\n 110:     this.table = opts.table ?? loadTransitions();\r\n 111:     this.leaseTtlMs = opts.leaseTtlMs ?? 90_000;\r\n 112:     this.maxIterations = opts.maxIterations ?? 3;\r\n 113:     this.maxSlots = opts.maxSlots;\r\n 114:     this.now = opts.now ?? Date.now;\r\n 115:     this.checkers = {\r\n 116:       deps_completed: () => true, // Task �������� P03(Phase DAG) ? P01 Task �� deps ����\r\n 117:       slot_available: (c) => this.maxSlots === undefined || c.liveLeases() < this.maxSlots,\r\n 118:       lease_valid: (c) => c.auth.kind === \"lease\" && c.task.lease?.fencingToken === c.auth.token,\r\n 119:       plan_artifact: (c) => c.has(\"PlanArtifact\"),\r\n 120:       skill_selected: (c) => c.has(\"SkillSelected\"),\r\n 121:       run_artifacts: (c) => c.has(\"RunArtifacts\"),\r\n 122:       review_skip_policy: (c) => typeof c.payload.policy === \"string\" && c.payload.policy.length > 0,\r\n 123:       reviewer_distinct: (c) => typeof c.payload.reviewer_agent === \"string\" && c.task.implementerAgent !== undefined && c.payload.reviewer_agent !== c.task.implementerAgent,\r\n 124:       evidence_present: (c) => Array.isArray(c.payload.evidenceIds) && c.payload.evidenceIds.length > 0,\r\n 125:       iteration_lt_max: (c) => c.task.iteration < this.maxIterations,\r\n 126:       iteration_ge_max: (c) => c.task.iteration >= this.maxIterations,\r\n 127:       user_actor: (c) => c.auth.kind === \"user\",\r\n 128:       approval_decided: (c) => {\r\n 129:         if (c.auth.kind !== \"daemon\") return false;\r\n 130:         const rec = c.approval(c.auth.requestId);\r\n 131:         if (!rec || rec.taskId !== c.task.id || c.task.pendingRequestId !== c.auth.requestId) return false;\r\n 132:         if (c.event === \"approved\") return rec.outcome === \"accept\";\r\n 133:         if (c.event === \"denied_terminal\") return rec.outcome === \"decline\" || rec.outcome === \"cancel\";\r\n 134:         if (c.event === \"approval_expired\") return rec.outcome === \"expired\";\r\n 135:         return false;\r\n 136:       },\r\n 137:     };\r\n 138:     const used = new Set(this.table.transitions.flatMap((t) => t.preconditions));\r\n 139:     const missing = [...used].filter((id) => !(id in this.checkers));\r\n 140:     if (missing.length) throw new PreconditionUnenforced(missing);\r\n 141:     const unknownIds = (PRECONDITION_IDS as readonly string[]).filter((id) => !(id in this.checkers));\r\n 142:     if (unknownIds.length) throw new PreconditionUnenforced(unknownIds);\r\n 143:     store.subscribe(0, (e) => this.applyEvent(e));\r\n 144:   }\r\n 145: \r\n 146:   // ---------- ���� �� �� ----------\r\n 147:   private applyEvent(e: JournalEvent): void {\r\n 148:     if (e.type === \"LeaseAcquired\" && typeof e.payload.token === \"number\") this.tokenCounter = Math.max(this.tokenCounter, e.payload.token);\r\n 149:     if (e.type === \"ApprovalRequested\" && typeof e.payload.request_id === \"string\") {\r\n 150:       this.approvals.set(e.payload.request_id, { ...(this.approvals.get(e.payload.request_id) ?? {}), taskId: e.taskId });\r\n 151:     } else if (e.type === \"ApprovalDecided\" && typeof e.payload.request_id === \"string\") {\r\n 152:       const rec = this.approvals.get(e.payload.request_id) ?? {};\r\n 153:       rec.outcome = e.payload.decision as ApprovalRecord[\"outcome\"];\r\n 154:       this.approvals.set(e.payload.request_id, rec);\r\n 155:     } else if (e.type === \"ApprovalExpired\" && typeof e.payload.request_id === \"string\") {\r\n 156:       const rec = this.approvals.get(e.payload.request_id) ?? {};\r\n 157:       rec.outcome = \"expired\";\r\n 158:       this.approvals.set(e.payload.request_id, rec);\r\n 159:     }\r\n 160:     if (!e.taskId) return;\r\n 161:     let t = this.tasks.get(e.taskId);\r\n 162:     if (e.type === \"TaskCreated\") {\r\n 163:       t = { id: e.taskId, status: \"QUEUED\", paused: false, iteration: 0, seen: new Set() };\r\n 164:       this.tasks.set(e.taskId, t);\r\n 165:       return;\r\n 166:     }\r\n 167:     if (!t) return;\r\n 168:     t.seen.add(e.type);\r\n 169:     switch (e.type) {\r\n 170:       case \"TaskTransition\": {\r\n 171:         const to = e.payload.to as TaskState;\r\n 172:         const from = e.payload.from as TaskState | null;\r\n 173:         t.status = to;\r\n 174:         if (typeof e.payload.iteration === \"number\") t.iteration = e.payload.iteration;\r\n 175:         if (typeof e.payload.implementer_agent === \"string\") t.implementerAgent = e.payload.implementer_agent;\r\n 176:         if (to === \"WAITING_APPROVAL\") {\r\n 177:           t.resumeFrom = from ?? undefined;\r\n 178:           t.pendingRequestId = typeof e.payload.request_id === \"string\" ? e.payload.request_id : undefined;\r\n 179:         } else if (from === \"WAITING_APPROVAL\") {\r\n 180:           t.resumeFrom = undefined;\r\n 181:           t.pendingRequestId = undefined;\r\n 182:         }\r\n 183:         break;\r\n 184:       }\r\n 185:       case \"LeaseAcquired\":\r\n 186:         t.lease = { runId: String(e.payload.run_id ?? e.agentRunId), fencingToken: Number(e.payload.token), expiresAt: String(e.payload.expires_at) };\r\n 187:         break;\r\n 188:       case \"LeaseRenewed\":\r\n 189:         if (t.lease && t.lease.fencingToken === e.payload.token && typeof e.payload.expires_at === \"string\") t.lease.expiresAt = e.payload.expires_at;\r\n 190:         break;\r\n 191:       case \"LeaseExpired\":\r\n 192:         if (t.lease && t.lease.fencingToken === e.payload.token) t.lease = undefined;\r\n 193:         break;\r\n 194:       case \"Paused\":\r\n 195:         t.paused = true;\r\n 196:         break;\r\n 197:       case \"ResumeRequested\":\r\n 198:         t.paused = false;\r\n 199:         break;\r\n 200:     }\r\n 201:   }\r\n 202: \r\n 203:   // ---------- ���� API ----------\r\n 204:   submit(t: { id?: string; phaseId?: string; title: string; kind: TaskKind }): string {\r\n 205:     if (!(TASK_KINDS as readonly string[]).includes(t.kind)) throw new SchedulerError(\"invalid_kind\", `invalid task kind: ${t.kind}`);\r\n 206:     const id = t.id ?? ulid(this.now());\r\n 207:     if (this.tasks.has(id)) throw new SchedulerError(\"duplicate_task\", `task exists: ${id}`);\r\n 208:     this.store.append({ type: \"TaskCreated\", taskId: id, phaseId: t.phaseId, payload: { title: t.title, kind: t.kind, ...(t.phaseId && { phase_id: t.phaseId }) } });\r\n 209:     this.store.append({ type: \"TaskTransition\", taskId: id, payload: { from: null, to: \"QUEUED\", reason: \"submit\" } });\r\n 210:     return id;\r\n 211:   }\r\n 212: \r\n 213:   state(taskId: string): TaskView {\r\n 214:     const t = this.get(taskId);\r\n 215:     const { seen: _s, ...view } = t;\r\n 216:     return { ...view, lease: t.lease ? { ...t.lease } : undefined };\r\n 217:   }\r\n 218: \r\n 219:   acquireLease(taskId: string, runId: string): { fencingToken: number; expiresAt: string } {\r\n 220:     const t = this.get(taskId);\r\n 221:     if (this.table.terminal.includes(t.status)) throw new InvalidTransition(t.status, \"acquireLease\");\r\n 222:     if (t.lease && !this.isExpired(t.lease.expiresAt)) throw new LeaseHeld(taskId);\r\n 223:     const fencingToken = ++this.tokenCounter;\r\n 224:     const expiresAt = new Date(this.now() + this.leaseTtlMs).toISOString();\r\n 225:     this.store.append({ type: \"LeaseAcquired\", taskId, agentRunId: runId, fencingToken, payload: { run_id: runId, token: fencingToken, ttl: this.leaseTtlMs, expires_at: expiresAt } });\r\n 226:     return { fencingToken, expiresAt };\r\n 227:   }\r\n 228: \r\n 229:   heartbeat(taskId: string, fencingToken: number): void {\r\n 230:     const t = this.get(taskId);\r\n 231:     if (!t.lease || t.lease.fencingToken !== fencingToken || this.isExpired(t.lease.expiresAt)) {\r\n 232:       this.rejectStale(t, fencingToken);\r\n 233:     }\r\n 234:     const expiresAt = new Date(this.now() + this.leaseTtlMs).toISOString();\r\n 235:     this.store.append({\r\n 236:       type: \"LeaseRenewed\",\r\n 237:       taskId,\r\n 238:       agentRunId: t.lease!.runId,\r\n 239:       fencingToken,\r\n 240:       payload: { run_id: t.lease!.runId, token: fencingToken, heartbeat_at: new Date(this.now()).toISOString(), expires_at: expiresAt },\r\n 241:     });\r\n 242:   }\r\n 243: \r\n 244:   /** TTL �� ���� lease �� LeaseExpired �� ȸ���Ѵ�. ���´� �ٲ��� �ʴ´�(WAITING_APPROVAL ���� ? ���� �� ��ȹ��). */\r\n 245:   expireLeases(): string[] {\r\n 246:     const out: string[] = [];\r\n 247:     for (const t of this.tasks.values()) {\r\n 248:       if (t.lease && this.isExpired(t.lease.expiresAt)) {\r\n 249:         this.store.append({ type: \"LeaseExpired\", taskId: t.id, agentRunId: t.lease.runId, payload: { run_id: t.lease.runId, token: t.lease.fencingToken, reason: \"ttl\" } });\r\n 250:         out.push(t.id);\r\n 251:       }\r\n 252:     }\r\n 253:     return out;\r\n 254:   }\r\n 255: \r\n 256:   transition(taskId: string, event: TaskEvent, auth: TransitionAuth, payload: Record<string, unknown> = {}): TaskState {\r\n 257:     const t = this.get(taskId);\r\n 258:     const edge = nextState(this.table, t.status, event);\r\n 259:     if (!edge) throw new InvalidTransition(t.status, event);\r\n 260:     const expectedKind = USER_EVENTS.has(event) ? \"user\" : DAEMON_EVENTS.has(event) ? \"daemon\" : LEASE_EVENTS.has(event) ? \"lease\" : null;\r\n 261:     if (expectedKind === null || auth.kind !== expectedKind) throw new AuthKindMismatch(event, auth.kind);\r\n 262:     if (auth.kind === \"lease\" && (!t.lease || t.lease.fencingToken !== auth.token || this.isExpired(t.lease.expiresAt))) {\r\n 263:       this.rejectStale(t, auth.token);\r\n 264:     }\r\n 265:     const ctx: PreconditionCtx = {\r\n 266:       task: this.state(taskId),\r\n 267:       event,\r\n 268:       auth,\r\n 269:       payload,\r\n 270:       has: (type) => t.seen.has(type),\r\n 271:       approval: (id) => this.approvals.get(id),\r\n 272:       liveLeases: () => [...this.tasks.values()].filter((x) => x.lease && !this.isExpired(x.lease.expiresAt)).length,\r\n 273:     };\r\n 274:     for (const id of edge.preconditions) {\r\n 275:       if (!this.checkers[id]!(ctx)) throw new PreconditionFailed(id);\r\n 276:     }\r\n 277:     let to: TaskState;\r\n 278:     if (edge.to === \"$resume\") {\r\n 279:       if (!t.resumeFrom) throw new PreconditionFailed(\"approval_decided\");\r\n 280:       to = t.resumeFrom;\r\n 281:     } else to = edge.to;\r\n 282: \r\n 283:     const body: Record<string, unknown> = { from: t.status, to, reason: event };\r\n 284:     for (const k of USER_PAYLOAD_KEYS) if (k in payload && k !== \"evidenceIds\") body[k] = payload[k];\r\n 285:     if (event === \"approval_needed\" || event === \"git_conflict\" || event === \"recovery_review\" || event === \"compare_blocked\") {\r\n 286:       if (typeof payload.requestId === \"string\") body.request_id = payload.requestId;\r\n 287:     }\r\n 288:     if (auth.kind === \"daemon\") body.request_id = auth.requestId;\r\n 289:     if (to === \"REWORK\" && (event === \"review_failed\" || event === \"evidence_missing\")) body.iteration = t.iteration + 1;\r\n 290:     if (event === \"evidence_ok\") body.evidence_ids = payload.evidenceIds;\r\n 291: \r\n 292:     this.store.append({\r\n 293:       type: \"TaskTransition\",\r\n 294:       taskId,\r\n 295:       ...(auth.kind === \"lease\" && { fencingToken: auth.token, agentRunId: t.lease?.runId }),\r\n 296:       ...(auth.kind === \"daemon\" && { correlationId: auth.requestId }),\r\n 297:       payload: body,\r\n 298:     });\r\n 299:     // BLOCKED�����ᡤQUEUED �� ���� ���� run �� lease �� ���� ���� �� ����\r\n 300:     if (t.lease && (to === \"BLOCKED\" || to === \"QUEUED\" || this.table.terminal.includes(to))) {\r\n 301:       this.store.append({ type: \"LeaseExpired\", taskId, agentRunId: t.lease.runId, payload: { run_id: t.lease.runId, token: t.lease.fencingToken, reason: \"released\" } });\r\n 302:     }\r\n 303:     return to;\r\n 304:   }\r\n 305: \r\n 306:   // ---------- ���� ----------\r\n 307:   private get(taskId: string): TaskRecord {\r\n 308:     const t = this.tasks.get(taskId);\r\n 309:     if (!t) throw new UnknownTask(taskId);\r\n 310:     return t;\r\n 311:   }\r\n 312:   private isExpired(expiresAt: string): boolean {\r\n 313:     return Date.parse(expiresAt) <= this.now();\r\n 314:   }\r\n 315:   private rejectStale(t: TaskRecord, token: number): never {\r\n 316:     const current = t.lease && !this.isExpired(t.lease.expiresAt) ? t.lease.fencingToken : null;\r\n 317:     this.store.append({ type: \"StaleWriterRejected\", taskId: t.id, fencingToken: token, payload: { task_id: t.id, token, current } });\r\n 318:     throw new StaleWriterError(token, current);\r\n 319:   }\r\n 320: }\r\n","exit_code":0,"status":"completed"}}
