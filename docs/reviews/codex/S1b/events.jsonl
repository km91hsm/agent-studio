or?: { message: string } | null;\r\n  32: }\r\n  33: \r\n  34: export interface ServerRequest {\r\n  35:   id: number | string;\r\n  36:   method: string;\r\n  37:   params: Record<string, unknown>;\r\n  38: }\r\n  39: \r\n  40: export interface Notification {\r\n  41:   method: string;\r\n  42:   params: Record<string, unknown>;\r\n  43:   emittedAtMs?: number;\r\n  44: }\r\n  45: \r\n  46: export interface TurnStartOptions {\r\n  47:   approvalPolicy?: ApprovalPolicy;\r\n  48:   sandboxPolicy?: SandboxPolicy;\r\n  49:   cwd?: string;\r\n  50:   model?: string;\r\n  51:   config?: Record<string, unknown>;\r\n  52: }\r\n  53: \r\n  54: export interface RecordedEvent {\r\n  55:   t: number;\r\n  56:   dir: \"out\" | \"in\";\r\n  57:   msg: unknown;\r\n  58: }\r\n  59: \r\n  60: export class RpcError extends Error {\r\n  61:   constructor(public readonly code: number, message: string, public readonly data?: unknown) {\r\n  62:     super(message);\r\n  63:   }\r\n  64: }\r\n  65: \r\n  66: export interface ClientOptions {\r\n  67:   label?: string;\r\n  68:   codexBin?: string;\r\n  69:   /** `-c key=value` �������̵�(����� config.toml ������ ��Ģ) */\r\n  70:   configOverrides?: string[];\r\n  71:   env?: NodeJS.ProcessEnv;\r\n  72:   requestTimeoutMs?: number;\r\n  73: }\r\n  74: \r\n  75: export class AppServerClient {\r\n  76:   private proc: ChildProcessWithoutNullStreams | null = null;\r\n  77:   private nextId = 1;\r\n  78:   private pending = new Map<number, { resolve: (v: unknown) => void; reject: (e: Error) => void; method: string }>();\r\n  79:   private events = new EventEmitter();\r\n  80:   private serverRequestHandlers: ((req: ServerRequest) => void)[] = [];\r\n  81:   private recorded: RecordedEvent[] = [];\r\n  82:   private usage = new Map<string, { count: number; last: unknown; total: unknown }>();\r\n  83:   private stderrBuf = \"\";\r\n  84:   private exitInfo: { code: number | null; signal: string | null } | null = null;\r\n  85:   readonly label: string;\r\n  86: \r\n  87:   constructor(private readonly opts: ClientOptions = {}) {\r\n  88:     this.label = opts.label ?? \"codex-app-server\";\r\n  89:     this.events.setMaxListeners(100);\r\n  90:   }\r\n  91: \r\n  92:   /** ���μ��� �⵿ + `initialize` �� `initialized` */\r\n  93:   async initialize(capabilities?: { experimentalApi?: boolean }): Promise<unknown> {\r\n  94:     this.start();\r\n  95:     const result = await this.request(\"initialize\", {\r\n  96:       clientInfo: { name: \"agent-studio-spike\", title: \"Agent Studio P00 spike\", version: \"0.0.0\" },\r\n  97:       ...(capabilities ? { capabilities } : {}),\r\n  98:     });\r\n  99:     this.notify(\"initialized\", {});\r\n 100:     return result;\r\n 101:   }\r\n 102: \r\n 103:   start(): void {\r\n 104:     if (this.proc) return;\r\n 105:     const bin = this.opts.codexBin ?? process.env.CODEX_BIN ?? \"codex\";\r\n 106:     const args = [\"app-server\"];\r\n 107:     for (const o of this.opts.configOverrides ?? []) args.push(\"-c\", o);\r\n 108:     this.proc = spawn(bin, args, {\r\n 109:       stdio: [\"pipe\", \"pipe\", \"pipe\"],\r\n 110:       env: { ...process.env, ...this.opts.env },\r\n 111:       windowsHide: true,\r\n 112:     });\r\n 113:     this.proc.on(\"exit\", (code, signal) => {\r\n 114:       this.exitInfo = { code, signal };\r\n 115:       for (const [id, p] of this.pending) {\r\n 116:         p.reject(new Error(`[${this.label}] app-server exited (code=${code}, signal=${signal}) before response to ${p.method}#${id}`));\r\n 117:       }\r\n 118:       this.pending.clear();\r\n 119:       this.events.emit(\"exit\", this.exitInfo);\r\n 120:     });\r\n 121:     this.proc.stderr.setEncoding(\"utf8\");\r\n 122:     this.proc.stderr.on(\"data\", (d: string) => {\r\n 123:       this.stderrBuf += d;\r\n 124:       if (this.stderrBuf.length > 200_000) this.stderrBuf = this.stderrBuf.slice(-100_000);\r\n 125:     });\r\n 126:     const rl = createInterface({ input: this.proc.stdout });\r\n 127:     rl.on(\"line\", (line) => this.onLine(line));\r\n 128:   }\r\n 129: \r\n 130:   private onLine(line: string): void {\r\n 131:     if (!line.trim()) return;\r\n 132:     let msg: Record<string, unknown>;\r\n 133:     try {\r\n 134:       msg = JSON.parse(line) as Record<string, unknown>;\r\n 135:     } catch {\r\n 136:       this.recorded.push({ t: Date.now(), dir: \"in\", msg: { unparsed: line } });\r\n 137:       return;\r\n 138:     }\r\n 139:     this.recorded.push({ t: Date.now(), dir: \"in\", msg });\r\n 140:     const hasId = msg.id !== undefined && msg.id !== null;\r\n 141:     if (hasId && typeof msg.method === \"string\") {\r\n 142:       const req: ServerRequest = { id: msg.id as number | string, method: msg.method, params: (msg.params as Record<string, unknown>) ?? {} };\r\n 143:       this.events.emit(\"serverRequest\", req);\r\n 144:       for (const h of this.serverRequestHandlers) h(req);\r\n 145:       return;\r\n 146:     }\r\n 147:     if (hasId) {\r\n 148:       const p = this.pending.get(msg.id as number);\r\n 149:       if (!p) return;\r\n 150:       this.pending.delete(msg.id as number);\r\n 151:       if (msg.error) {\r\n 152:         const e = msg.error as { code?: number; message?: string; data?: unknown };\r\n 153:         p.reject(new RpcError(e.code ?? -1, `[${this.label}] ${p.method}: ${e.message ?? \"error\"}`, e.data));\r\n 154:       } else {\r\n 155:         p.resolve(msg.result);\r\n 156:       }\r\n 157:       return;\r\n 158:     }\r\n 159:     if (typeof msg.method === \"string\") {\r\n 160:       const n: Notification = { method: msg.method, params: (msg.params as Record<string, unknown>) ?? {}, emittedAtMs: msg.emittedAtMs as number | undefined };\r\n 161:       if (n.method === \"thread/tokenUsage/updated\") {\r\n 162:         const tid = n.params.threadId as string;\r\n 163:         const tu = n.params.tokenUsage as { last: unknown; total: unknown };\r\n 164:         const cur = this.usage.get(tid) ?? { count: 0, last: undefined, total: undefined };\r\n 165:         this.usage.set(tid, { count: cur.count + 1, last: tu?.last, total: tu?.total });\r\n 166:       }\r\n 167:       this.events.emit(\"notification\", n);\r\n 168:       this.events.emit(`notification:${n.method}`, n);\r\n 169:     }\r\n 170:   }\r\n 171: \r\n 172:   private send(msg: Record<string, unknown>): void {\r\n 173:     if (!this.proc) throw new Error(`[${this.label}] not started`);\r\n 174:     this.recorded.push({ t: Date.now(), dir: \"out\", msg });\r\n 175:     this.proc.stdin.write(JSON.stringify(msg) + \"\\n\");\r\n 176:   }\r\n 177: \r\n 178:   request<T = unknown>(method: string, params: Record<string, unknown> = {}, timeoutMs = this.opts.requestTimeoutMs ?? 120_000): Promise<T> {\r\n 179:     const id = this.nextId++;\r\n 180:     return new Promise<T>((resolve, reject) => {\r\n 181:       const timer = setTimeout(() => {\r\n 182:         if (this.pending.delete(id)) reject(new Error(`[${this.label}] ${method}#${id} timed out after ${timeoutMs}ms`));\r\n 183:       }, timeoutMs);\r\n 184:       this.pending.set(id, {\r\n 185:         method,\r\n 186:         resolve: (v) => {\r\n 187:           clearTimeout(timer);\r\n 188:           resolve(v as T);\r\n 189:         },\r\n 190:         reject: (e) => {\r\n 191:           clearTimeout(timer);\r\n 192:           reject(e);\r\n 193:         },\r\n 194:       });\r\n 195:       this.send({ id, method, params });\r\n 196:     });\r\n 197:   }\r\n 198: \r\n 199:   notify(method: string, params: Record<string, unknown> = {}): void {\r\n 200:     this.send({ method, params });\r\n 201:   }\r\n 202: \r\n 203:   // ---- ������Ŭ���̾�Ʈ ��û ----\r\n 204:   onServerRequest(cb: (req: ServerRequest) => void): () => void {\r\n 205:     this.serverRequestHandlers.push(cb);\r\n 206:     return () => {\r\n 207:       this.serverRequestHandlers = this.serverRequestHandlers.filter((h) => h !== cb);\r\n 208:     };\r\n 209:   }\r\n 210: \r\n 211:   respond(requestId: number | string, result: Record<string, unknown>): void {\r\n 212:     this.send({ id: requestId, result });\r\n 213:   }\r\n 214: \r\n 215:   respondError(requestId: number | string, code: number, message: string): void {\r\n 216:     this.send({ id: requestId, error: { code, message } });\r\n 217:   }\r\n 218: \r\n 219:   // ---- �˸� ���� ----\r\n 220:   onNotification(method: string, cb: (n: Notification) => void): () => void {\r\n 221:     const ev = `notification:${method}`;\r\n 222:     this.events.on(ev, cb);\r\n 223:     return () => this.events.off(ev, cb);\r\n 224:   }\r\n 225: \r\n 226:   waitForNotification(method: string, pred: (n: Notification) => boolean, timeoutMs = 10 * 60_000): Promise<Notification> {\r\n 227:     return new Promise((resolve, reject) => {\r\n 228:       const off = this.onNotification(method, (n) => {\r\n 229:         if (pred(n)) {\r\n 230:           clearTimeout(timer);\r\n 231:           off();\r\n 232:           offExit();\r\n 233:           resolve(n);\r\n 234:         }\r\n 235:       });\r\n 236:       const onExit = () => {\r\n 237:         clearTimeout(timer);\r\n 238:         off();\r\n 239:         reject(new Error(`[${this.label}] app-server exited while waiting for ${method}\\n--- stderr tail ---\\n${this.stderrTail()}`));\r\n 240:       };\r\n 241:       const offExit = () => this.events.off(\"exit\", onExit);\r\n 242:       this.events.once(\"exit\", onExit);\r\n 243:       const timer = setTimeout(() => {\r\n 244:         off();\r\n 245:         offExit();\r\n 246:         reject(new Error(`[${this.label}] waiting for ${method} timed out after ${timeoutMs}ms`));\r\n 247:       }, timeoutMs);\r\n 248:     });\r\n 249:   }\r\n 250: \r\n 251:   // ---- �����塤�� ----\r\n 252:   async threadStart(cwd: string, extra: Record<string, unknown> = {}): Promise<{ threadId: string; raw: unknown }> {\r\n 253:     const res = await this.request<{ thread: { id: string } }>(\"thread/start\", { cwd, ...extra });\r\n 254:     return { threadId: res.thread.id, raw: res };\r\n 255:   }\r\n 256: \r\n 257:   async turnStart(threadId: string, input: UserInput[], opts: TurnStartOptions = {}): Promise<Turn> {\r\n 258:     const res = await this.request<{ turn: Turn }>(\"turn/start\", { threadId, input, ...opts });\r\n 259:     return res.turn;\r\n 260:   }\r\n 261: \r\n 262:   waitForTurnCompleted(threadId: string, turnId: string, timeoutMs?: number): Promise<{ turn: Turn }> {\r\n 263:     return this.waitForNotification(\r\n 264:       \"turn/completed\",\r\n 265:       (n) => n.params.threadId === threadId && (n.params.turn as Turn)?.id === turnId,\r\n 266:       timeoutMs,\r\n 267:     ).then((n) => ({ turn: n.params.turn as Turn }));\r\n 268:   }\r\n 269: \r\n 270:   async turnSteer(threadId: string, expectedTurnId: string, text: string): Promise<unknown> {\r\n 271:     return this.request(\"turn/steer\", { threadId, expectedTurnId, input: [{ type: \"text\", text }] });\r\n 272:   }\r\n 273: \r\n 274:   async turnInterrupt(threadId: string, turnId: string): Promise<unknown> {\r\n 275:     return this.request(\"turn/interrupt\", { threadId, turnId });\r\n 276:   }\r\n 277: \r\n 278:   async threadResume(threadId: string, extra: Record<string, unknown> = {}): Promise<unknown> {\r\n 279:     return this.request(\"thread/resume\", { threadId, ...extra });\r\n 280:   }\r\n 281: \r\n 282:   async threadFork(threadId: string, lastTurnId?: string, extra: Record<string, unknown> = {}): Promise<unknown> {\r\n 283:     return this.request(\"thread/fork\", { threadId, ...(lastTurnId ? { lastTurnId } : {}), ...extra });\r\n 284:   }\r\n 285: \r\n 286:   async skillsList(cwds: string[] = [], forceReload = false): Promise<unknown> {\r\n 287:     return this.request(\"skills/list\", { cwds, forceReload });\r\n 288:   }\r\n 289: \r\n 290:   /** experimental(`initialize.capabilities.experimentalApi`) ? opt-in ���̴� �źεǴ��� S1b���� ���� */\r\n 291:   async threadQueueAdd(threadId: string, clientUserMessageId: string, text: string): Promise<unknown> {\r\n 292:     return this.request(\"thread/queue/add\", { threadId, clientUserMessageId, input: [{ type: \"text\", text }] });\r\n 293:   }\r\n 294: \r\n 295:   /** �ñ׳� ���� �� ���� ���(V14 ������). Windows������ Node�� ��� �ñ׳��� TerminateProcess�� ó���Ѵ�. */\r\n 296:   killAndWait(signal: NodeJS.Signals, timeoutMs = 5000): Promise<{ code: number | null; signal: string | null; killed: boolean; elapsedMs: number } | null> {\r\n 297:     const p = this.proc;\r\n 298:     if (!p) return Promise.resolve(this.exitInfo ? { ...this.exitInfo, killed: false, elapsedMs: 0 } : null);\r\n 299:     this.proc = null;\r\n 300:     const t0 = Date.now();\r\n 301:     return new Promise((resolve) => {\r\n 302:       const timer = setTimeout(() => {\r\n 303:         p.kill();\r\n 304:         resolve(null);\r\n 305:       }, timeoutMs);\r\n 306:       p.once(\"exit\", (code, sig) => {\r\n 307:         clearTimeout(timer);\r\n 308:         resolve({ code, signal: sig, killed: p.killed, elapsedMs: Date.now() - t0 });\r\n 309:       });\r\n 310:       p.kill(signal);\r\n 311:     });\r\n 312:   }\r\n 313: \r\n 314:   // ---- ���� ----\r\n 315:   tokenUsage(threadId: string): { count: number; last: unknown; total: unknown } {\r\n 316:     return this.usage.get(threadId) ?? { count: 0, last: undefined, total: undefined };\r\n 317:   }\r\n 318: \r\n 319:   recording(): RecordedEvent[] {\r\n 320:     return this.recorded;\r\n 321:   }\r\n 322: \r\n 323:   stderrTail(n = 4000): string {\r\n 324:     return this.stderrBuf.slice(-n);\r\n 325:   }\r\n 326: \r\n 327:   get exited(): { code: number | null; signal: string | null } | null {\r\n 328:     return this.exitInfo;\r\n 329:   }\r\n 330: \r\n 331:   get pid(): number | undefined {\r\n 332:     return this.proc?.pid;\r\n 333:   }\r\n 334: \r\n 335:   /** stdin ���� �� ���� ���� ��� �� ������ �� kill */\r\n 336:   async close(graceMs = 3000): Promise<void> {\r\n 337:     const p = this.proc;\r\n 338:     if (!p) return;\r\n 339:     this.proc = null;\r\n 340:     if (this.exitInfo) return;\r\n 341:     await new Promise<void>((resolve) => {\r\n 342:       const timer = setTimeout(() => {\r\n 343:         p.kill();\r\n 344:         resolve();\r\n 345:       }, graceMs);\r\n 346:       p.once(\"exit\", () => {\r\n 347:         clearTimeout(timer);\r\n 348:         resolve();\r\n 349:       });\r\n 350:       p.stdin.end();\r\n 351:     });\r\n 352:   }\r\n 353: }\r\n","exit_code":0,"status":"completed"}}
