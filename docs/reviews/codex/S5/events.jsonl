{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command 'rg -n \"''^\" \"spikes/s5-daemon/launcher.ts\"'","aggregated_output":"1:/**\n2: * S5 — launcher(Shell 역할): 락 파일 발견·검증(pid·startedAt·nonce) → 재접속 또는 detached spawn.\n3: * CLI: node --import tsx launcher.ts --dir <stateDir> --spawn-and-exit   (spawn 후 즉시 종료 — 앱 종료 시나리오)\n4: */\n5:import { execFileSync, spawn } from \"node:child_process\";\n6:import { randomBytes } from \"node:crypto\";\n7:import { existsSync, mkdirSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\n8:import { join } from \"node:path\";\n9:import { fileURLToPath } from \"node:url\";\n10:\n11:export const PROTOCOL_VERSION = 1;\n12:export interface LockFile {\n13:  pid: number;\n14:  startedAt: string;\n15:  nonce: string;\n16:  port: number;\n17:  protocolVersion: number;\n18:}\n19:export type LockAssessment = { verdict: \"live\" } | { verdict: \"connectable\" } | { verdict: \"stale\"; reason: \"pid_gone\" | \"pid_reused\" | \"nonce_mismatch\" };\n20:export interface DaemonHandle {\n21:  pid: number;\n22:  startedAt: string;\n23:  nonce: string;\n24:  port: number;\n25:  /** 토큰 참조(제품: 키링 항목 id; 스파이크: 토큰 파일 경로) */\n26:  tokenRef: string;\n27:  assessment?: LockAssessment;\n28:  spawned: boolean;\n29:}\n30:export interface ProcessInfo {\n31:  pid: number;\n32:  ppid: number;\n33:  startedAt: string;\n34:  name: string;\n35:}\n36:\n37:const DAEMON = fileURLToPath(new URL(\"./daemon.ts\", import.meta.url));\n38:const REPO_ROOT = fileURLToPath(new URL(\"../../\", import.meta.url));\n39:const START_TOLERANCE_MS = 2_000;\n40:\n41:/** 순수 판정: 락 파일 vs OS 관찰(pid 생존·생성 시각)·hello nonce */\n42:export function assessLock(lock: LockFile, probe: { pidAlive: boolean; processStartedAt: string | null; helloNonce: string | null }): LockAssessment {\n43:  if (!probe.pidAlive) return { verdict: \"stale\", reason: \"pid_gone\" };\n44:  if (!probe.processStartedAt || Math.abs(Date.parse(probe.processStartedAt) - Date.parse(lock.startedAt)) > START_TOLERANCE_MS) return { verdict: \"stale\", reason: \"pid_reused\" };\n45:  if (probe.helloNonce === null) return { verdict: \"connectable\" };\n46:  if (probe.helloNonce !== lock.nonce) return { verdict: \"stale\", reason: \"nonce_mismatch\" };\n47:  return { verdict: \"live\" };\n48:}\n49:\n50:export function readLock(stateDir: string): LockFile | null {\n51:  const p = join(stateDir, \"daemon.lock\");\n52:  if (!existsSync(p)) return null;\n53:  try {\n54:    return JSON.parse(readFileSync(p, \"utf8\")) as LockFile;\n55:  } catch {\n56:    return null;\n57:  }\n58:}\n59:\n60:/** 프로세스 목록(pid, ppid, OS 생성 시각) — Windows CIM. 자손 0 단언·PID 재사용 감지의 관찰 출처 */\n61:export function listProcesses(): ProcessInfo[] {\n62:  if (process.platform !== \"win32\") throw new Error(\"listProcesses: win32 only in this spike\");\n63:  const out = execFileSync(\n64:    \"pwsh\",\n65:    [\"-NoProfile\", \"-Command\", \"Get-CimInstance Win32_Process | Select-Object @{n='pid';e={$_.ProcessId}},@{n='ppid';e={$_.ParentProcessId}},@{n='startedAt';e={if($_.CreationDate){$_.CreationDate.ToUniversalTime().ToString('o')}else{''}}},@{n='name';e={$_.Name}} | ConvertTo-Json -Compress\"],\n66:    { encoding: \"utf8\", timeout: 30_000, maxBuffer: 16 * 1024 * 1024 },\n67:  );\n68:  return JSON.parse(out) as ProcessInfo[];\n69:}\n70:\n71:export function probeProcess(pid: number): { pidAlive: boolean; processStartedAt: string | null } {\n72:  const p = listProcesses().find((x) => x.pid === pid);\n73:  return { pidAlive: !!p, processStartedAt: p?.startedAt ?? null };\n74:}\n75:\n76:export interface DaemonClient {\n77:  welcome: { seq: number; pid: number; nonce: string; protocolVersion: number };\n78:  request<T = Record<string, unknown>>(msg: Record<string, unknown>): Promise<T>;\n79:  events: number[];\n80:  close(): void;\n81:}\n82:\n83:/** WS 접속 + hello 핸드셰이크(토큰·프로토콜 버전). 거부되면 close code로 reject */\n84:export function connectDaemon(stateDir: string, lock: LockFile, opts: { token?: string } = {}): Promise<DaemonClient> {\n85:  const token = opts.token ?? readFileSync(join(stateDir, \"token\"), \"utf8\").trim();\n86:  return new Promise((resolve, reject) => {\n87:    const ws = new WebSocket(`ws://127.0.0.1:${lock.port}/`);\n88:    const pending = new Map<number, (v: unknown) => void>();\n89:    let nextId = 1;\n90:    let welcomed = false;\n91:    const events: number[] = [];\n92:    ws.onopen = () => ws.send(JSON.stringify({ type: \"hello\", token, protocolVersion: PROTOCOL_VERSION }));\n93:    ws.onerror = () => reject(new Error(\"ws error\"));\n94:    ws.onclose = (ev) => {\n95:      if (!welcomed) reject(new Error(`closed before welcome: ${ev.code} ${ev.reason}`));\n96:    };\n97:    ws.onmessage = (ev) => {\n98:      const msg = JSON.parse(String(ev.data)) as { type?: string; id?: number; seq?: number };\n99:      if (msg.type === \"welcome\" && !welcomed) {\n100:        welcomed = true;\n101:        resolve({\n102:          welcome: msg as DaemonClient[\"welcome\"],\n103:          events,\n104:          request<T>(body: Record<string, unknown>) {\n105:            const id = nextId++;\n106:            return new Promise<T>((res) => {\n107:              pending.set(id, res as (v: unknown) => void);\n108:              ws.send(JSON.stringify({ id, ...body }));\n109:            });\n110:          },\n111:          close: () => ws.close(),\n112:        });\n113:        return;\n114:      }\n115:      if (msg.type === \"event\") events.push(msg.seq!);\n116:      else if (msg.id !== undefined) pending.get(msg.id)?.(msg), pending.delete(msg.id);\n117:    };\n118:  });\n119:}\n120:\n121:/** detached spawn: 부모가 종료돼도 데몬은 남는다. 락 파일이 나타날 때까지 기다린 뒤 핸들 반환 */\n122:export async function spawnDaemon(stateDir: string): Promise<DaemonHandle> {\n123:  mkdirSync(stateDir, { recursive: true });\n124:  const tokenRef = join(stateDir, \"token\");\n125:  if (!existsSync(tokenRef)) writeFileSync(tokenRef, randomBytes(24).toString(\"hex\"));\n126:  rmSync(join(stateDir, \"daemon.lock\"), { force: true });\n127:  const child = spawn(process.execPath, [\"--import\", \"tsx\", DAEMON, \"--dir\", stateDir], { detached: true, stdio: \"ignore\", windowsHide: true, cwd: REPO_ROOT });\n128:  child.unref();\n129:  const deadline = Date.now() + 20_000;\n130:  while (Date.now() < deadline) {\n131:    const lock = readLock(stateDir);\n132:    if (lock && lock.pid === child.pid) return { ...lock, tokenRef, spawned: true };\n133:    await new Promise((r) => setTimeout(r, 200));\n134:  }\n135:  throw new Error(`daemon lock did not appear within 20s (pid ${child.pid})`);\n136:}\n137:\n138:/** Shell의 ensureDaemon: 락 검증 → 재접속(live) 또는 stale 정리 후 spawn */\n139:export async function ensureDaemon(stateDir: string): Promise<DaemonHandle> {\n140:  const lock = readLock(stateDir);\n141:  if (lock) {\n142:    const probe = probeProcess(lock.pid);\n143:    let assessment = assessLock(lock, { ...probe, helloNonce: null });\n144:    if (assessment.verdict === \"connectable\") {\n145:      try {\n146:        const c = await connectDaemon(stateDir, lock);\n147:        assessment = assessLock(lock, { ...probe, helloNonce: c.welcome.nonce });\n148:        c.close();\n149:      } catch {\n150:        assessment = { verdict: \"stale\", reason: \"nonce_mismatch\" };\n151:      }\n152:    }\n153:    if (assessment.verdict === \"live\") return { ...lock, tokenRef: join(stateDir, \"token\"), assessment, spawned: false };\n154:    rmSync(join(stateDir, \"daemon.lock\"), { force: true }); // stale 락 정리(재부팅·PID 재사용·nonce 불일치)\n155:    const h = await spawnDaemon(stateDir);\n156:    return { ...h, assessment };\n157:  }\n158:  return spawnDaemon(stateDir);\n159:}\n160:\n161:// CLI\n162:if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {\n163:  const args = process.argv.slice(2);\n164:  const dir = args[args.indexOf(\"--dir\") + 1];\n165:  if (!dir) throw new Error(\"--dir required\");\n166:  if (args.includes(\"--spawn-and-exit\")) {\n167:    spawnDaemon(dir).then((h) => {\n168:      process.stdout.write(JSON.stringify(h) + \"\\n\");\n169:      process.exit(0); // 앱 종료 시나리오: 부모 즉시 종료\n170:    });\n171:  } else {\n172:    ensureDaemon(dir).then((h) => {\n173:      process.stdout.write(JSON.stringify(h) + \"\\n\");\n174:      process.exit(0);\n175:    });\n176:  }\n177:}\n","exit_code":0,"status":"completed"}}
