({ agent: \"claude\", kind, expectedLead: expected, chosen: cs.skillCalls, matchesExpected: cs.skillCalls.some((c) => new RegExp(`^(${expected})$`).test(c)), dirty: cr.status(), ...summarizeClaude(cs) });\n145:      const xr = newRepo(`codex-auto-${kind}`);\n146:      const xs = await runCodex({ label: `codex-auto-${kind}`, cwd: xr.dir, input: [{ type: \"text\", text: prompt }] });\n147:      saveCodex(`codex-auto-${kind}`, xs);\n148:      const obs = observationsFromCodex(xs.items, xr.dir, LEAD_SKILLS);\n149:      const chosen = [...new Set(obs.filter((o) => o.value.startsWith(\"skill_invoked:\")).map((o) => o.value.slice(\"skill_invoked:\".length)))];\n150:      const mentioned = LEAD_SKILLS.filter((n) => xs.finalText.includes(n) || xs.items.some((i) => (i.text ?? \"\").includes(n)));\n151:      rows.push({ agent: \"codex\", kind, expectedLead: expected, chosen, mentionedSkills: mentioned, matchesExpected: chosen.some((c) => new RegExp(`^(${expected})$`).test(c)), dirty: xr.status(), ...summarizeCodex(xs) });\n152:    }\n153:    observations.autoSelection = rows;\n154:    for (const r of rows) {\n155:      expect(Array.isArray(r.chosen)).toBe(true);\n156:      expect(typeof r.matchesExpected).toBe(\"boolean\");\n157:    }\n158:  }, 40 * 60_000);\n159:\n160:  it(\"(f1) 충돌 실험 TDD: 같은 버그를 Claude가 tdd(mattpocock) 스킬로 수정 — (c)와 테스트 선행·재작업 비교\", async () => {\n161:    const repo = newRepo(\"claude-mp-tdd\");\n162:    const s = await runClaude({ label: \"claude-explicit-mp-tdd\", cwd: repo.dir, prompt: `Use the tdd skill (invoke it with the Skill tool before doing anything else) and follow it strictly. ${SUM_BUG}` });\n163:    saveClaude(\"claude-explicit-mp-tdd\", s);\n164:    const obs = observationsFromClaude(s.toolUses, repo.dir);\n165:    const grade = gradeClaude({ skill: \"tdd\", initSkills: s.initSkills, explicit: true, toolUses: s.toolUses.map((t) => ({ name: t.name, input: t.input, isError: t.isError })) });\n166:    const tests = runTests(repo.dir);\n167:    o