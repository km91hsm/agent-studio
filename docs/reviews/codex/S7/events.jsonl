{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n '\"'^|.'\"' spikes/s7-skills/signatures.test.ts\"","aggregated_output":"1:/**\n2: * S7 Step 5 — 스킬 고유 절차 시그니처(EVIDENCE_SPEC §3 공통 행 스키마)와 증거 등급 판정 로직(순수, CI)\n3: * 시그니처: docs/agent-studio/skill-signatures/<skill>.json — 주도 스킬 9개(Codex 설치 8 + brainstorming)\n4: */\n5:import { describe, expect, it } from \"vitest\";\n6:import { existsSync, readFileSync } from \"node:fs\";\n7:import { join } from \"node:path\";\n8:import { fileURLToPath } from \"node:url\";\n9:import { gradeClaude, gradeCodex, matchSignature, validateSignature, type Observation, type SkillSignature } from \"./evidence.js\";\n10:import { LEAD_SKILLS } from \"./install-codex-skills.js\";\n11:\n12:const SIG_DIR = fileURLToPath(new URL(\"../../docs/agent-studio/skill-signatures/\", import.meta.url));\n13:const NINE = [...LEAD_SKILLS, \"brainstorming\"];\n14:\n15:describe(\"S7 skill signatures (CI)\", () => {\n16:  it(\"주도 스킬 9개의 시그니처 파일이 존재하고 스키마를 만족한다\", () => {\n17:    expect(LEAD_SKILLS).toHaveLength(8);\n18:    for (const name of NINE) {\n19:      const p = join(SIG_DIR, `${name}.json`);\n20:      expect(existsSync(p), p).toBe(true);\n21:      const sig = JSON.parse(readFileSync(p, \"utf8\")) as SkillSignature;\n22:      expect(validateSignature(sig), name).toEqual([]);\n23:      expect(sig.skill_id.endsWith(`/${name}`), `${name} skill_id`).toBe(true);\n24:      expect(sig.steps.some((s) => s.required), `${name} has required step`).toBe(true);\n25:      expect(sig.reviewed_by, `${name} reviewed_by is pending codex review`).toBeNull();\n26:    }\n27:  });\n28:\n29:  it(\"validateSignature는 필수 필드·순서·artifact_glob|event_pattern 택일을 검사한다\", () => {\n30:    const ok: SkillSignature = { skill_id: \"x/y\", skill_commit: \"abc1234\", version: 1, steps: [{ order: 1, event_pattern: \"skill_invoked:y\", required: true }], author: \"claude\", reviewed_by: null, created_seq: 0 };\n31:    expect(validateSignature(ok)).toEqual([]);\n32:    expect(validateSignature({ ...ok, steps: [] })).toContain(\"steps: empty\");\n33:    expect(validateSignature({ ...ok, steps: [{ order: 2, event_pattern: \"a\", required: true }] })).toContain(\"steps[0].order: expected 1\");\n34:    expect(validateSignature({ ...ok, steps: [{ order: 1, required: true }] })).toContain(\"steps[0]: artifact_glob or event_pattern required\");\n35:    expect(validateSignature({ ...ok, steps: [{ order: 1, artifact_glob: \"*.ts\", event_pattern: \"x\", required: true }] })).toContain(\"steps[0]: artifact_glob and event_pattern are exclusive\");\n36:    expect(validateSignature({ ...ok, skill_commit: \"\" })).toContain(\"skill_commit: required\");\n37:  });\n38:\n39:  it(\"gradeClaude: 목록 부재→NOT_FOUND, 목록만→DISCOVERED, 명시 호출→INJECTION_ACCEPTED, Skill 도구 성공→LOAD_OBSERVED, 실패→FAILED\", () => {\n40:    const base = { skill: \"test-driven-development\", initSkills: [\"test-driven-development\", \"tdd\"] };\n41:    expect(gradeClaude({ ...base, initSkills: [], explicit: false, toolUses: [] })).toBe(\"NOT_FOUND\");\n42:    expect(gradeClaude({ ...base, explicit: false, toolUses: [] })).toBe(\"DISCOVERED\");\n43:    expect(gradeClaude({ ...base, explicit: true, toolUses: [] })).toBe(\"INJECTION_ACCEPTED\");\n44:    expect(gradeClaude({ ...base, explicit: true, toolUses: [{ name: \"Skill\", input: { skill: \"test-driven-development\" }, isError: false }] })).toBe(\"LOAD_OBSERVED\");\n45:    expect(gradeClaude({ ...base, explicit: false, toolUses: [{ name: \"Skill\", input: { skill: \"test-driven-development\" }, isError: false }] })).toBe(\"LOAD_OBSERVED\");\n46:    expect(gradeClaude({ ...base, explicit: true, toolUses: [{ name: \"Skill\", input: { skill: \"test-driven-development\" }, isError: true }] })).toBe(\"FAILED\");\n47:    expect(gradeClaude({ ...base, explicit: true, toolUses: [{ name: \"Skill\", input: { skill: \"tdd\" }, isError: false }] })).toBe(\"INJECTION_ACCEPTED\");\n48:  });\n49:\n50:  it(\"gradeCodex: 목록 부재→NOT_FOUND, 목록만→DISCOVERED, skill 입력 수락→INJECTION_ACCEPTED, 거부→FAILED, 절차 관찰→LOAD_OBSERVED\", () => {\n51:    expect(gradeCodex({ listed: false, injection: null, procedureObserved: false })).toBe(\"NOT_FOUND\");\n52:    expect(gradeCodex({ listed: true, injection: null, procedureObserved: false })).toBe(\"DISCOVERED\");\n53:    expect(gradeCodex({ listed: true, injection: \"accepted\", procedureObserved: false })).toBe(\"INJECTION_ACCEPTED\");\n54:    expect(gradeCodex({ listed: true, injection: \"rejected\", procedureObserved: false })).toBe(\"FAILED\");\n55:    expect(gradeCodex({ listed: true, injection: \"accepted\", procedureObserved: true })).toBe(\"LOAD_OBSERVED\");\n56:    expect(gradeCodex({ listed: true, injection: null, procedureObserved: true })).toBe(\"LOAD_OBSERVED\");\n57:  });\n58:\n59:  it(\"matchSignature: required 단계가 순서대로 관찰되면 inOrder, 순서가 어긋나면 false, 빠진 단계는 missingRequired\", () => {\n60:    const sig: SkillSignature = {\n61:      skill_id: \"obra/superpowers/test-driven-development\",\n62:      skill_commit: \"2ce8aa1\",\n63:      version: 1,\n64:      steps: [\n65:        { order: 1, artifact_glob: \"**/*.test.{js,mjs,ts}\", required: true },\n66:        { order: 2, event_pattern: \"test_run:fail\", required: true },\n67:        { order: 3, artifact_glob: \"**/*.{js,mjs,ts}\", required: true },\n68:        { order: 4, event_pattern: \"test_run:pass\", required: true },\n69:      ],\n70:      author: \"claude\",\n71:      reviewed_by: null,\n72:      created_seq: 0,\n73:    };\n74:    const good: Observation[] = [\n75:      { seq: 1, kind: \"artifact\", value: \"calc.test.mjs\" },\n76:      { seq: 2, kind: \"event\", value: \"test_run:fail\" },\n77:      { seq: 3, kind: \"artifact\", value: \"calc.js\" },\n78:      { seq: 4, kind: \"event\", value: \"test_run:pass\" },\n79:    ];\n80:    expect(matchSignature(sig, good)).toEqual({ observed: [1, 2, 3, 4], missingRequired: [], inOrder: true });\n81:    const swapped: Observation[] = [\n82:      { seq: 1, kind: \"artifact\", value: \"calc.js\" },\n83:      { seq: 2, kind: \"artifact\", value: \"calc.test.mjs\" },\n84:      { seq: 3, kind: \"event\", value: \"test_run:pass\" },\n85:    ];\n86:    const r = matchSignature(sig, swapped);\n87:    expect(r.inOrder).toBe(false);\n88:    expect(r.missingRequired).toEqual([2]);\n89:    // 테스트 파일은 artifact_glob \"**/*.{js,mjs,ts}\"에도 걸리지만 1단계 뒤에 나타난 구현 파일만 3단계로 센다\n90:    const testOnly: Observation[] = [{ seq: 1, kind: \"artifact\", value: \"calc.test.mjs\" }];\n91:    expect(matchSignature(sig, testOnly).observed).toEqual([1]);\n92:  });\n93:});\n","exit_code":0,"status":"completed"}}
