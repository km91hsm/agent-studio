ec/.test(xs.finalText) }), hasStandards: /## Standards/.test(xs.finalText), hasSpec: /## Spec/.test(xs.finalText), observations: xObs, dirty: cRepo.status(), ...summarizeCodex(xs) },\n203:      claude: { grade: gradeClaude({ skill: \"code-review\", initSkills: cs.initSkills, explicit: true, toolUses: cs.toolUses.map((t) => ({ name: t.name, input: t.input, isError: t.isError })) }), hasStandards: /## Standards/.test(cs.finalText), hasSpec: /## Spec/.test(cs.finalText), subagentCalls: subagentTools, dirty: xRepo.status(), ...summarizeClaude(cs) },\n204:    };\n205:    expect(xs.turnStatus).toBe(\"completed\");\n206:    expect(cRepo.status(), \"codex review must not modify files\").toEqual([]);\n207:    expect(xRepo.status(), \"claude review must not modify files\").toEqual([]);\n208:  }, 25 * 60_000);\n209:});\n","exit_code":0,"status":"completed"}}
