irs.length };\n67:    writeFileSync(RESULTS, mask(JSON.stringify(observations, null, 2)) + \"\\n\");\n68:  }, 120_000);\n69:\n70:  it(\"(a) C4: 주도 스킬 8종이 ~/.codex/skills 에 원본 해시 그대로 설치돼 있고 .system/config.toml/AGENTS.md는 불변이다(V35)\", () => {\n71:    expect(existsSync(C4_FIXTURE), \"install fixture — run `npx tsx spikes/s7-skills/install-codex-skills.ts` first\").toBe(true);\n72:    const fixture = JSON.parse(readFileSync(C4_FIXTURE, \"utf8\")) as { invariance: { before: Record<string, string>; after: Record<string, string> } };\n73:    const v = verifyInstalled();\n74:    observations.c4 = { verified: v, fixtureInvariance: fixture.invariance };\n75:    for (const name of LEAD_SKILLS) {\n76:      expect(v.skills[name]?.installed, `${name} installed`).toBe(true);\n77:      expect(v.skills[name]?.treeMatchesSource, `${name} tree == source`).toBe(true);\n78:      expect(v.skills[name]?.treeMatchesFixture, `${name} tree == fixture`).toBe(true);\n79:    }\n80:    expect(v.invariance.now, \"invariance now == before install\").toEqual(fixture.invariance.before);\n81:    expect(fixture.invariance.after).toEqual(fixture.invariance.before);\n82:    expect(v.openaiYamlSkipped, \"agents/openai.yaml not copied\").toBe(true);\n83:  });\n84:\n85:  it(\"(b) Codex skills/list{forceReload:true}에 8개가 모두 나타난다 → DISCOVERED\", async () => {\n86:    const client = new AppServerClient({ label: \"s7-skills-list\", configOverrides: [\"features.memories=false\"] });\n87:    try {\n88:      await client.initialize();\n89:      const raw = await client.skillsList([], true);\n90:      const parsed = parseSkillsList(raw);\n91:      codexSkillPaths = parsed.byName;\n92:      const sample = JSON.stringify(raw).slice(0, 1500);\n93:      observations.skillsList = { names: parsed.names, responseSample: sample, grades: Object.fromEntries(LEAD_SKILLS.map((n) => [n, gradeCodex({ listed: parsed.names.includes(n), injection: null, procedureObserved: false })])) };\n94:      mkdirSync(CODEX_FIX, { recursive: 