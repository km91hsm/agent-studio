{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command 'Get-Content spikes/_shared/sampleRepo.ts'","aggregated_output":"import { cpSync, mkdtempSync, readFileSync, rmSync, existsSync } from \"node:fs\";\r\nimport { tmpdir } from \"node:os\";\r\nimport { join } from \"node:path\";\r\nimport { execFileSync } from \"node:child_process\";\r\nimport { createHash } from \"node:crypto\";\r\nimport { fileURLToPath } from \"node:url\";\r\n\r\nconst FIXTURE = fileURLToPath(new URL(\"../fixtures/sample-node-repo/\", import.meta.url));\r\n\r\nexport interface SampleRepo {\r\n  dir: string;\r\n  /** git blob �ؽ�(sha1)�� ���� ���� �ĺ� */\r\n  blob(relPath: string): string;\r\n  /** ���� ���� + ������ ������ ���� ��� (`git status --porcelain`) */\r\n  status(): string[];\r\n  cleanup(): void;\r\n}\r\n\r\n/** �Ƚ�ó�� �ӽ� ���͸��� �����ϰ� git init + ù Ŀ�Ա��� �����. */\r\nexport function createSampleRepo(prefix = \"agent-studio-spike-\"): SampleRepo {\r\n  const dir = mkdtempSync(join(tmpdir(), prefix));\r\n  cpSync(FIXTURE, dir, { recursive: true });\r\n  const git = (...args: string[]) =>\r\n    execFileSync(\"git\", args, { cwd: dir, encoding: \"utf8\", stdio: [\"ignore\", \"pipe\", \"pipe\"] });\r\n  git(\"init\", \"-q\", \"-b\", \"main\");\r\n  git(\"config\", \"user.email\", \"spike@agent-studio.local\");\r\n  git(\"config\", \"user.name\", \"Agent Studio Spike\");\r\n  git(\"add\", \"-A\");\r\n  git(\"commit\", \"-q\", \"-m\", \"fixture: sample-node-repo\");\r\n  return {\r\n    dir,\r\n    blob(relPath) {\r\n      const data = readFileSync(join(dir, relPath));\r\n      return createHash(\"sha1\").update(`blob ${data.length}\\0`).update(data).digest(\"hex\");\r\n    },\r\n    status() {\r\n      return git(\"status\", \"--porcelain\", \"--untracked-files=all\").split(/\\r?\\n/).filter(Boolean);\r\n    },\r\n    cleanup() {\r\n      if (existsSync(dir)) rmSync(dir, { recursive: true, force: true, maxRetries: 5 });\r\n    },\r\n  };\r\n}\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command 'Get-Content spikes/_shared/mask.ts'","aggregated_output":"import { homedir, hostname, userInfo } from \"node:os\";\r\n\r\nconst THREAD_ID = /\\b01[0-9a-f]{6}-[0-9a-f]{4}-7[0-9a-f]{3}-[0-9a-f]{4}-[0-9a-f]{12}\\b/g;\r\nconst INSTALLATION_ID = /(\"installationId\"\\s*:\\s*\")[^\"]+(\")/g;\r\nconst TOKENS = /\\b(ghp_[A-Za-z0-9]{20,}|sk-ant-[A-Za-z0-9_-]{8,}|sk-[A-Za-z0-9]{32,}|xox[abp]-[A-Za-z0-9-]{8,}|AKIA[0-9A-Z]{16})\\b/g;\r\n\r\n/** ��ȭ �Ƚ�ó Ŀ�� �� ����ŷ: Ȩ ��Ρ�����ڸ���thread id����ū ����. */\r\nexport function mask(text: string): string {\r\n  const user = userInfo().username;\r\n  const home = homedir();\r\n  let out = text;\r\n  const bs = String.fromCharCode(92);\r\n  for (const h of [home, home.split(bs).join(bs + bs), home.split(bs).join(\"/\")]) {\r\n    out = out.split(h).join(\"<home>\");\r\n  }\r\n  if (user) out = out.split(user).join(\"<user>\");\r\n  const host = hostname();\r\n  if (host) out = out.split(host).join(\"<host>\");\r\n  return out.replace(THREAD_ID, \"<thread-id>\").replace(TOKENS, \"<secret>\").replace(INSTALLATION_ID, \"$1<installation-id>$2\");\r\n}\r\n\r\n/** ��ȭ �̺�Ʈ ��ȭ: MCP �⵿ ���� �˸��� �� error ����(HTML ç��������ū�� ���� ���ڿ�)�� �߶󳽴�. */\r\nexport function sanitizeEvents<T extends { msg: unknown }>(events: T[], maxErrorLen = 200): T[] {\r\n  return events.map((e) => {\r\n    const msg = e.msg as { method?: string; params?: { error?: unknown } } | undefined;\r\n    if (msg?.method === \"mcpServer/startupStatus/updated\" && typeof msg.params?.error === \"string\" && msg.params.error.length > maxErrorLen) {\r\n      const err = msg.params.error;\r\n      const cut = err.slice(0, maxErrorLen).replace(/<[^>]*$/, \"\");\r\n      return { ...e, msg: { ...msg, params: { ...msg.params, error: `${cut} <error-body-removed len=${err.length}>` } } };\r\n    }\r\n    return e;\r\n  });\r\n}\r\n","exit_code":0,"status":"completed"}}
