{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-studio.local/schemas/project-policy-v1.json",
  "title": "ProjectPolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "permissionMode", "rules"],
  "properties": {
    "v": { "const": 1 },
    "permissionMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude", "codex"],
      "properties": {
        "claude": { "enum": ["plan", "default", "acceptEdits", "auto", "bypassPermissions", "dontAsk"] },
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approvalPolicy", "sandbox"],
          "properties": {
            "approvalPolicy": { "enum": ["untrusted", "on-request", "never"] },
            "sandbox": { "enum": ["readOnly", "workspaceWrite"] }
          }
        }
      }
    },
    "autoModeConfirmed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combo", "at"],
      "properties": { "combo": { "type": "string", "minLength": 1 }, "at": { "type": "string", "minLength": 1 } }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_trust", "fs_write", "exec", "network", "git_remote", "db_change", "dep_install", "hook_enable", "mcp_call", "external_service", "deploy", "browser", "computer_use", "doc_export"],
      "properties": {
        "project_trust": { "$ref": "#/definitions/rule" },
        "fs_write": { "$ref": "#/definitions/rule" },
        "exec": { "$ref": "#/definitions/rule" },
        "network": { "$ref": "#/definitions/rule" },
        "git_remote": { "$ref": "#/definitions/rule" },
        "db_change": { "$ref": "#/definitions/rule" },
        "dep_install": { "$ref": "#/definitions/rule" },
        "hook_enable": { "$ref": "#/definitions/rule" },
        "mcp_call": { "$ref": "#/definitions/rule" },
        "external_service": { "$ref": "#/definitions/rule" },
        "deploy": { "$ref": "#/definitions/rule" },
        "browser": { "$ref": "#/definitions/rule" },
        "computer_use": { "$ref": "#/definitions/rule" },
        "doc_export": { "$ref": "#/definitions/rule" }
      }
    }
  },
  "definitions": {
    "verdict": { "enum": ["AUTO", "ASK", "ALWAYS_ASK", "DENY"] },
    "scope": { "enum": ["once", "project", "until_expiry"] },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pathOutsideWorktree": { "type": "boolean" },
        "readOnlyVerified": { "type": "boolean" },
        "unregisteredHost": { "type": "boolean" },
        "explicitUserAction": { "type": "boolean" },
        "trustedProject": { "type": "boolean" },
        "readOnlyBrowse": { "type": "boolean" },
        "readOnlyAuditTool": { "type": "boolean" },
        "action": { "enum": ["capture", "input"] }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "verdict"],
      "properties": {
        "when": { "$ref": "#/definitions/signals" },
        "verdict": { "$ref": "#/definitions/verdict" },
        "scope": { "$ref": "#/definitions/scope" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "scope"],
      "properties": {
        "default": { "$ref": "#/definitions/verdict" },
        "scope": { "$ref": "#/definitions/scope" },
        "ttlMinutes": { "type": "integer", "minimum": 1 },
        "exceptions": { "type": "array", "items": { "$ref": "#/definitions/exception" } },
        "separateApproval": { "type": "array", "items": { "enum": ["capture", "input"] }, "uniqueItems": true },
        "note": { "type": "string" }
      }
    }
  }
}
