{
  "name": "agent-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Claude Code x Codex integrated desktop AI development app (P00 spikes + P01 monorepo)",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/renderer/tsconfig.json",
    "test": "vitest run",
    "test:live": "cross-env AGENT_STUDIO_LIVE=1 vitest run",
    "schema:diff": "bash packages/protocol/codex-schema/diff.sh",
    "renderer:build": "vite build apps/renderer",
    "shell:build": "vite build apps/shell && vite build apps/shell --mode preload",
    "daemon": "node --import tsx apps/daemon/src/main.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@napi-rs/keyring": "^2.1.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.0",
    "better-sqlite3": "13.0.3",
    "cross-env": "^10.0.0",
    "electron": "45.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "ws": "^8.22.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@45.2.1": true,
    "better-sqlite3@13.0.3": true
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
